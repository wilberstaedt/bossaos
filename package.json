{
  "name": "bossaos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @bossaos/web build",
    "db:generate": "pnpm --filter @bossaos/db generate",
    "db:migrate": "pnpm --filter @bossaos/db migrate && pnpm --filter @bossaos/db generate",
    "db:migrate:deploy": "pnpm --filter @bossaos/db migrate:deploy",
    "dev:db": "./scripts/dev-db.sh",
    "dev:mail": "mailpit --smtp 0.0.0.0:1025 --listen 0.0.0.0:8025",
    "estado": "./scripts/estado.sh",
    "db:migrate:status": "pnpm --filter @bossaos/db migrate:status",
    "provar:credenciais": "./scripts/provar-separacao-de-credenciais.sh",
    "verificar": "./scripts/validar-cobertura.sh && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "pnpm --filter @bossaos/db generate",
    "inspeccionar": "playwright test --grep-invert @capturas",
    "capturas": "playwright test --grep @capturas",
    "db:fixtures": "node --experimental-strip-types packages/db/prisma/fixtures.ts",
    "provar:isolamento": "./scripts/provar-isolamento.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "@playwright/test": "1.62.1",
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0"
  }
}
