node_modules/
.next/
# A pasta de build de quem mede em paralelo (`NEXT_DIST_DIR`, definido em
# apps/web/next.config.ts). Dois processos a escrever no mesmo `.next` devolvem
# 500 que não são da página, e um build dentro do repositório é sujidade.
.next-*/
dist/
out/
*.tsbuildinfo

# Segredos e estado local — nunca no repositório.
.env
.env.*
!.env.example

# Porta de média em desenvolvimento (disco local).
.storage/

# Caixa de correio de teste.
.mail/

.DS_Store
coverage/

# Artefactos da inspecção. As CAPTURAS ficam versionadas (são a prova do aceite
# 3); os relatórios e os vestígios de execução, não.
inspeccao/.resultados/
playwright-report/
test-results/

# A sessão do arnês do navegador. Fora do `outputDir`, que o Playwright limpa
# quando cada projecto arranca — e é um cookie de sessão, que não se versiona.
inspeccao/.sessao/

# Bytecode do Python. Apareceu quando o `pagina-de-aprovacao.py` passou a
# importar o `frescura_do_produto.py`: um artefacto gerado que ninguem deve
# commitar. Ao contrario do `next-env.d.ts`, aqui nao ha deriva util para ver.
__pycache__/
