// BossaOS — schema base (E01).
//
// Nesta etapa o schema é DELIBERADAMENTE mínimo. O E01 é a base executável: o
// modelo de dados do produto entra nas etapas que o desenham (multi-tenant,
// catálogo, reservas), e inventá-lo aqui seria decidir sem o contrato à frente.
//
// O que existe aqui existe por uma razão verificável: `AppMeta` é a tabela que a
// sonda de prontidão lê. Sem ela, "a base responde" prova apenas que o Postgres
// está de pé — não prova que ESTE schema foi migrado. São perguntas diferentes,
// e a segunda é a que interessa depois de um deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Em Prisma 7 a URL SAI do schema: as migrações lêem-na de `prisma.config.ts`
  // e o runtime recebe a dele por adaptador, no construtor do cliente. Para nós
  // isto é bom notícia e não obstáculo — a separação entre a credencial que
  // altera schema e a que só o usa (E01, aceite 2) deixa de depender de
  // disciplina e passa a estar em dois sítios diferentes do código.
}

/// Chave/valor de metadados da aplicação. Escrita pela migração, lida pela
/// sonda de prontidão. Não é domínio: é o sinal de que o schema chegou.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ═══════════════════════════════════════════════════════════════════════════
// E03 — núcleo multi-inquilino
//
// Três camadas de isolamento, e nenhuma substitui as outras (domain-model.md):
//   1. a credencial     — o runtime não é dono das tabelas, não é superuser,
//                         não tem BYPASSRLS. Provado em E01.
//   2. a política       — RLS com USING **e** WITH CHECK, em migração SQL à mão
//                         (o Prisma não gere políticas).
//   3. o escopo         — marca, unidade, estação e acção são filtro de serviço.
//                         O RLS protege a ORGANIZAÇÃO e mais nada.
//
// As referências são COMPOSTAS. Uma FK simples de `location_id` deixaria apontar
// para a unidade de outra organização com o `organization_id` da linha a parecer
// certo. `@@unique([organizationId, id])` no alvo é o que torna isso impossível
// na base, e não no formulário.
// ═══════════════════════════════════════════════════════════════════════════

/// Fronteira do inquilino. O `id` desta linha é o `organization_id` de tudo o resto.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  /// Namespace público. Único globalmente: é o que aparece num endereço.
  slug      String   @unique
  /// Nome comercial. É o que aparece na interface.
  nome      String
  contas          Bill[]
  linhasDeConta   BillLine[]
  ajustesDeConta  BillAdjustment[]
  tentativas      PaymentAttempt[]
  pagamentos      Payment[]
  devolucoes      Refund[]
  caixas           CashRegister[]
  acontecimentosDeCaixa CashRegisterEvent[]
  movimentosDeCaixa CashMovement[]
  acontecimentosDoProvedor ProviderEvent[]
  conectoresDePagamento PaymentConnector[]
  documentosFiscais FiscalDocument[]
  conectoresFiscais FiscalConnector[]
  insumos StockItem[]
  movimentosDeStock StockMovement[]
  fichas Recipe[]
  linhasDeFicha RecipeLine[]

  // ── E06: perfil. TODOS opcionais, e isso é a decisão da etapa ─────────────
  //
  // Nenhum destes campos tem `@default`. Um `pais @default("ES")` porque a
  // primeira fixture é espanhola, ou um `moedaPadrao @default("EUR")` porque
  // parecia razoável, é exactamente o defeito que este modelo existe para
  // impedir: **desconhecido é uma resposta**, e o ecrã tem de a poder mostrar.
  //
  // Opcional não quer dizer sem consequência: quem publica, cobra ou abre
  // precisa deles, e recusa sem eles. O que não se faz é preenchê-los sozinho.

  /// Nome legal, o da factura. Pode não estar à mão no primeiro dia.
  nomeLegal String? @map("nome_legal")
  /// ISO 3166-1 alpha-2. Sem omissão: o país da organização não se adivinha.
  pais      String? @db.Char(2)
  /// Fuso IANA da SEDE. O que conta para abrir portas é o da unidade.
  fuso      String?
  /// ISO 4217. É uma sugestão para novas unidades, nunca um valor herdado em
  /// silêncio: a unidade tem a sua, e pode ser outra.
  moedaPadrao String? @map("moeda_padrao") @db.Char(3)
  /// Quem responde por esta organização. Texto, não FK: pode ser alguém que
  /// ainda não tem conta.
  responsavel String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  brands          Brand[]
  locations       Location[]
  memberships     Membership[]
  menus           Menu[]
  categorias      Category[]
  produtos        Product[]
  gruposDeOpcoes  ModifierGroup[]
  ficheiros       MediaAsset[]
  regrasDePreco   PriceRule[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  auditEvents     AuditEvent[]
  subscription    Subscription?
  entitlements    EntitlementGrant[]
  featureFlags    FeatureFlag[]
  themeRevisions  ThemeRevision[]
  themeDrafts     ThemeDraft[]
  // ── E13 ──
  serviceAreas       ServiceArea[]
  serviceTables      ServiceTable[]
  tableCombinations  TableCombination[]
  combinationMembers TableCombinationMember[]
  tableSessions      TableSession[]
  sessionEvents      TableSessionEvent[]
  devices            Device[]
  devicePairings     DevicePairing[]
  operatorPins       OperatorPin[]
  deviceShifts       DeviceShift[]
  serviceTypes       ServiceType[]
  // ── E14 ──
  orders             Order[]
  orderLines         OrderLine[]
  orderSubmissions   OrderSubmission[]
  orderEvents        OrderEvent[]
  orderRules         OrderRules[]
  onboarding      OnboardingProgress?
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]
  scheduleIntervals  ScheduleInterval[]
  sites             Site[]
  sitePaginas       SitePage[]
  sitePosts         SitePost[]
  siteRevisoes      SiteRevision[]
  sitePublicacoes   SitePublication[]
  leads             Lead[]
  dominios          CustomDomain[]
  dominiosDetidos   CustomDomainOwner[]

  estacoesDeProducao ProductionStation[]
  regrasDeRoteamento RoutingRule[]
  tarefasDeProducao  ProductionTask[]
  eventosDeProducao  ProductionEvent[]
  visitantes GuestSession[]
  chamadas GuestCall[]

  // ── E18 ──
  definicoesDeReserva ReservationSettings[]
  turnos              ServiceWindow[]
  capacidades         CapacityRule[]
  bloqueiosDeReserva  ReservationBlock[]
  reservas            Reservation[]
  alocacoes           ReservationAllocation[]
  mensagensDeReserva  ReservationMessage[]
  esperas             WaitlistEntry[]
  zonasDeEspera       WaitlistArea[]
  tentativasDeMensagem ReservationMessageAttempt[]
  templatesDeMensagem  MessageTemplate[]
  conectores           MessagingConnector[]
  areasDeEntrega       DeliveryArea[]
  entregas             OrderDelivery[]
  conectoresDeEntrega  DeliveryConnector[]
  mapasExternos        ExternalCatalogMapping[]
  impressoras   Printer[]
  sessoesDeKiosk KioskSession[]
  contactosDePedido OrderContact[]
  enviosDeImpressao PrintJob[]
  chaves            ApiKey[]
  webhooks          WebhookEndpoint[]
  entregasDeWebhook WebhookDelivery[]
  clienteSaas       SaasCustomer[]
  eventosDeCobranca SaasBillingEvent[]
  facturasSaas      SaasInvoice[]
  integracoes       Integration[]
  registosDeIntegracao IntegrationLog[]
  @@map("organizations")
  revisoes        MenuRevision[]
  publicacoes     MenuPublication[]
  importacoes     ImportJob[]
  exportacoes     ExportJob[]
  tarefas         OutboxTask[]
  consultas       MenuView[]
  enderecos       PublicSlugOwner[]
  fornecedores      Supplier[]
  artigosDeCompra   SupplierItem[]
  encomendas        PurchaseOrder[]
  linhasDeEncomenda PurchaseOrderLine[]
  recepcoes         Receipt[]
  linhasDeRecepcao  ReceiptLine[]
  facturasDeCompra  SupplierInvoice[]
  linhasDeFactura   SupplierInvoiceLine[]
  clientes          Customer[]
  consentimentos    ConsentEvent[]
  movimentosDePontos LoyaltyMovement[]
  recompensas       LoyaltyReward[]
  segmentos         Segment[]
  modelosDeCampanha CampaignTemplate[]
  campanhas         Campaign[]
  enviosDeCampanha  CampaignDelivery[]
  respostas         FeedbackEntry[]
  funcoesDeEquipa TeamRole[]
  turnosDeEquipa  Shift[]
  marcacoes       TimeEntry[]
  contasBancarias   BankAccount[]
  importacoesDeExtracto StatementImport[]
  linhasDeBanco     BankLine[]
  movimentosFinanceiros FinancialMovement[]
  correspondencias  Reconciliation[]
  periodos          AccountingPeriod[]
  acontecimentosDePeriodo PeriodEvent[]
  taxasDeCambio     ExchangeRate[]
}

/// Marca: catálogo e identidade comercial. Pertence a uma organização.
model Brand {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  nome           String
  slug           String
  /// E06: identidade textual inicial (ONB-002). Opcionais pela mesma razão.
  descricao      String?
  /// Idioma principal da marca, um dos três que o E02 suporta. Sem omissão:
  /// escolher espanhol por a primeira fixture o ser publicaria a carta de um
  /// restaurante brasileiro em espanhol.
  idiomaPrincipal String? @map("idioma_principal")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations       Location[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  menus           Menu[]
  categorias      Category[]
  produtos        Product[]
  gruposDeOpcoes  ModifierGroup[]
  ficheiros       MediaAsset[]
  importacoes     ImportJob[]

  /// Alvo das referências compostas. Sem isto, o resto não se pode escrever.
  @@unique([organizationId, id], name: "brand_por_organizacao")
  /// Slug único DENTRO da marca-mãe, não globalmente: dois restaurantes
  /// diferentes podem chamar-se "marina" sem colidir.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

/// Unidade: serviço, mesas, dispositivos, moeda operacional e stock.
model Location {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  nome           String
  slug           String
  /// O endereço PÚBLICO da carta. Global, e por isso diferente do `slug`.
  ///
  /// O `slug` é único DENTRO da organização: dois restaurantes diferentes podem
  /// ambos ter uma unidade `centro`. Este vai para um URL na internet aberta e
  /// tem de ser único no mundo — senão dois inquilinos disputam o mesmo endereço
  /// e quem ganha é quem a consulta encontrar primeiro.
  ///
  /// Anulável: uma unidade só precisa dele quando publica.
  publicSlug     String?  @unique @map("public_slug")
  // ── E06: de obrigatórios a opcionais, e é uma decisão, não um relaxamento ─
  //
  // Estavam `NOT NULL`. Parece a escolha segura e é o contrário: com eles
  // obrigatórios, quem cria uma unidade é FORÇADO a passar um valor, e o valor
  // que se passa quando não se sabe é o da última unidade, ou o do servidor, ou
  // AUD porque o produto nasceu na Austrália. Uma unidade sem moeda não é AUD.
  //
  // Opcionais, "por configurar" passa a ser representável — e as operações que
  // precisam deles recusam explicitamente, em vez de operarem sobre um palpite.
  /// Moeda operacional, ISO 4217. O dinheiro guarda-se em unidade mínima.
  moeda          String? @db.Char(3)
  /// Fuso IANA. Sem ele não há pergunta a fazer sobre horários: "são 14:00" não
  /// quer dizer nada sem saber onde.
  fuso           String?
  /// E06: morada e contacto (ONB-003, ORG-005). "Pendiente de confirmar" é um
  /// estado que o atlas desenha, e é `null` — não uma cadeia vazia.
  morada         String?
  localidade     String?
  contactoEmail  String? @map("contacto_email")
  contactoTelefone String? @map("contacto_telefone")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  contas Bill[]
  caixas CashRegister[]
  conectorDePagamento PaymentConnector?
  documentosFiscais FiscalDocument[]
  conectorFiscal FiscalConnector?
  insumos StockItem[]
  fichas Recipe[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// COMPOSTA: a marca tem de ser da mesma organização. É a base que recusa.
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)

  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  entitlements    EntitlementGrant[]
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]
  menus           Menu[]
  regrasDePreco   PriceRule[]
  disponibilidades ProductAvailability[]
  consultas       MenuView[]
  site            Site?
  leads           Lead[]
  dominios        CustomDomain[]
  // ── E13 ──
  zonas           ServiceArea[]
  mesas           ServiceTable[]
  combinacoes     TableCombination[]
  sessoes         TableSession[]
  dispositivos    Device[]
  pins            OperatorPin[]
  turnos          DeviceShift[]
  tiposDeServico  ServiceType[]
  // ── E14 ──
  pedidos         Order[]
  regrasDePedidos OrderRules?

  estacoesDeProducao ProductionStation[]
  regrasDeRoteamento RoutingRule[]
  tarefasDeProducao  ProductionTask[]
  visitantes GuestSession[]
  chamadas GuestCall[]

  // ── E18 ──
  definicoesDeReserva ReservationSettings[]
  turnosDeReserva     ServiceWindow[]
  capacidades         CapacityRule[]
  bloqueiosDeReserva  ReservationBlock[]
  reservas            Reservation[]
  alocacoes           ReservationAllocation[]
  esperas             WaitlistEntry[]
  templatesDeMensagem MessageTemplate[]
  conector            MessagingConnector?
  areasDeEntrega      DeliveryArea[]
  conectorDeEntrega   DeliveryConnector?
  mapasExternos       ExternalCatalogMapping[]
  impressoras    Printer[]
  sessoesDeKiosk KioskSession[]
  enviosDeImpressao PrintJob[]
  @@unique([organizationId, id], name: "location_por_organizacao")
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("locations")
  fornecedores Supplier[]
  encomendas   PurchaseOrder[]
  clientes          Customer[]
  recompensas       LoyaltyReward[]
  segmentos         Segment[]
  modelosDeCampanha CampaignTemplate[]
  campanhas         Campaign[]
  respostas         FeedbackEntry[]
  funcoesDeEquipa TeamRole[]
  turnosDeEquipa  Shift[]
  marcacoes       TimeEntry[]
  contasBancarias   BankAccount[]
  movimentosFinanceiros FinancialMovement[]
  periodos          AccountingPeriod[]
}

/// Identidade GLOBAL. Excepção documentada (CT-04): não leva `organization_id`,
/// porque a mesma pessoa trabalha em mais do que uma organização.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  nome      String
  /// E04: a biblioteca de autenticação escreve isto. O campo dela chama-se
  /// `name` e aponta para `nome` por configuração — a identidade continua a ser
  /// UMA tabela, e não duas a fingir que são a mesma pessoa.
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?
  /// MFA. Em TODOS os planos, não num escalão acima: a segurança da conta de
  /// quem trabalha no restaurante não é uma capacidade que se venda.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ajustesAutorizados   BillAdjustment[]
  devolucoesAutorizadas Refund[]
  acontecimentosDeCaixa CashRegisterEvent[] @relation("actorDoAcontecimento")
  divergenciasAutorizadas CashRegisterEvent[] @relation("autorDaDivergencia")
  movimentosDeCaixa CashMovement[] @relation("actorDoMovimento")
  movimentosDeStock StockMovement[]

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  convitesFeitos Invitation[] @relation("convidadoPor")
  plataforma     PlatformStaff?

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// E04 — sessão e credenciais.
//
// Estas três tabelas pertencem ao caminho de AUTENTICAÇÃO e o papel de runtime
// não tem privilégio nenhum sobre elas. Não é zelo: uma sessão é uma credencial
// viva, e o processo que serve o catálogo de um restaurante não precisa de
// conseguir ler a sessão de ninguém — nem a própria.
//
// A forma dos campos é a que a biblioteca espera. Confirmada contra a definição
// dela em `@better-auth/core/dist/db/get-tables.mjs`, e depois **verificada a
// correr**: um registo e um início de sessão a sério contra esta base.
// ═══════════════════════════════════════════════════════════════════════════

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @default("credential")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Guardada pela biblioteca, com o algoritmo dela. Nunca por nós: o E04 é
  /// explícito em não construir criptografia nem armazenamento de senha próprios.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Segundo factor. `secret` e `backupCodes` são guardados e cifrados pela
/// biblioteca — nós não lhes tocamos, e vivem nas tabelas que o runtime não vê.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

enum EstadoDeMembro {
  ACTIVO
  SUSPENSO
  REVOGADO

  @@map("estado_de_membro")
}

/// A ponte entre a identidade global e o inquilino.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  estado         EstadoDeMembro @default(ACTIVO)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int            @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]
  // ── E13 ──
  sessoesResponsavel TableSession[]
  pins               OperatorPin[]

  @@unique([organizationId, id], name: "membership_por_organizacao")
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  turnos            Shift[]
  jornadas          TimeEntry[] @relation("jornadaDoMembro")
  marcacoesQueFez   TimeEntry[] @relation("autorDaMarcacao")
}

/// Papéis do CT-04. O nome fica em maiúsculas porque é vocabulário do contrato.
enum Papel {
  OWNER
  ORG_ADMIN
  BRAND_MANAGER
  VENUE_MANAGER
  FLOOR_MANAGER
  HOST
  WAITER
  KITCHEN
  BARTENDER
  EXPO
  CASHIER
  FINANCE
  INVENTORY
  MARKETING
  EMPLOYEE

  @@map("papel")
}

/// Concessão de papel, com o seu escopo.
///
/// `brandId` e `locationId` são opcionais e é isso que define o alcance: uma
/// concessão de marca abrange as unidades dela; uma de unidade não amplia para o
/// resto da organização (CT-04). Nenhum dos dois preenchido = alcance da
/// organização inteira, e só os papéis de topo o devem ter.
model RoleAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  membershipId   String  @map("membership_id") @db.Uuid
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, membershipId])
  @@map("role_assignments")
}

/// Estado de um convite. Derivado, mas guardado: o histórico de quem foi
/// convidado e nunca aceitou é informação de gestão, não lixo.
enum EstadoDeConvite {
  PENDENTE
  ACEITE
  REVOGADO

  @@map("estado_de_convite")
}

/// Convite para uma organização.
///
/// **Um convite é uma credencial**, e é isso que explica cada campo:
///
///  - `tokenHash` e não `token`: o que viaja no email é o segredo; o que fica na
///    base é o resumo dele. Uma cópia de segurança lida por alguém não dá
///    acesso a nada, e nem nós conseguimos reemitir o link original.
///  - `papel`, `brandId`, `locationId` vivem AQUI. Na aceitação não se lê nada
///    disto do corpo do pedido — se se lesse, quem foi convidado como `WAITER`
///    aceitava-se como `OWNER`. É o defeito mais banal desta área.
///  - `email`: o convite é da pessoa convidada, não de quem receber o link.
///  - `expiresAt` vem de configuração, não de uma constante escolhida por quem
///    programa.
///  - `acceptedAt` faz o uso único: aceitar duas vezes não cria duas pertenças.
model Invitation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  email          String
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  /// SHA-256 do token. O token em claro só existe no email.
  tokenHash String @unique @map("token_hash")

  estado     EstadoDeConvite @default(PENDENTE)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?       @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(6)

  /// Quem convidou. A concessão não pode passar o escopo desta pessoa (CT-04),
  /// e sem o registo não há como auditar quem abriu a porta a quem.
  convidadoPorId String @map("convidado_por_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  convidadoPor User         @relation("convidadoPor", fields: [convidadoPorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invitations")
}

/// Rasto de acções sensíveis (E04, entrega 5).
///
/// Concessões, revogações e acesso assistido. Sem `actor` e `motivo` não é
/// auditoria — é um log. Append-only por gatilho na migração: uma auditoria que
/// se pode editar não serve para o que existe.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Quem fez. Sem FK para User de propósito: o rasto sobrevive ao apagamento.
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  accao          String
  alvoTipo       String?  @map("alvo_tipo")
  alvoId         String?  @map("alvo_id") @db.Uuid
  motivo         String?
  /// Detalhe estruturado. Nunca senhas, nunca tokens (CT-04).
  detalhe        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// E05 — planos, entitlements e flags
//
// Três catálogos, e a separação entre eles é do contrato, não estética:
//
//   PlanDefinition   o que se VENDE. Global, não pertence a inquilino nenhum.
//   EntitlementGrant o que uma organização TEM. De inquilino, com política.
//   FeatureFlag      o que está CONSTRUÍDO e libertado. Global ou por org.
//
// Misturar capacidades com flags faz um "ainda não existe" ler-se como "compra
// o plano acima", e o dono do restaurante paga por algo que não está feito.
//
// **Nenhum número comercial vive aqui.** Preços, mensalidades e limites são
// configuração, decididos pelo Matheus. O que o código traz é a estrutura — a
// quota, a leitura, a recusa e a mensagem. Escrever `MAX_PRODUTOS = 500` porque
// parecia razoável é como o número acaba em três sítios e nenhum é o certo.
// ═══════════════════════════════════════════════════════════════════════════

/// Um plano vendável. **Global**: o catálogo é o mesmo para todos.
///
/// Sem preço. O atlas (ORG-010) diz "Precio según propuesta" e é isso que fica:
/// o preço é uma proposta comercial, não uma constante do produto.
model PlanDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  /// STARTER, RESTAURANT, PRO. Estável: é o que as concessões referenciam.
  codigo    String   @unique
  nome      String
  /// A frase do atlas: "Publica bien", "Conecta el servicio", "Amplía tu gestión".
  promessa  String
  ordem     Int
  /// Aparece no selector de planos? Um plano de piloto pode não aparecer.
  publico   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  capacidades   PlanCapability[]
  subscriptions Subscription[]
  /// As subscrições que têm uma descida agendada PARA este plano. Sem esta
  /// relação a coluna existia e não se podia ler o destino pelo nome — o
  /// `estadoComercial` devolvia `descerParaPlano: null` fixo e o ecrã de mudar
  /// de plano dizia "nenhuma mudança agendada" a quem tinha uma.
  descidasAgendadas Subscription[] @relation("DescerPara")

  @@map("plan_definitions")
}

/// O que um plano inclui.
///
/// `quota` nula numa capacidade quantitativa significa **por configurar**, e o
/// motor nega. Não é ilimitado — nunca. É o CT-02 na direcção certa.
model PlanCapability {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  /// Chave do catálogo em `packages/domain/src/capacidades.ts`.
  capacidade String
  quota      Int?

  plan PlanDefinition @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, capacidade])
  @@map("plan_capabilities")
}

enum EstadoDeSubscricao {
  ACTIVA
  SUSPENSA
  CANCELADA

  @@map("estado_de_subscricao")
}

/// A assinatura de uma organização. Assenta na `Organization` do E03.
model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  estado         EstadoDeSubscricao @default(ACTIVA)
  validoDe       DateTime           @default(now()) @map("valido_de") @db.Timestamptz(6)
  validoAte      DateTime?          @map("valido_ate") @db.Timestamptz(6)

  /// Descida agendada. Guardar o plano de destino e a data **antes** de
  /// efectivar é o que permite mostrar a prévia e avisar com antecedência —
  /// e o que permite não efectivar enquanto houver caixa aberta.
  descerParaPlanoId String?   @map("descer_para_plano_id") @db.Uuid
  descerEm          DateTime? @map("descer_em") @db.Timestamptz(6)

  /// Tolerância por incumprimento: política configurável, não uma data
  /// escolhida por quem programa.
  toleranciaAte DateTime? @map("tolerancia_ate") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  descerParaPlano PlanDefinition? @relation("DescerPara", fields: [descerParaPlanoId], references: [id], onDelete: Restrict)
  plan         PlanDefinition @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

enum OrigemDeConcessao {
  /// Vem do plano contratado.
  PLANO
  /// Add-on comprado à parte. Não liberta os módulos operacionais todos.
  ADICIONAL
  /// Piloto provisionado por nós, auditado. Nunca simula cobrança.
  PILOTO

  @@map("origem_de_concessao")
}

/// O que uma organização TEM. **A ausência de uma linha significa negado.**
model EntitlementGrant {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  capacidade     String
  /// Nula numa quantitativa = por configurar = NEGADO. Ver `capacidades.ts`.
  quota          Int?
  /// Presente = a concessão só vale nesta unidade, e não amplia para o resto.
  locationId     String?           @map("location_id") @db.Uuid
  validoAte      DateTime?         @map("valido_ate") @db.Timestamptz(6)
  origem         OrigemDeConcessao @default(PLANO)
  /// Por que existe esta concessão. Obrigatório em PILOTO e ADICIONAL: uma
  /// concessão sem motivo é impossível de auditar seis meses depois.
  motivo         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, capacidade, locationId])
  @@index([organizationId])
  @@map("entitlement_grants")
}

/// Flag de lançamento. **Catálogo separado do de capacidades.**
///
/// Uma flag responde a "está construído e libertado?". Sem `organizationId` é
/// global; com ele é uma libertação controlada a um inquilino — que é como se
/// põe um módulo novo em produção com um cliente antes de todos.
model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String
  ligada         Boolean  @default(false)
  descricao      String?
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([nome, organizationId])
  @@index([nome])
  @@map("feature_flags")
}

/// Tema público de um restaurante.
///
/// O plano Starter usa a paleta BossaOS e **não a pode editar** — pode mudar
/// nome, logo, fotos e conteúdo. Restaurant e Pro escolhem cores próprias, e
/// têm o mesmo direito: o editor completo é do E12.
///
/// Guardar o tema ANTERIOR é o que permite uma descida de plano reverter ao
/// padrão sem perder o que o cliente escolheu — se ele voltar a subir, está lá.
model ThemeRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Os três únicos tokens temáveis (E02, `TOKENS_TEMAVEIS`).
  primaria       String
  acento         String
  fundo          String
  /// Verdadeiro quando é a paleta BossaOS por omissão, não uma escolha.
  padrao         Boolean  @default(false)
  /// Activa agora? Só uma por organização.
  activa         Boolean  @default(false)
  /// Preenchido quando esta revisão nasceu de RESTAURAR outra, depois de uma
  /// descida de plano ter revertido ao padrão.
  ///
  /// Restaurar cria revisão nova em vez de reactivar a antiga, e é de propósito:
  /// a régua do E12 reprova «tema aplicado sem dizer de que revisão veio», e
  /// reactivar apagava o facto de ter havido uma descida pelo meio — o histórico
  /// passava a contar uma história que não aconteceu. Mesma decisão que o
  /// `MenuRevision.restauraDeId` do E08.
  restauraDeId   String?  @map("restaura_de_id") @db.Uuid
  /// Quem pôs esta revisão no ar. As outras duas publicações do produto — carta
  /// (E08) e site (E10) — registam-no desde que existem; a aparência era a única
  /// que não dizia de onde veio.
  publicadaPor   String   @default("") @map("publicada_por")
  /// As superfícies públicas que este tema alcança, escritas quando se publica.
  /// Não é decoração: quem lê a linha meses depois não tem como saber que a
  /// carta e o site partilham o tema, e adivinhar isso pelo código de hoje é
  /// adivinhar pelo código de hoje.
  destinos       String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  restauraDe   ThemeRevision?  @relation("restauroDeTema", fields: [organizationId, restauraDeId], references: [organizationId, id], onDelete: Restrict)
  restauros    ThemeRevision[] @relation("restauroDeTema")

  @@unique([organizationId, id], name: "tema_por_organizacao")
  @@index([organizationId, activa])
  @@map("theme_revisions")
}

/// O tema ainda por publicar (THEME-002, THEME-003).
///
/// Existe pela mesma razão que `Site` existe ao lado de `SiteRevision`: sem um
/// sítio onde escolher cores sem as pôr na rua, "editar" e "publicar" são o
/// mesmo acto e a prévia não tem nada para prever. Um por organização — o tema é
/// da organização, e um rascunho por unidade prometia um override de unidade que
/// o modelo não tem.
model ThemeDraft {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  primaria       String
  acento         String
  fundo          String
  /// Email de quem mexeu por último. O rascunho é partilhado pela equipa toda,
  /// e sem isto ninguém sabe quem escolheu o roxo.
  actualizadoPor String   @map("actualizado_por")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("theme_drafts")
}

/// Quem é da plataforma BossaOS.
///
/// Escrita **só pela credencial de migração**, como o catálogo de planos e pela
/// mesma razão: uma tabela de "quem tem acesso interno" que o processo do
/// restaurante pode escrever é um restaurante a dar-se acesso interno. O runtime
/// nem sequer tem SELECT — lê-a apenas através das funções `plataforma_*`, que a
/// consultam por ele e verificam elas próprias quem chama.
model PlatformStaff {
  userId    String   @id @map("user_id") @db.Uuid
  /// Porquê. Um acesso interno sem motivo escrito é um acesso que ninguém
  /// consegue rever daqui a seis meses.
  motivo    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff")
}

// ═══════════════════════════════════════════════════════════════════════════
// E06 — horários, onboarding e idempotência.

/// Um dia da semana CONFIGURADO, para uma unidade.
///
/// **A ausência de linha é o terceiro estado.** Um dia sem linha está por
/// configurar; um dia com linha e `fechado = true` está fechado porque alguém o
/// disse. As duas coisas leem-se igual num modelo que só tenha intervalos, e é
/// essa a diferença que faz um site anunciar que abre às nove.
model ScheduleDay {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// ISO 8601: 1 = segunda … 7 = domingo. É o que o `Intl` devolve.
  dia            Int
  /// Declarado fechado. Sem intervalos, e é diferente de não ter linha.
  fechado        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// COMPOSTA: a unidade tem de ser da mesma organização.
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, dia])
  @@index([organizationId])
  @@map("schedule_days")
}

/// Uma data concreta que sobrepõe a regra semanal. Feriado, evento, obras.
model ScheduleException {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// Data LOCAL da unidade, `AAAA-MM-DD`. Guardada como `date` e não como
  /// instante: um feriado é um dia no calendário de quem o vive, não um ponto
  /// em UTC que muda de dia conforme quem o lê.
  data           DateTime @db.Date
  motivo         String
  /// Fechado nesse dia, ou aberto com os intervalos abaixo.
  fechado        Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, data])
  @@index([organizationId])
  @@map("schedule_exceptions")
}

/// Um intervalo de serviço. Pertence a um dia da semana OU a uma excepção.
///
/// `fimMin` pode passar de 1440: 20:00→01:00 escreve-se 1200→1500. A alternativa
/// — guardar 60 e tratar `fim < inicio` como caso especial — espalha esse `if`
/// por todo o código que lê horários, e basta um sítio esquecer-se para a sexta
/// à uma da manhã aparecer fechada.
model ScheduleInterval {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  diaId          String? @map("dia_id") @db.Uuid
  excepcaoId     String? @map("excepcao_id") @db.Uuid
  inicioMin      Int     @map("inicio_min")
  fimMin         Int     @map("fim_min")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dia          ScheduleDay?       @relation(fields: [diaId], references: [id], onDelete: Cascade)
  excepcao     ScheduleException? @relation(fields: [excepcaoId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([diaId])
  @@index([excepcaoId])
  @@map("schedule_intervals")
}

/// Em que passo do arranque está esta organização.
///
/// Existe para o onboarding poder ser **retomado**: quem fecha o portátil no
/// passo 3 volta ao passo 3. O passo não é a verdade sobre o que está feito — a
/// verdade é o que existe na base — é a última posição de quem estava a
/// preencher.
model OnboardingProgress {
  organizationId String @id @map("organization_id") @db.Uuid
  /// 1..10, como o atlas numera. Sem omissão para 10.
  passo          Int    @default(1)
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

/// Uma operação já executada, guardada pela chave que quem chamou escolheu.
///
/// O aceite 1 do E06: *"repetir criação após timeout não duplica organização/
/// unidade"*. Um pedido que expira no cliente pode já ter sido executado no
/// servidor — o cliente não sabe a diferença entre "não chegou" e "chegou e a
/// resposta perdeu-se". Repetir é a coisa certa a fazer; duplicar é o que não
/// pode acontecer.
///
/// A `organizationId` é OPCIONAL de propósito: a criação da própria organização
/// também tem de ser idempotente, e nesse momento ainda não há organização.
model IdempotencyKey {
  id             String  @id @default(uuid()) @db.Uuid
  /// A chave que o cliente escolheu. Opaca para nós.
  chave          String
  actorId        String  @map("actor_id") @db.Uuid
  accao          String
  organizationId String? @map("organization_id") @db.Uuid
  /// O que ficou feito, para se devolver o MESMO em vez de refazer.
  resultadoTipo  String  @map("resultado_tipo")
  resultadoId    String  @map("resultado_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Por actor e acção, como o `domain-model.md` manda. A mesma chave de duas
  /// pessoas diferentes são duas operações diferentes.
  @@unique([chave, actorId, accao])
  @@index([organizationId])
  @@map("idempotency_keys")
}

// ═══════════════════════════════════════════════════════════════════════════
// E07 — catálogo, produtos, preços e opções.
//
// **Um produto é da MARCA e é referenciado pelos canais.** O prompt proíbe pelo
// nome o erro clássico desta área: "não crie tabelas independentes de produtos
// para menu, Staff ou TPV". Cada superfície com a sua cópia significa que o
// preço da carta e o preço do TPV divergem sem ninguém saber qual é o certo.
// Aqui há um `Product`, e o que varia por canal são as REGRAS que lhe apontam.

/// O que é editável é RASCUNHO. Publicar é E08, e cria revisão imutável.
enum EstadoDeCatalogo {
  RASCUNHO
  ACTIVO
  ARQUIVADO
}

/// Os canais onde um catálogo se vende (CAT-016).
enum Canal {
  CARTA
  SITE
  SALA
  TPV
  TAKEAWAY
  KIOSK
  DELIVERY
}

/// Contém, pode conter, não contém.
///
/// **`DESCONHECIDO` não está aqui, e é a decisão que decide a etapa.** É a
/// AUSÊNCIA de linha em `ProductAllergen`. Um estado guardável para "não se
/// sabe" daria duas maneiras de o representar — a linha ausente e a linha com
/// `DESCONHECIDO` — e duas maneiras de representar a mesma coisa é uma maneira
/// de as ler diferente.
enum EstadoDeAlergenio {
  CONTEM
  PODE_CONTER
  NAO_CONTEM
}

model Menu {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  /// Âmbito: `null` = a marca inteira; preenchido = só esta unidade (CAT-002).
  locationId     String? @map("location_id") @db.Uuid
  nome           String
  descricao      String?
  /// Período de vigência. Ausente dos dois lados = todo o ano.
  periodoDe      DateTime? @map("periodo_de") @db.Timestamptz(6)
  periodoAte     DateTime? @map("periodo_ate") @db.Timestamptz(6)
  estado         EstadoDeCatalogo @default(RASCUNHO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  canais       MenuChannel[]
  seccoes      MenuCategory[]
  revisoes     MenuRevision[]
  publicacoes  MenuPublication[]

  @@unique([organizationId, id], name: "menu_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("menus")
}

model MenuChannel {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  canal          Canal

  menu Menu @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, menuId, canal])
  @@index([organizationId])
  @@map("menu_channels")
}

model Category {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  nome           String
  descricao      String?
  /// Ordem na carta. Inteiro e explícito — a ordenação por arrastar do CAT-004
  /// escreve aqui, e sem JavaScript escreve-se o número à mão.
  ordem          Int     @default(1)
  visivel        Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  produtos     Product[]
  emMenus      MenuCategory[]

  regrasDeRoteamento RoutingRule[]
  @@unique([organizationId, id], name: "categoria_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("categories")
}

/// Que secções entram em que menu, e por que ordem.
model MenuCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid
  ordem          Int    @default(1)

  menu     Menu     @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  category Category @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, menuId, categoryId])
  @@index([organizationId])
  @@map("menu_categories")
}

model Product {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  categoryId     String? @map("category_id") @db.Uuid
  nome           String
  /// E14: menu fechado — preço fixo, componentes identificáveis, e a conta soma
  /// **uma** vez. Uma bandeira aqui e não uma segunda tabela: uma lista separada
  /// de «combos» era a cópia do catálogo que o E07 proibiu pelo nome.
  combo          Boolean @default(false)
  descricao      String?
  /// Referência interna. **Nome igual não é chave de identidade** e um SKU vazio
  /// não autoriza fundir linhas — dois "Café" não são o mesmo produto.
  sku            String?
  estado         EstadoDeCatalogo @default(RASCUNHO)
  ficha Recipe?

  /// ── E20 · quanto tempo demora a fazer ─────────────────────────────────
  ///
  /// Sem isto o momento de produção não é derivável. Fica no produto porque é do
  /// produto: um bife demora o que demora, em qualquer canal.
  preparoMin Int @default(15) @map("preparo_min")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  category     Category?    @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)

  traducoes      ProductTranslation[]
  variantes      ProductVariant[]
  precos         PriceRule[]
  gruposDeOpcoes ProductModifierGroup[]
  alergenios     ProductAllergen[]
  preferencias   ProductDietaryTag[]
  canais         ProductChannel[]
  mapasExternos  ExternalCatalogMapping[]
  disponibilidades ProductAvailability[]
  media            ProductMedia[]

  /// SKU único POR MARCA, e só quando preenchido. Vários `NULL` não colidem no
  /// PostgreSQL, que é exactamente o que se quer: nem todo o produto tem SKU.
  regrasDeRoteamento RoutingRule[]
  @@unique([organizationId, brandId, sku])
  @@unique([organizationId, id], name: "produto_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@index([organizationId, categoryId])
  @@map("products")
}

/// Nome e descrição noutro idioma.
///
/// *"Texto de origem alterado torna a tradução pendente de revisão."* Sem isso,
/// mudar a descrição em espanhol deixa a inglesa a afirmar o antigo, e ninguém
/// repara porque a página inglesa continua a existir e a parecer completa.
model ProductTranslation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  /// `es-ES`, `pt-BR`, `en` — os três que o E02 fixou.
  locale         String
  nome           String
  descricao      String?
  /// A impressão do TEXTO de origem quando esta tradução foi escrita ou revista.
  ///
  /// Substituiu `origemVersao` no E08, e a razão é uma correcção: a `version` do
  /// produto avança em QUALQUER edição — mudar o preço, mudar a categoria — e
  /// marcar a tradução como obsoleta por causa do preço é um falso positivo.
  /// Falsos positivos são o que ensina toda a gente a ignorar o aviso, e o E00
  /// diz "texto de origem alterado", não "produto alterado".
  impressaoDaOrigem String @map("impressao_da_origem")
  /// Quem reviu. Sem responsável, a tradução está PENDENTE e não revista — a
  /// mesma regra da ficha de alérgenos do E07.
  revistoPor     String?   @map("revisto_por")
  revistoEm      DateTime? @map("revisto_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, locale])
  @@index([organizationId])
  @@map("product_translations")
}

/// Tamanho, porção, tipo — com preços diferenciais (CAT-011).
model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  nome           String
  ordem          Int     @default(1)
  predefinida    Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  product Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  precos  PriceRule[]

  @@unique([organizationId, id], name: "variante_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("product_variants")
}

/// Uma regra de preço. O nível sai da FORMA — que campos estão preenchidos.
///
/// **Unidades mínimas inteiras, sempre.** `Int` e não `Decimal`: 10,00 € é
/// `1000` + `EUR`. E a moeda vai na linha, porque uma organização pode ter
/// unidades em moedas diferentes e converter exigiria uma taxa que não existe.
model PriceRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// Ausente = vale para todas as variantes.
  variantId      String? @map("variant_id") @db.Uuid
  /// Ausente = base da marca (o "Heredado" do CAT-010).
  locationId     String? @map("location_id") @db.Uuid
  /// Ausente = todos os canais.
  canal          Canal?
  deQuando       DateTime? @map("de_quando") @db.Timestamptz(6)
  ateQuando      DateTime? @map("ate_quando") @db.Timestamptz(6)

  montanteMenor  Int    @map("montante_menor")
  moeda          String @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Cascade)
  location     Location?       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("price_rules")
}

/// Biblioteca reutilizável de extras (CAT-018, CAT-019).
model ModifierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  nome           String
  obrigatorio    Boolean @default(false)
  minimo         Int     @default(0)
  /// Ausente = sem tecto.
  maximo         Int?
  /// Para onde vai na cozinha. É E16 quem o usa; guarda-se aqui porque é do
  /// grupo e não do KDS, e criá-lo depois obrigava a reescrever fichas.
  destino        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  opcoes       ModifierOption[]
  emProdutos   ProductModifierGroup[]

  @@unique([organizationId, id], name: "grupo_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("modifier_groups")
}

model ModifierOption {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  nome           String
  ordem          Int     @default(1)
  /// Acréscimo. Em unidades mínimas, e `null` quando não acrescenta nada —
  /// que é diferente de acrescentar zero.
  precoMenor     Int?    @map("preco_menor")
  moeda          String? @db.Char(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  group ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id], name: "opcao_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, groupId])
  @@map("modifier_options")
}

/// O mesmo grupo, em vários produtos. É a "biblioteca" a sério.
model ProductModifierGroup {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  ordem          Int    @default(1)

  product Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, groupId])
  @@index([organizationId])
  @@map("product_modifier_groups")
}

/// A biblioteca de alérgenos (CAT-022).
///
/// **Global e não por inquilino**: os catorze do anexo II do 1169/2011 são a
/// mesma lista para toda a gente na UE, e uma cópia por organização seria
/// catorze cópias que divergem quando a lei mudar. A `regiao` existe porque
/// outras jurisdições têm outras listas.
model Allergen {
  id       String @id @default(uuid()) @db.Uuid
  codigo   String @unique
  /// `UE`, `AU`, `BR`… A lista aplicável sai da região da organização.
  regiao   String @default("UE")
  ordem    Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  emProdutos ProductAllergen[]

  @@map("allergens")
}

/// A declaração de um alérgeno num produto.
///
/// **A ausência de linha é `DESCONHECIDO`.** Não há estado guardável para "não
/// se sabe": ninguém escreve desconhecido, escreve-se uma das três ou não se
/// escreve nada.
model ProductAllergen {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  allergenId     String @map("allergen_id") @db.Uuid
  estado         EstadoDeAlergenio
  /// Quem assinou. **Uma declaração sem responsável não é uma declaração**, e
  /// por isso a ficha só está revista quando todas o têm.
  revistoPor     String? @map("revisto_por")
  revistoEm      DateTime? @map("revisto_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId, allergenId])
  @@index([organizationId])
  @@map("product_allergens")
}

/// Preferência alimentar. **NÃO é declaração de segurança.**
///
/// Tabela separada de propósito, sem partilhar vocabulário com os alérgenos.
/// "Contém amendoim" é segurança: quem a lê pode morrer se estiver errada.
/// "Vegetariano" é preferência: quem a lê fica aborrecido. Misturá-las num campo
/// é o defeito que transforma uma preferência num risco, porque a partir daí
/// ninguém sabe qual das duas está a ler.
model ProductDietaryTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  codigo         String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, codigo])
  @@index([organizationId])
  @@map("product_dietary_tags")
}

/// Onde é que este produto se vende (CAT-016).
model ProductChannel {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  canal          Canal
  visivel        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, canal])
  @@index([organizationId])
  @@map("product_channels")
}

/// O bloqueio operacional (CAT-017).
///
/// A disponibilidade tem **duas camadas** e esta é a de baixo: "acabou o polvo",
/// imediato, sem republicar a carta. Um restaurante que tenha de refazer a
/// publicação para o dizer vai deixar de o dizer.
model ProductAvailability {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// `null` = em todas as unidades. Preenchido = só nesta.
  locationId     String? @map("location_id") @db.Uuid
  bloqueado      Boolean @default(true)
  /// Até quando. `null` = até alguém desbloquear; o atlas mostra "hasta próximo
  /// servicio", que é uma data e não uma promessa vaga.
  ate            DateTime? @db.Timestamptz(6)
  motivo         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  location Location? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, locationId])
  @@index([organizationId])
  @@map("product_availability")
}

// ═══════════════════════════════════════════════════════════════════════════
// E08 — média, traduções, importação e publicação
// ═══════════════════════════════════════════════════════════════════════════

/// Estado de uma importação. `PREVISTA` é o dry-run que ainda não escreveu nada.
enum EstadoDeImportacao {
  PREVISTA
  CONFIRMADA
  CANCELADA
}

/// O que uma linha da importação faria. Espelha `AccaoDaLinha` do domínio.
enum AccaoDaLinha {
  CRIAR
  ACTUALIZAR
  IGNORAR
  ERRO
}

enum EstadoDeTarefa {
  PENDENTE
  A_CORRER
  CONCLUIDA
  FALHADA
}

/// Um ficheiro que alguém carregou. **Sempre com dono**: um ficheiro sem
/// inquilino é um ficheiro de toda a gente (CT-14).
model MediaAsset {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  /// A chave no armazenamento. Gerada por quem guarda, **nunca** o nome que veio
  /// de fora — nome de ficheiro externo é travessia de caminho (`../../.env`).
  chave          String @unique
  /// O tipo calculado dos BYTES. O declarado no pedido não decide nada.
  tipo           String
  tipoMime       String @map("tipo_mime")
  bytes          Int
  /// SHA-256 do conteúdo. Serve para não guardar o mesmo ficheiro duas vezes e
  /// para provar que a substituição do CAT-023 trocou mesmo o conteúdo.
  digest         String
  /// O nome que a pessoa deu, como METADADO. Não é caminho nem chave.
  nomeOriginal   String? @map("nome_original")
  /// Exigido nas imagens de carta. Uma foto sem alternativa é uma foto que não
  /// existe para quem usa leitor de ecrã.
  textoAlternativo String? @map("texto_alternativo")
  criadoPor      String  @map("criado_por")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  emProdutos   ProductMedia[]

  @@unique([organizationId, id], name: "media_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@index([organizationId, digest])
  @@map("media_assets")
}

/// Ligação produto ↔ ficheiro. A substituição do ficheiro não quebra isto: quem
/// muda é o `MediaAsset`, e as referências publicadas apontam à REVISÃO, que
/// guarda o retrato.
model ProductMedia {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  mediaId        String @map("media_id") @db.Uuid
  ordem          Int    @default(1)
  /// Uma só principal por produto — garantido por índice parcial na migração.
  principal      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, mediaId])
  @@index([organizationId])
  @@map("product_media")
}

/// Uma revisão publicada da carta. **Imutável**: nada a altera depois de criada.
///
/// `conteudo` é o RETRATO — nome, preço, moeda, opções, alérgenos — e não uma
/// lista de referências. É o mesmo princípio do pedido do E00: actualizar o
/// catálogo não pode reescrever o que já foi publicado.
model MenuRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  numero         Int
  conteudo       Json
  /// Preenchido quando esta revisão nasceu de restaurar outra. Restaurar cria
  /// revisão nova; o número nunca recua.
  restauraDeId   String? @map("restaura_de_id") @db.Uuid
  criadaPor      String  @map("criada_por")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  menu         Menu         @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  restauraDe   MenuRevision? @relation("restauro", fields: [organizationId, restauraDeId], references: [organizationId, id], onDelete: Restrict)
  restauros    MenuRevision[] @relation("restauro")
  publicacoes  MenuPublication[]

  @@unique([organizationId, menuId, numero])
  @@unique([organizationId, id], name: "revisao_por_organizacao")
  @@index([organizationId])
  @@map("menu_revisions")
}

/// **A referência do destino.** Uma linha por (menu, canal), a apontar para a
/// revisão que está no ar.
///
/// A troca é um `UPDATE` desta linha dentro da transacção que cria a revisão: ou
/// muda o ponteiro e a revisão existe, ou não muda nenhum dos dois. É isto que
/// faz "uma falha a meio deixa a revisão anterior inteira" ser verdade por
/// construção, e não por cuidado de quem escreve.
model MenuPublication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  canal          Canal
  revisionId     String @map("revision_id") @db.Uuid
  publicadaPor   String @map("publicada_por")
  publicadaEm    DateTime @default(now()) @map("publicada_em") @db.Timestamptz(6)
  /// Publicação agendada: a linha existe com a data e o ponteiro só troca lá.
  agendadaPara   DateTime? @map("agendada_para") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  menu         Menu         @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  revisao      MenuRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, menuId, canal])
  @@index([organizationId])
  @@map("menu_publications")
}

/// Uma importação. Nasce PREVISTA — o dry-run — e só escreve ao confirmar.
model ImportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  estado         EstadoDeImportacao @default(PREVISTA)
  ficheiroNome   String  @map("ficheiro_nome")
  separador      String  @db.Char(1)
  /// Coluna do ficheiro → campo do produto. Explícito, nunca adivinhado.
  mapeamento     Json
  /// `criar_apenas` ou `actualizar_por_sku`. **Sem valor por omissão**: um
  /// `?? 'actualizar'` escrito por conveniência funde as cartas de toda a gente.
  estrategia     String
  resumo         Json?
  criadoPor      String  @map("criado_por")
  confirmadoPor  String? @map("confirmado_por")
  confirmadoEm   DateTime? @map("confirmado_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  linhas       ImportRow[]

  @@unique([organizationId, id], name: "importacao_por_organizacao")
  @@index([organizationId])
  @@map("import_jobs")
}

/// Uma linha da prévia. Guarda-se **antes** de confirmar, para o que a pessoa
/// aprovou ser o que se escreve — e não uma segunda leitura do ficheiro, que
/// podia dar outro resultado.
model ImportRow {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId          String @map("job_id") @db.Uuid
  /// A linha como a pessoa a vê no Excel: o cabeçalho é 1.
  linha          Int
  accao          AccaoDaLinha
  erro           String?
  dados          Json
  /// Em ACTUALIZAR: o produto tocado. Em CRIAR: preenchido ao confirmar.
  productId      String? @map("product_id") @db.Uuid

  job ImportJob @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, jobId, linha])
  @@index([organizationId])
  @@map("import_rows")
}

/// Uma exportação pedida. O ficheiro existe; o direito de o descarregar
/// verifica-se **outra vez** no descarregamento.
model ExportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Quem pediu. O descarregamento é dele e de mais ninguém.
  actorId        String @map("actor_id")
  /// A acção exigida, guardada na linha: se o vocabulário mudar, esta exportação
  /// continua a saber o que era preciso para a pedir.
  accaoExigida   String @map("accao_exigida")
  formato        String
  chave          String? @unique
  bytes          Int?
  expiraEm       DateTime  @map("expira_em") @db.Timestamptz(6)
  revogadaEm     DateTime? @map("revogada_em") @db.Timestamptz(6)
  descarregadaEm DateTime? @map("descarregada_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "exportacao_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, actorId])
  @@map("export_jobs")
}

/// A caixa de saída do trabalho de fundo: publicação agendada, conversão de
/// média, sugestão de tradução.
///
/// Uma tabela e não uma fila externa, pela mesma razão do E05: a tarefa nasce
/// **na mesma transacção** que o facto que a origina. Uma fila fora da base
/// aceita a tarefa e perde-a quando a transacção reverte, e o resultado é uma
/// publicação agendada para uma revisão que nunca existiu.
model OutboxTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tipo           String
  payload        Json
  estado         EstadoDeTarefa @default(PENDENTE)
  tentativas     Int      @default(0)
  proximaEm      DateTime @default(now()) @map("proxima_em") @db.Timestamptz(6)
  ultimoErro     String?  @map("ultimo_erro")
  concluidaEm    DateTime? @map("concluida_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([estado, proximaEm])
  @@map("outbox_tasks")
}

/**
 * Uma consulta da carta pública (REP-001).
 *
 * ── O que NÃO está aqui é a decisão ────────────────────────────────────────
 *
 * O `dados-e-accoes-sensiveis.md` pede minimização, e a régua do E09 di-lo por
 * extenso: *"unidade, idioma e origem chegam; um identificador que siga a
 * pessoa, não."*
 *
 * Por isso não há aqui endereço IP, nem agente do navegador, nem cookie, nem
 * identificador de sessão, nem nada que ligue duas consultas à mesma pessoa. Uma
 * linha destas responde a "quantos vêem a carta em inglês ao domingo" e **não
 * responde** a "o que é que aquela pessoa viu" — e a segunda pergunta não é para
 * ter resposta.
 *
 * `origem` é a categoria de onde veio (`qr`, `link`, `directo`), não o `Referer`
 * completo: o endereço de proveniência é ele próprio um dado sobre a pessoa.
 */
model MenuView {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// A revisão que estava no ar. Sem isto, um pico de consultas não se consegue
  /// ligar à publicação que o causou.
  revisionId     String @map("revision_id") @db.Uuid
  idioma         String
  canal          Canal
  origem         String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, locationId, createdAt])
  @@map("menu_views")
}

/**
 * Quem teve cada endereço público.
 *
 * O `@unique` em `Location.publicSlug` impede **dois ao mesmo tempo**; isto
 * impede **dois em sequência**. Apagar o endereço tira-o do ar e não o devolve
 * ao mundo — os QR de A estão impressos em mesas, e o papel não se actualiza.
 *
 * O runtime **lê** e não escreve: quem escreve é `reservar_endereco_publico`,
 * que é quem decide. Uma rota que pudesse apagar a linha reclamava o endereço de
 * outro, que é o que a tabela existe para impedir.
 */
model PublicSlugOwner {
  slug           String   @id
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("public_slug_owners")
}

// ═══════════════════════════════════════════════════════════════════════════
// E10 — o site do restaurante, os leads e o domínio próprio
// ═══════════════════════════════════════════════════════════════════════════

/// O que o site é para o mundo. O aceite 1 do E10 vive nesta distinção:
/// **rascunho não muda o site público.** Quem serve o público lê a revisão
/// publicada; quem edita mexe no rascunho. São armazenamentos diferentes de
/// propósito — se fossem o mesmo, "guardar" era "publicar" e nenhum aviso
/// evitava isso.
enum EstadoDoSite {
  RASCUNHO
  PUBLICADO
  RETIRADO
}

/// As páginas que o site tem. É uma lista fechada porque cada uma tem uma rota
/// e um desenho próprios; páginas livres seriam outro produto.
enum TipoDePaginaDoSite {
  INICIO
  SOBRE
  CONTACTO
}

/// A máquina de estados de `dominios-e-enderecos.md`, regra 2.
///
/// `INDETERMINADO` existe porque **um DNS que não responde não é um domínio que
/// mudou de dono**. Perder a posse é uma conclusão que exige ver OUTRO dono —
/// que é o que `CONTESTADO` diz. Com um booleano, quem chama era obrigado a
/// escolher entre mentir a dizer que está bom e mentir a dizer que se perdeu.
enum EstadoDeDominio {
  PENDENTE
  VERIFICADO
  INDETERMINADO
  CONTESTADO
}

model Site {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Um site por unidade. O endereço público é da unidade (E09), e um site de
  /// marca servido em várias unidades era a fuga que o `publico_carta` teve.
  locationId     String @map("location_id") @db.Uuid

  estado         EstadoDoSite @default(RASCUNHO)

  /// SEO básico (WEB-008). Sem `@default`: o valor que se arranja quando não se
  /// sabe é o da unidade anterior — a lição do E06.
  seoTitulo      String? @map("seo_titulo")
  seoDescricao   String? @map("seo_descricao")

  /// Ligações sociais (WEB-007). Guardadas como URL completo e validadas no
  /// domínio: um campo livre acaba por receber `javascript:`.
  redes          Json?

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  paginas     SitePage[]
  posts       SitePost[]
  revisoes    SiteRevision[]
  publicacao  SitePublication?

  @@unique([organizationId, id], name: "site_por_organizacao")
  /// COMPOSTA, e é o que a relação 1:1 exige: um site por unidade, e a unidade
  /// tem de ser da mesma organização. É a base que recusa, não o código.
  @@unique([organizationId, locationId])
  @@index([organizationId])
  @@map("sites")
}

/// O conteúdo de cada página, em rascunho (WEB-003 a WEB-005).
model SitePage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid
  tipo           TipoDePaginaDoSite

  /// `false` tira a página do site sem apagar o que lá está escrito. WEB-002.
  visivel        Boolean @default(false)
  titulo         String?
  /// O texto da página. Texto simples: aceitar HTML de quem edita é aceitar
  /// script de quem edita, e o E08 já mostrou o que custa confiar em entrada.
  corpo          String?
  /// Morada, telefone e email da página de contacto (WEB-005).
  contacto       Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, siteId, tipo])
  @@index([organizationId])
  @@map("site_pages")
}

/// Novidades e eventos (WEB-006, PUB-006).
model SitePost {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid

  /// Segmento de URL, único no site. A forma é verificada na base, como a do
  /// `public_slug`: sem isso alguém escreve `../` e o endereço deixa de apontar
  /// para onde diz.
  slug           String
  titulo         String
  resumo         String?
  corpo          String?
  publicadoEm    DateTime? @map("publicado_em") @db.Timestamptz(6)
  visivel        Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, siteId, slug])
  @@index([organizationId])
  @@map("site_posts")
}

/// O retrato imutável do site. Mesma forma que `MenuRevision`, e pela mesma
/// razão: publicar é criar uma versão, não marcar uma linha.
///
/// A imutabilidade é da BASE (`REVOKE UPDATE, DELETE`), não da disciplina.
model SiteRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid
  numero         Int
  conteudo       Json
  criadaPor      String @map("criada_por")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  publicacoes  SitePublication[]

  @@unique([organizationId, siteId, numero])
  @@unique([organizationId, id], name: "site_revision_por_organizacao")
  @@index([organizationId])
  @@map("site_revisions")
}

/// O ponteiro para o que está no ar. Uma linha por site, ou nenhuma.
///
/// **Retirar apaga a linha.** Não põe uma bandeira: uma bandeira deixa o
/// conteúdo alcançável por quem se esqueça de a ler, e a régua do E10 reprova
/// exactamente isso — «a rota devolve o estado de retirado e NÃO uma página em
/// cache com o conteúdo antigo».
model SitePublication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  siteId         String @map("site_id") @db.Uuid
  revisionId     String @map("revision_id") @db.Uuid
  publicadaPor   String @map("publicada_por")
  publicadaEm    DateTime @default(now()) @map("publicada_em") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  revisao      SiteRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Restrict)

  /// Uma publicação por site, no máximo. Retirar apaga a linha.
  @@unique([organizationId, siteId])
  @@index([organizationId])
  @@map("site_publications")
}

/// O pedido de contacto vindo do site público (aceite 2 do E10).
model Lead {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid

  nome     String
  email    String
  telefone String?
  mensagem String

  /// De onde veio. Categoria fechada, como a `origem` das consultas do E09 —
  /// um campo livre acabaria por receber o `Referer` inteiro.
  origem   String @default("site")

  /// **A chave que faz "guarda-se uma vez" ser da base e não de um `if`.**
  ///
  /// Duas submissões simultâneas lêem as duas "não existe" e gravam as duas: a
  /// decisão tem de estar na restrição única, como a idempotência do E06. A
  /// chave deriva do conteúdo e do dia — o duplo clique e o recarregar colapsam,
  /// e um contacto genuíno noutro dia não é engolido.
  chaveIdempotencia String @map("chave_idempotencia")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, locationId, chaveIdempotencia])
  @@index([organizationId])
  @@index([organizationId, locationId, createdAt])
  @@map("leads")
}

/// O domínio próprio (WEB-009), com a máquina de estados do contrato.
model CustomDomain {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid

  /// Único no MUNDO: o DNS é um espaço de nomes global e não tem organizações.
  dominio        String @unique

  estado         EstadoDeDominio @default(PENDENTE)

  /// O valor que NÓS geramos e que só quem controla o DNS consegue publicar.
  /// Escrever o domínio numa caixa de texto não prova nada.
  tokenVerificacao String @map("token_verificacao")

  verificadoEm      DateTime? @map("verificado_em") @db.Timestamptz(6)
  /// Quando se olhou pela última vez. Verificado uma vez não é verificado para
  /// sempre — regra 2 do contrato.
  ultimaTentativaEm DateTime? @map("ultima_tentativa_em") @db.Timestamptz(6)
  /// Porque é que o estado é o que é. Sem isto, `INDETERMINADO` e `CONTESTADO`
  /// ficam indistinguíveis a quem lê o ecrã.
  motivo            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, locationId])
  @@map("custom_domains")
}

/// **O nome não volta ao mundo** — regra 3 do contrato, para domínios.
///
/// Gémea de `PublicSlugOwner`, e existe pela mesma razão física: o domínio anda
/// em cartões, ementas e anúncios pagos. Desvincular tira-o do ar; não o oferece
/// ao próximo. O `@unique` do `CustomDomain` impede dois AO MESMO TEMPO e não
/// impede dois EM SEQUÊNCIA, que é o caso real (regra 4).
model CustomDomainOwner {
  dominio        String   @id
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("custom_domain_owners")
}

/// MKT-007 · o pedido de demo da BossaOS.
///
/// **Fora do espaço de inquilino, de propósito.** Quem pede uma demo não é
/// inquilino de ninguém, e prendê-lo a uma organização poria correio de
/// estranhos dentro do espaço de dados de um cliente. Sem política de linha
/// porque não há inquilino a isolar; em vez disso o runtime **não tem
/// privilégio nenhum** sobre a tabela, e escreve por uma porta `SECURITY
/// DEFINER` que só sabe inserir.
model DemoRequest {
  id          String  @id @default(uuid()) @db.Uuid
  nome        String
  email       String
  restaurante String
  telefone    String?
  mensagem    String?
  idioma      String

  /// Do conteúdo e do dia, como a dos leads. O duplo clique e o recarregar
  /// colapsam; um pedido genuíno noutro dia não é engolido.
  chaveIdempotencia String @unique @map("chave_idempotencia")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("demo_requests")
}

// ═══════════════════════════════════════════════════════════════════════════
// E13 — sala, sessões, dispositivos e PIN
//
// A primeira etapa em que DUAS PESSOAS mexem na mesma coisa ao mesmo tempo.
// Tudo o que veio antes tinha um dono de cada vez, e por isso a forma destes
// modelos é decidida pela concorrência e não pela arrumação.
// ═══════════════════════════════════════════════════════════════════════════

/// O que uma zona é para o serviço. Fechada porque cada tipo tem regras de
/// operação diferentes — uma barra não se reserva como uma sala.
enum TipoDeZona {
  SALA
  TERRACO
  BARRA
  PRIVADO
}

/// O estado de uma sessão de mesa.
///
/// `A_ENCERRAR` não é decoração: é o intervalo entre pedir a conta e a mesa
/// ficar livre, e durante ele **a mesa continua ocupada**. Sem este estado, ou
/// se liberta a mesa cedo demais — e outra pessoa senta-se em cima da conta de
/// quem ainda lá está — ou tarde demais, e a sala mente sobre o que tem livre.
enum EstadoDeSessao {
  ABERTA
  A_ENCERRAR
  /// A mesa está a ser limpa. **Continua ocupada** — o índice único parcial
  /// cobre tudo o que não é `FECHADA`, e por isso a mesa só volta a abrir quando
  /// a limpeza terminar. Uma mesa vazia por limpar não é uma mesa livre, e
  /// sentar alguém nela é o defeito que este estado existe para impedir.
  EM_LIMPEZA
  FECHADA
}

/// O ciclo de vida de um dispositivo de sala.
///
/// `PENDENTE` existe porque parear é um pedido, e aprovar é um acto de gerência
/// (E13, entregar 3). Um dispositivo que nasce activo é um tablet que qualquer
/// pessoa liga à rede do restaurante e passa a ver a sala.
enum EstadoDeDispositivo {
  PENDENTE
  ACTIVO
  REVOGADO
}

/// Onde o dispositivo está, e é isto que limita o que ele pode fazer.
///
/// «A estação limita o que o dispositivo pode fazer» (E13, respeitar 1). Não é
/// um rótulo: um ecrã de cozinha não abre mesas, e um tablet de sala não
/// configura a organização.
enum Estacao {
  SALA
  COZINHA
  BALCAO
  GERENCIA
}

/// Zona de serviço: sala, terraço, barra (FLOOR-001, ONB-007).
model ServiceArea {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  locationId     String     @map("location_id") @db.Uuid
  nome           String
  tipo           TipoDeZona @default(SALA)
  ordem          Int        @default(0)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mesas        ServiceTable[]

  // ── E18 ──
  capacidades        CapacityRule[]
  bloqueiosDeReserva ReservationBlock[]
  esperas            WaitlistArea[]

  @@unique([organizationId, id], name: "zona_por_organizacao")
  @@index([organizationId, locationId])
  @@map("service_areas")
}

/// A mesa FÍSICA (FLOOR-002, FLOOR-003, FLOOR-004).
///
/// Separada da sessão de propósito: a mesa é mobiliário e dura anos; a sessão é
/// um serviço e dura uma noite. Juntá-las obrigaria a apagar história para
/// libertar uma mesa.
model ServiceTable {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  areaId         String @map("area_id") @db.Uuid
  /// O que está escrito na mesa. Texto, não número: há mesas «07», «T3» e «Barra 2».
  codigo         String
  capacidade     Int    @default(2)
  /// Posição no desenho da sala (FLOOR-004). Anuláveis: uma mesa por posicionar
  /// é um estado real, e `0,0` seria uma posição inventada no canto.
  posX           Int?   @map("pos_x")
  posY           Int?   @map("pos_y")

  /// ── O QR desta mesa: um token AO PORTADOR, colado num sítio público ────
  ///
  /// Guarda-se o **resumo**, nunca o segredo — como os convites do E04 e o
  /// pareamento do E13. Quem tem a base não tem o autocolante.
  ///
  /// `null` é uma mesa sem QR emitido, e é um estado real: não se inventa um
  /// segredo à espera de que alguém o imprima.
  qrSegredoHash String? @map("qr_segredo_hash")

  /// Quantas vezes o QR desta mesa foi rodado, e quando foi a última.
  ///
  /// ── Isto NÃO decide se uma sessão viva continua válida ─────────────────
  ///
  /// É a distinção inteira do contrato: **rodar não é revogar**. Rodar troca o
  /// segredo que abre sessões NOVAS e não fecha as que já estão abertas — quem
  /// está sentado continua a comer.
  ///
  /// O contador serve para o ecrã dizer há quanto tempo o QR não é rodado, e
  /// mais nada. *«Informar não é decidir»*: com que frequência se roda é do
  /// restaurante, e o sistema não traz um valor por omissão que finja ser
  /// política.
  ///
  /// **E repare no que a `GuestSession` NÃO tem:** uma cópia deste número. Se
  /// tivesse, alguém escreveria um dia `sessao.qrGeracao === mesa.qrGeracao` na
  /// verificação — e a rotação passava a expulsar gente da mesa a meio do prato,
  /// que é exactamente o colapso que este contrato existe para impedir. Sem o
  /// campo, esse `if` não tem o que comparar: é preciso uma migração para o
  /// escrever, e uma migração é revista.
  qrGeracao  Int       @default(0) @map("qr_geracao")
  qrRodadoEm DateTime? @map("qr_rodado_em") @db.Timestamptz(6)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  area         ServiceArea  @relation(fields: [organizationId, areaId], references: [organizationId, id], onDelete: Restrict)
  sessoes      TableSession[]
  combinacoes  TableCombinationMember[]
  visitantes   GuestSession[]

  chamadas GuestCall[]

  // ── E18 ──
  alocacoes          ReservationAllocation[]
  bloqueiosDeReserva ReservationBlock[]
  esperas            WaitlistEntry[]
  @@unique([organizationId, id], name: "mesa_por_organizacao")
  @@unique([locationId, codigo], name: "codigo_de_mesa_por_unidade")
  @@index([organizationId, locationId])
  @@map("service_tables")
}

/// Combinações permitidas (FLOOR-005): que mesas se podem juntar.
///
/// Uma lista do que É permitido, e não um cálculo de proximidade: duas mesas
/// encostadas com um pilar pelo meio não se juntam, e isso não está nas
/// coordenadas.
model TableCombination {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  capacidade     Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  membros      TableCombinationMember[]

  @@unique([organizationId, id], name: "combinacao_por_organizacao")
  @@index([organizationId, locationId])
  @@map("table_combinations")
}

model TableCombinationMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  combinationId  String @map("combination_id") @db.Uuid
  tableId        String @map("table_id") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  combinacao   TableCombination @relation(fields: [organizationId, combinationId], references: [organizationId, id], onDelete: Cascade)
  mesa         ServiceTable     @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)

  @@unique([combinationId, tableId])
  @@index([organizationId, tableId])
  @@map("table_combination_members")
}

/// A SESSÃO de mesa (FLOOR-006 a 011).
///
/// ── A unicidade vive na BASE, e não numa consulta prévia ─────────────────
///
/// O aceite 1 é «duas aberturas concorrentes produzem UMA sessão activa». Um
/// `SELECT` antes do `INSERT` é uma corrida com janela mais estreita: passa a
/// maior parte das vezes, e isso é pior do que falhar sempre. A garantia é um
/// **índice único parcial** sobre `table_id` onde o estado não é `FECHADA` —
/// escrito na migração, porque o Prisma não exprime índices parciais.
///
/// E o par que o índice tem de deixar passar: quando a sessão fecha, sai do
/// índice e a mesa **volta a poder abrir**. Um índice único sobre `(table_id)`
/// sem a condição de estado passaria o aceite e deixava a mesa inutilizável para
/// sempre.
model TableSession {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  tableId        String         @map("table_id") @db.Uuid
  estado         EstadoDeSessao @default(ABERTA)
  comensais      Int            @default(1)
  /// Quem responde pela mesa. É uma pertença e não um utilizador: o mesmo
  /// utilizador pode estar em duas organizações, e a responsabilidade é de uma.
  responsavelId  String?        @map("responsavel_id") @db.Uuid
  abertaPor      String         @map("aberta_por")
  abertaEm       DateTime       @default(now()) @map("aberta_em") @db.Timestamptz(6)
  fechadaPor     String?        @map("fechada_por")
  fechadaEm      DateTime?      @map("fechada_em") @db.Timestamptz(6)
  contas Bill[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mesa         ServiceTable @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)
  responsavel  Membership?  @relation(fields: [organizationId, responsavelId], references: [organizationId, id], onDelete: Restrict)
  eventos      TableSessionEvent[]
  visitantes   GuestSession[]

  chamadas GuestCall[]
  esperas  WaitlistEntry[]
  @@unique([organizationId, id], name: "sessao_por_organizacao")
  @@index([organizationId, locationId, estado])
  @@index([tableId])
  @@map("table_sessions")
}

/// O histórico da sessão (E13, entregar 2: «com histórico»).
///
/// Append-only por privilégio, como `audit_events`: uma transferência que se
/// possa reescrever depois não é histórico, é uma versão dos factos.
model TableSessionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  accao          String
  detalhe        Json?
  actorEmail     String   @map("actor_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessao       TableSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, sessionId, createdAt])
  @@map("table_session_events")
}

/// Um dispositivo de sala (DEV-001 a 004).
model Device {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  nome           String
  estacao        Estacao             @default(SALA)
  estado         EstadoDeDispositivo @default(PENDENTE)

  aprovadoPorId String?   @map("aprovado_por_id") @db.Uuid
  aprovadoEm    DateTime? @map("aprovado_em") @db.Timestamptz(6)
  revogadoPorId String?   @map("revogado_por_id") @db.Uuid
  revogadoEm    DateTime? @map("revogado_em") @db.Timestamptz(6)
  /// Porque foi retirado o acesso. Obrigatório ao revogar, no serviço: uma
  /// revogação sem motivo é uma que ninguém consegue rever daqui a seis meses.
  revogadoMotivo String?  @map("revogado_motivo")

  ultimoVistoEm DateTime? @map("ultimo_visto_em") @db.Timestamptz(6)
  /// Quantos rascunhos por enviar o dispositivo declarou ter na última vez que
  /// falou. Um NÚMERO e nunca conteúdo — a regra 3 do `offline-e-fila-local`
  /// diz que o operador seguinte não vê nada do anterior, e quem revoga também
  /// não é o dono do trabalho.
  ///
  /// **Anulável, e a ausência não é zero.** Um dispositivo que nunca reportou
  /// não tem zero rascunhos: não se sabe. O ecrã de revogar diz isso por
  /// palavras em vez de mostrar um zero tranquilizador que ninguém mediu.
  rascunhosPorEnviar Int? @map("rascunhos_por_enviar")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  pareamentos  DevicePairing[]

  sessoesDeKiosk KioskSession[]
  @@unique([organizationId, id], name: "dispositivo_por_organizacao")
  @@index([organizationId, locationId, estado])
  @@map("devices")
}

/// O convite de pareamento (DEV-002): token de uso único, com prazo.
///
/// Guarda o RESUMO do token e nunca o token, como os convites do E04 e pela
/// mesma razão: quem tiver a base não fica com os pareamentos em aberto.
model DevicePairing {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  criadoPorId    String    @map("criado_por_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device       Device       @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, deviceId])
  @@map("device_pairings")
}

/// O PIN de troca rápida de operador (AUTH-002).
///
/// ── O que um PIN é, e o que ele NÃO é ─────────────────────────────────────
///
/// «PIN curto sozinho não autentica na internet nem concede privilégio de
/// owner» (E13, respeitar 1). Isto é uma troca de operador **dentro de um
/// dispositivo já confiável** — quatro dígitos são adivinháveis, e o que os
/// torna suficientes é o dispositivo já ter passado por pareamento e aprovação.
///
/// Guarda-se um resumo com sal e nunca o PIN. E a comparação é em tempo
/// constante: comparar cadeias com `===` diz quantos dígitos estavam certos
/// pelo tempo que demora a responder.
model OperatorPin {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  resumo String
  sal    String

  tentativas   Int       @default(0)
  bloqueadoAte DateTime? @map("bloqueado_ate") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([locationId, membershipId], name: "pin_por_unidade_e_pessoa")
  @@index([organizationId, locationId])
  @@map("operator_pins")
}

/// O turno aberto num dispositivo (AUTH-002, DEV-003).
///
/// Existe para a revogação poder ser medida **a meio**: sem uma linha que diga
/// «este operador está a usar este aparelho agora», o ataque 2 da régua — revogar
/// durante uma sessão aberta — não tem nada onde bater.
model DeviceShift {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  abertaEm       DateTime  @default(now()) @map("aberta_em") @db.Timestamptz(6)
  terminadaEm    DateTime? @map("terminada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, deviceId, terminadaEm])
  @@map("device_shifts")
}

/// Tipos de serviço da unidade (SET-003): almoço, jantar, brunch.
model ServiceType {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  /// Minutos desde a meia-noite LOCAL da unidade. O fuso é da unidade e está no
  /// `Location` — guardar um instante aqui obrigaria a recalcular todos os dias.
  inicioMinutos  Int    @map("inicio_minutos")
  fimMinutos     Int    @map("fim_minutos")
  activo         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([locationId, nome], name: "tipo_de_servico_por_unidade")
  @@index([organizationId, locationId])
  @@map("service_types")
}

// ═══════════════════════════════════════════════════════════════════════════
// E14 — motor de pedidos e entrega confiável
//
// A primeira etapa onde um defeito **cobra dinheiro duas vezes** ou faz
// desaparecer o trabalho de alguém a meio de um serviço. Os três aceites são
// três formas de a mesma coisa falhar: **duas escritas que se encontram**.
//
// Por isso as garantias estão na FORMA, e não em código que alguém tem de se
// lembrar de escrever:
//
//   aceite 1  `order_submissions.command_id` é ÚNICO. O reenvio depois do commit
//             é impossível de duplicar, e não uma consulta prévia que perde a
//             corrida.
//   aceite 2  as linhas são ACRESCENTADAS, nunca reescritas em bloco. Dois
//             operadores a juntar itens ao mesmo tempo não se encontram — o
//             padrão que perde trabalho é ler-tudo-e-gravar-tudo, e aqui ele não
//             tem por onde acontecer.
//   aceite 3  o preço é COPIADO para a linha ao ser aceite. Uma publicação nova
//             não tem como lhe tocar: são linhas diferentes da base.
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoDePedido {
  RASCUNHO
  ACEITE
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

/// O estado de uma linha. `PROPOSTA` é o que o cliente pediu; `ACEITE` é o que o
/// servidor confirmou, **com o preço dele**.
enum EstadoDeLinha {
  PROPOSTA
  ACEITE
  REJEITADA
  CANCELADA
}

/// Porque é que uma linha foi recusada. Fechado, porque cada motivo tem uma
/// resposta diferente no ecrã — e «indisponível» sem dizer porquê é o que faz
/// alguém pedir a mesma coisa outra vez.
enum MotivoDeRejeicao {
  ESGOTADO
  SEM_PRECO
  PRECO_DIVERGENTE
  PRODUTO_DESCONHECIDO
}

/// O pedido, um por canal e um motor só (E14, entrega).
model Order {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// A mesa, quando existe. Um pedido de balcão não tem mesa — e `null` diz
  /// isso, em vez de uma mesa inventada para a coluna não ficar vazia.
  tableSessionId String? @map("table_session_id") @db.Uuid
  canal          Canal
  /// O número que a pessoa lê e diz em voz alta («o A104»).
  numero         String
  estado         EstadoDePedido @default(RASCUNHO)

  /// Concorrência optimista (E14, entregar 4).
  ///
  /// **Não serve para acrescentar linhas** — isso é aditivo e não precisa de
  /// versão. Serve para as edições que reescrevem o rascunho, onde a última
  /// escrita ganharia. O conflito que sai dela tem de ser **recuperável**: diz o
  /// que mudou e a versão actual, para a pessoa continuar em vez de refazer.
  versao         Int    @default(1)

  // ── E20 · um pedido para as 20h não é trabalho para agora ─────────────
  /// A hora combinada com a pessoa. UTC, sempre — resolvida pelo fuso da unidade
  /// antes de chegar aqui. Nula quer dizer «é para agora».
  entregarAs DateTime? @map("entregar_as") @db.Timestamptz(6)
  /// ── DERIVADO, e nunca escrito por quem pede ─────────────────────────
  ///
  /// Hora de entrega menos o preparo. Há um gatilho na base a derivá-lo: um
  /// valor vindo de fora é substituído, não recusado — quem o mandou não estava
  /// a atacar, estava a copiar um exemplo.
  producaoEm DateTime? @map("producao_em") @db.Timestamptz(6)
  /// O maior preparo das linhas, no momento em que o pedido foi aceite.
  /// Recalcular a partir do catálogo mais tarde daria um momento de produção que
  /// muda sozinho quando alguém edita um produto.
  preparoMin Int? @map("preparo_min")
  /// A identidade do pedido no sistema de quem o mandou.
  externoId    String? @map("externo_id")
  externoCanal String? @map("externo_canal")

  abertoPor String   @map("aberto_por")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  entrega      OrderDelivery?
  linhas       OrderLine[]
  envios       OrderSubmission[]
  eventos      OrderEvent[]

  tarefas ProductionTask[]
  sessaoDeKiosk KioskSession?
  contacto      OrderContact?
  @@unique([organizationId, id], name: "pedido_por_organizacao")
  @@unique([locationId, numero], name: "numero_por_unidade")
  @@index([locationId, producaoEm])
  @@index([organizationId, locationId, estado])
  @@index([tableSessionId])
  @@map("orders")
}

/// Uma linha do pedido — e o sítio onde o aceite 3 vive.
model OrderLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  /// A ronda que a trouxe. `null` numa linha de rascunho ainda por enviar.
  submissionId   String? @map("submission_id") @db.Uuid
  /// O produto do catálogo. Anulável porque o produto pode ser arquivado depois,
  /// e a linha servida continua a valer — é a razão de haver instantâneo.
  productId      String? @map("product_id") @db.Uuid
  linhasDeConta BillLine[]
  movimentosDeStock StockMovement[]

  /// ── O INSTANTÂNEO, que é o aceite 3 escrito em colunas ─────────────────
  ///
  /// Nome, preço e opções ficam COPIADOS na linha ao ser aceite. Uma publicação
  /// de preço novo cria linhas noutra tabela; não tem por onde tocar nesta.
  ///
  /// A alternativa — ler o preço ao fechar a conta — é o defeito que a régua
  /// reprova à cabeça: a conta de quem está sentado mudaria porque a cozinha
  /// actualizou a carta a meio do jantar.
  nome           String
  quantidade     Int    @default(1)
  precoMenor     Int?   @map("preco_menor")
  moeda          String? @db.Char(3)
  opcoes         Json?

  /// O que o cliente PROPÔS, guardado para se poder mostrar a divergência.
  /// «Preço e dados recebidos do navegador são propostas» (E14, respeitar 1).
  precoPropostoMenor Int? @map("preco_proposto_menor")

  /// ── O componente de um combo (E14, entregar 7) ─────────────────────────
  ///
  /// Preenchido nas linhas que existem para a COZINHA saber o que fazer, dentro
  /// de um menu fechado. Quem soma ignora-as — e a base recusa-lhes preço, para
  /// a regra não depender de quem soma: um relatório escrito daqui a seis meses
  /// por quem não conhece esta coluna não consegue somar o combo duas vezes.
  linhaPaiId     String? @map("linha_pai_id") @db.Uuid

  estado         EstadoDeLinha    @default(PROPOSTA)
  motivoRejeicao MotivoDeRejeicao? @map("motivo_rejeicao")
  aceiteEm       DateTime?        @map("aceite_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pedido       Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  linhaPai     OrderLine?   @relation("componenteDeCombo", fields: [organizationId, linhaPaiId], references: [organizationId, id], onDelete: Cascade)
  componentes  OrderLine[]  @relation("componenteDeCombo")

  tarefas ProductionTask[]
  @@unique([organizationId, id], name: "linha_por_organizacao")
  @@index([organizationId, orderId])
  @@index([linhaPaiId])
  @@map("order_lines")
}

/// Um envio — uma ronda de linhas mandada de uma vez.
///
/// ── `command_id` é ÚNICO, e é o aceite 1 inteiro ───────────────────────────
///
/// *«Timeout depois do commit e reenvio com a mesma chave criam apenas um
/// pedido/envio.»* O caso não é a rede falhar antes de gravar: é **gravar**, a
/// resposta perder-se, e o cliente reenviar. O servidor já tem; o cliente acha
/// que não.
///
/// Um `SELECT` por `command_id` antes do `INSERT` é a mesma corrida do E13 com
/// outro nome — dois reenvios simultâneos leem ambos que não existe. Aqui a
/// segunda linha é **impossível de escrever**, e o serviço traduz o `23505` na
/// resposta que já tinha sido dada.
///
/// `resposta` existe para isso: repetir o comando devolve **o mesmo**, e não um
/// «já existe» que obriga quem chama a adivinhar o que aconteceu da primeira vez.
model OrderSubmission {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid

  /// Global, e não por organização: nasce no cliente antes de haver pedido, e um
  /// identificador que se repetisse entre inquilinos era um pedido de um
  /// restaurante a colidir com o de outro.
  commandId      String @unique @map("command_id")
  /// Resumo do que foi enviado. A mesma chave com corpo diferente é **conflito**
  /// — não é uma repetição, é outra coisa a usar o mesmo nome.
  payloadHash    String @map("payload_hash")
  resposta       Json

  criadoPor String   @map("criado_por")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pedido       Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id], name: "envio_por_organizacao")
  @@index([organizationId, orderId])
  @@map("order_submissions")
}

/// O histórico do pedido (ORD-009). Append-only por privilégio, como o do E13.
model OrderEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  accao          String
  detalhe        Json?
  actorEmail     String   @map("actor_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pedido       Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, orderId, createdAt])
  @@map("order_events")
}

/// Regras de pedidos da unidade (SET-004).
model OrderRules {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @unique @map("location_id") @db.Uuid

  /// Aceitar automaticamente o que não tem divergência nenhuma. Quando falso,
  /// tudo espera por alguém — que é o que um restaurante com cozinha pequena quer.
  aceitacaoAutomatica Boolean @default(true) @map("aceitacao_automatica")
  /// Quantas linhas iguais de uma vez. `null` é **por configurar**, e não
  /// «ilimitado»: a regra do vault vale aqui — ausência não é política.
  maximoPorLinha      Int?    @map("maximo_por_linha")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("order_rules")
}

// ── E16 · produção, estações e KDS ─────────────────────────────────────────

/// O que uma estação faz. **Não é o mesmo que a `Estacao` do dispositivo.**
///
/// A `Estacao` do E13 diz onde um APARELHO está (sala, cozinha, balcão,
/// gerência) e limita o que ele pode comandar. Isto diz o que um POSTO DE
/// TRABALHO faz, e é do restaurante: «cozinha quente» e «cozinha fria» são duas
/// estações de produção no mesmo sítio, e o atlas nomeia-as (KDS-002).
///
/// São coisas diferentes com nomes parecidos, e é por isso que estão em enums
/// separados em vez de num só «suficientemente geral».
enum TipoDeEstacao {
  /// Prepara comida. Tem bilhetes, temporizadores e um «pronto».
  PREPARACAO
  /// Coordena a saída. Não prepara nada — vê o que as outras estão a fazer.
  EXPO
}

/// O estado de uma TAREFA de produção.
///
/// ── Porque é que não reutiliza a `EstadoDeTarefa` ─────────────────────────
///
/// Já existe uma `EstadoDeTarefa` neste schema, e é da **caixa de saída**:
/// PENDENTE, A_CORRER, CONCLUIDA, FALHADA — o vocabulário de um trabalho de
/// fundo que pode falhar e ser repetido. Uma tarefa de cozinha não «falha» nem
/// se repete sozinha: começa, fica pronta, sai, ou é cancelada por uma pessoa.
///
/// Reutilizar o enum poupava seis linhas e obrigava para sempre a perguntar de
/// qual dos dois se está a falar.
enum EstadoDaProducao {
  POR_INICIAR
  EM_PREPARO
  PRONTA
  ENTREGUE
  CANCELADA
}

/// Uma estação de produção da unidade: cozinha quente, fria, bar, expo.
model ProductionStation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  tipo           TipoDeEstacao @default(PREPARACAO) 
  ordem          Int    @default(0)

  /// ── Quantos bilhetes o ecrã mostra de uma vez. É VISUALIZAÇÃO ──────────
  ///
  /// «Quantidade máxima visível, prioridade e ordem de pratos são regras de
  /// visualização, não regras de fila» (`kds-e-tempo-real.md`). O erro concreto
  /// que isto previne está escrito lá: o KDS mostra doze, chegam vinte, e os
  /// oito de baixo **desaparecem** em vez de ficarem alcançáveis. Parece limpo,
  /// e é comida que nunca é feita.
  ///
  /// Por isso este número **nunca** entra num `WHERE` nem num `take` que decida
  /// o que existe: entra na apresentação, e o que fica de fora continua contado
  /// e alcançável.
  limiteVisivel  Int    @default(12) @map("limite_visivel")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  regras       RoutingRule[]
  tarefas      ProductionTask[]

  @@unique([organizationId, id], name: "estacao_por_organizacao")
  @@unique([locationId, nome], name: "estacao_por_unidade")
  @@index([organizationId, locationId])
  @@map("production_stations")
}

/// Qual estação faz o quê. **Configuração do restaurante, não código.**
///
/// ── Não há regra por omissão, e isso é a decisão ──────────────────────────
///
/// «Ausência de regra não é *cozinha por omissão*» — o contrato di-lo pelo nome.
/// Um item sem roteamento definido gera uma tarefa **sem estação**, que aparece
/// como não encaminhada a quem configura. Mandá-lo em silêncio para a estação
/// mais provável é inventar uma decisão do dono e esconder que foi inventada.
///
/// ── E TODAS as regras que casam aplicam-se ────────────────────────────────
///
/// Não há precedência entre uma regra de produto e uma de categoria: as duas
/// valem, e o resultado são duas tarefas. É o que faz um hambúrguer com batata
/// ser grelha **e** fritadeira — o caso que parte o modelo ingénuo.
///
/// A alternativa — o produto «ganhar» à categoria — teria de ser uma decisão do
/// restaurante, e este contrato diz que eu não a tomo. Com a união, quem quer
/// uma estação só põe uma regra só; com a precedência, quem quer duas não tinha
/// como o dizer.
model RoutingRule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  stationId      String @map("station_id") @db.Uuid

  /// A regra aponta a um produto **ou** a uma categoria. Nunca aos dois, e
  /// nunca a nenhum — uma restrição na base garante-o, para não depender de
  /// quem escreve.
  productId  String? @map("product_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  estacao      ProductionStation @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Cascade)
  produto      Product?          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  categoria    Category?         @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([locationId, stationId, productId], name: "regra_por_produto")
  @@unique([locationId, stationId, categoryId], name: "regra_por_categoria")
  @@index([organizationId, locationId])
  @@map("routing_rules")
}

/// Uma TAREFA de produção. **A unidade da estação é isto, não a linha.**
///
/// ── O modelo ingénuo e porque não está aqui ───────────────────────────────
///
/// «Cada linha de pedido pertence a uma estação» é a primeira coisa que se
/// escreve e passa em quase todos os testes, porque quase todos os pratos são de
/// uma estação só. Parte no primeiro que precisa de duas — e o defeito não dá
/// erro: dá comida em falta, descoberta pelo cliente.
///
/// Um-para-muitos desde o primeiro dia, mesmo com a maioria a ter uma só, porque
/// o dia em que tiver duas é uma **migração** e não uma configuração.
model ProductionTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  lineId         String @map("line_id") @db.Uuid

  /// `null` é **não encaminhada**, e é um estado real: há trabalho e ninguém foi
  /// avisado. Aparece a quem configura, em vez de ir para a estação mais
  /// provável sem o dizer.
  stationId String? @map("station_id") @db.Uuid

  estado EstadoDaProducao @default(POR_INICIAR)

  /// ── A versão, e é ela que impede o ecrã de REGREDIR ───────────────────
  ///
  /// «Uma versão antiga nunca se aplica sobre uma mais recente» — e o que não
  /// pode acontecer é um evento atrasado reabrir um bilhete que já saiu.
  /// Eventos repetidos e fora de ordem são normais, não são avaria.
  versao Int @default(1)

  /// ── Os carimbos são do SERVIDOR, sempre ───────────────────────────────
  ///
  /// «Os temporizadores contam a partir do carimbo do servidor, nunca do relógio
  /// do tablet.» O tablet da cozinha é exactamente o aparelho que ninguém
  /// acerta — e com o relógio dele um bilhete velho podia parecer novo.
  ///
  /// `DEFAULT now()` na base e nunca um valor vindo do cliente: a garantia está
  /// na forma, e não em quem escreve se lembrar.
  criadaEm    DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  iniciadaEm  DateTime? @map("iniciada_em") @db.Timestamptz(6)
  prontaEm    DateTime? @map("pronta_em") @db.Timestamptz(6)
  entregueEm  DateTime? @map("entregue_em") @db.Timestamptz(6)

  /// Prioridade manual (KDS-008). **Exige motivo**: uma prioridade sem razão é
  /// uma decisão que ninguém consegue rever depois do turno.
  prioridade       Int     @default(0)
  motivoPrioridade String? @map("motivo_prioridade")

  /// Cancelar em preparação exige motivo (`kds-e-tempo-real.md`). O produto já
  /// foi consumido em tempo e ingredientes, e isso fica registado.
  motivoCancelamento String? @map("motivo_cancelamento")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  pedido       Order              @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  linha        OrderLine          @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Cascade)
  estacao      ProductionStation? @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)
  eventos      ProductionEvent[]

  @@unique([organizationId, id], name: "tarefa_por_organizacao")
  /// Uma linha não gera duas tarefas para a MESMA estação. A base recusa-o, e
  /// por isso um roteamento repetido não vira trabalho a dobrar na cozinha.
  @@unique([lineId, stationId], name: "tarefa_por_linha_e_estacao")
  @@index([organizationId, locationId, estado])
  @@index([organizationId, orderId])
  @@map("production_tasks")
}

/// O evento durável do KDS, e o **cursor** de retoma.
///
/// ── Porque é que o cursor é um inteiro e não o relógio ────────────────────
///
/// «SSE com cursor e eventos duráveis; ao detectar um intervalo desconhecido,
/// vai ao estado autoritativo em vez de adivinhar.» Um carimbo de tempo não
/// serve de cursor: dois eventos no mesmo milissegundo são indistinguíveis, e um
/// relógio que ande para trás faz o cliente saltar eventos sem dar por isso.
///
/// Uma sequência é monótona por construção — e «falta um evento no meio» passa a
/// ser uma subtracção, em vez de uma suposição.
model ProductionEvent {
  /// O CURSOR. `BigInt` autoincremental: monótono, e sem buracos que o cliente
  /// tenha de interpretar.
  cursor         BigInt @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  taskId         String? @map("task_id") @db.Uuid
  orderId        String  @map("order_id") @db.Uuid

  accao   String
  /// A versão da tarefa DEPOIS deste evento. É o que o cliente compara para não
  /// deixar um evento atrasado sobrepor-se a um mais recente.
  versao  Int
  detalhe Json?

  actorEmail String   @map("actor_email")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tarefa       ProductionTask? @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, locationId, cursor])
  @@map("production_events")
}


// ── E17 · o visitante da mesa ──────────────────────────────────────────────

/// O que uma sessão de visitante pode ter de INTRÍNSECO.
///
/// ── Repare no que não está aqui: `TERMINADA` ──────────────────────────────
///
/// «Uma sessão de visitante não sobrevive ao fecho da mesa. A conta fecha, a
/// credencial morre com ela.» Isso é **derivado** da sessão de mesa, e não um
/// estado a escrever — guardá-lo em paralelo criava duas verdades, e a que o
/// ecrã do visitante mostrasse passava a depender de quem escreveu por último.
/// É a mesma lição do E16, e custou lá um gatilho a aprender.
///
/// Aqui ficam só os dois estados que são **desta** sessão e de mais nada: está
/// activa, ou alguém a revogou.
enum EstadoDoVisitante {
  ACTIVA
  REVOGADA
}

/// A sessão de quem chega pelo QR da mesa.
///
/// ── O QR ABRE a sessão; não É a sessão ────────────────────────────────────
///
/// Quem entra recebe uma **credencial própria**, presa à sessão de mesa que a
/// equipa abriu. Daí saem as duas consequências que o contrato nomeia:
///
/// - **mesa fechada com QR válido não abre sessão nenhuma** — fora de serviço o
///   autocolante não vale nada, e é isso que tira valor à fotografia;
/// - **rodar o QR não mexe nesta linha** — ela tem token próprio, e nada aqui
///   aponta para o segredo que a abriu.
model GuestSession {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  tableId        String @map("table_id") @db.Uuid

  /// A sessão de mesa a que esta credencial está presa. **Obrigatória**: uma
  /// sessão de visitante sem mesa aberta é a fotografia do QR a funcionar.
  tableSessionId String @map("table_session_id") @db.Uuid

  /// O resumo da credencial. A base nunca guarda o token, como em todo o resto.
  tokenHash String @unique @map("token_hash")

  estado EstadoDoVisitante @default(ACTIVA)

  abertaEm    DateTime  @default(now()) @map("aberta_em") @db.Timestamptz(6)
  /// O último sinal de vida. Serve ao QR-006 para dizer o que está a acontecer
  /// agora — e «nunca pediu nada» é diferente de «pediu há uma hora».
  ultimaVezEm DateTime? @map("ultima_vez_em") @db.Timestamptz(6)

  revogadaEm     DateTime? @map("revogada_em") @db.Timestamptz(6)
  revogadaPor    String?   @map("revogada_por")
  /// Revogar é o acto de excepção, e um acto de excepção sem razão escrita é
  /// uma decisão que ninguém consegue rever. Mesma regra do E16.
  revogadaMotivo String?   @map("revogada_motivo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mesa         ServiceTable @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)
  sessaoDeMesa TableSession @relation(fields: [organizationId, tableSessionId], references: [organizationId, id], onDelete: Cascade)

  chamadas GuestCall[]
  @@unique([organizationId, id], name: "visitante_por_organizacao")
  @@index([organizationId, locationId, estado])
  @@index([tableSessionId])
  @@map("guest_sessions")
}


/// O que o visitante pede à sala. Fechado, porque cada um tem uma resposta
/// diferente do outro lado: um traz uma pessoa, o outro traz a conta.
enum TipoDeChamada {
  AJUDA
  CONTA
}

/// Uma chamada da mesa à sala — «chamar a equipa» e «pedir a conta».
///
/// ── A janela é por MESA, e não por telemóvel ──────────────────────────────
///
/// O QR é um token ao portador: quem tem a fotografia pode abrir **muitas**
/// sessões de visitante na mesma mesa. Uma janela por sessão limitava cada
/// telemóvel e não limitava nada — bastava abrir outro.
///
/// E é a unidade certa também do outro lado: quem serve olha para a mesa 5, não
/// para o telefone de quem lá está sentado. Duas pessoas na mesma mesa a
/// carregarem no botão ao mesmo tempo são **uma** chamada, e é isso que uma sala
/// cheia precisa que aconteça.
///
/// ── E o atendimento é uma linha, não uma coluna algures ──────────────────
///
/// «Sem a confirmação, quem chamou não sabe se alguém vem, e volta a carregar.»
/// A chamada existe como facto: foi pedida, e depois foi atendida — por alguém,
/// a uma hora. Guardar só um booleano na sessão perdia quem atendeu e quando, que
/// é o que se pergunta quando alguém diz que ninguém foi lá.
model GuestCall {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  tableId        String @map("table_id") @db.Uuid
  tableSessionId String @map("table_session_id") @db.Uuid

  /// Quem pediu. Serve para o ecrã do visitante saber que a chamada é dele — e
  /// **não** entra na deduplicação, que é da mesa.
  guestSessionId String @map("guest_session_id") @db.Uuid

  tipo TipoDeChamada

  /// ── Os carimbos são do SERVIDOR ────────────────────────────────────────
  ///
  /// A janela mede-se com eles. Com o relógio do telemóvel, quem quisesse
  /// contornar o limite mudava a hora do aparelho — e é a mesma lição do E16,
  /// onde o tablet da cozinha era o aparelho que ninguém acerta.
  pedidaEm   DateTime  @default(now()) @map("pedida_em") @db.Timestamptz(6)
  atendidaEm DateTime? @map("atendida_em") @db.Timestamptz(6)
  /// Quem atendeu. `null` enquanto ninguém foi — e ausência é ausência.
  atendidaPor String?  @map("atendida_por")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mesa         ServiceTable @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)
  sessaoDeMesa TableSession @relation(fields: [organizationId, tableSessionId], references: [organizationId, id], onDelete: Cascade)
  visitante    GuestSession @relation(fields: [organizationId, guestSessionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id], name: "chamada_por_organizacao")
  @@index([organizationId, locationId, atendidaEm])
  @@index([tableSessionId, tipo, pedidaEm])
  @@map("guest_calls")
}

// ─────────────────────────────────────────────────────────────────────────────
// E18 · Motor de reservas e capacidade concorrente
// ─────────────────────────────────────────────────────────────────────────────

/// Definições de reserva da unidade. Uma linha por unidade, e três telas editam
/// grupos diferentes de colunas.
///
/// ── Porque é UMA tabela e não três ─────────────────────────────────────────
///
/// SET-007 («preferências»), RES-B-012 («quando aceitar») e RES-B-016
/// («políticas») são três ecrãs, mas a cardinalidade é a mesma: uma linha por
/// unidade. Três tabelas de uma linha cada dariam três sítios onde a mesma
/// pergunta — «esta unidade aceita reservas?» — podia ter respostas diferentes,
/// e o dia em que discordassem seria o dia em que ninguém saberia qual manda.
///
/// Ecrãs e tabelas não têm de ser um-para-um. O que tem de ser um-para-um é a
/// decisão e o sítio onde ela vive.
model ReservationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @unique @map("location_id") @db.Uuid

  // ── SET-007 · preferências ──
  /// O interruptor. Desligado, a unidade não aceita reservas nenhumas — e é
  /// diferente de «não tem turnos configurados», que é não saber quando aceitar.
  activo          Boolean @default(false)
  duracaoPadraoMin Int    @default(90) @map("duracao_padrao_min")
  /// ── O buffer entra ANTES da conta ──────────────────────────────────────
  ///
  /// «Com buffer de 15 minutos, o fim efectivo é o fim mais 15. Aplicá-lo depois
  /// da verificação é o mesmo que não o ter.» Vive aqui e não no cálculo, para
  /// que a conta o leia sempre da mesma fonte.
  bufferMin       Int     @default(15) @map("buffer_min")

  // ── RES-B-012 · quando aceitar ──
  /// Antecedência mínima, em minutos: reservar para daqui a dez minutos não é
  /// uma reserva, é uma chegada.
  antecedenciaMinMin Int @default(60) @map("antecedencia_min_min")
  antecedenciaMaxDias Int @default(90) @map("antecedencia_max_dias")
  minPessoas          Int @default(1) @map("min_pessoas")
  maxPessoas          Int @default(12) @map("max_pessoas")
  /// Combinar mesas para grupos é uma escolha da casa, não uma capacidade do
  /// software: há salas onde ninguém quer as mesas juntas.
  permiteCombinacoes Boolean @default(true) @map("permite_combinacoes")

  // ── RES-B-016 · políticas ──
  cancelamentoAteMin Int @default(120) @map("cancelamento_ate_min")
  /// Quanto dura uma oferta de vaga da lista de espera. É o número que a
  /// expiração por RELÓGIO usa.
  retencaoMin        Int @default(15) @map("retencao_min")
  /// Minutos de tolerância antes de a casa PODER libertar uma reserva atrasada.
  /// «Libertar uma reserva atrasada é política e acção do host, nunca uma
  /// limpeza automática silenciosa» — por isso isto é um número que o ecrã
  /// mostra a quem decide, e não um varredor.
  toleranciaAtrasoMin Int @default(15) @map("tolerancia_atraso_min")
  /// ── Desligado por DECISÃO, e não por falta ─────────────────────────────
  ///
  /// «Depósito de reserva fica desligado até existir política comercial,
  /// pagamento e tratamento de cancelamento.» Existe como coluna para que a
  /// decisão seja legível no modelo — e não há caminho que a ligue.
  depositoLigado Boolean @default(false) @map("deposito_ligado")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "definicoes_de_reserva_por_organizacao")
  @@map("reservation_settings")
}

/// RES-B-014 · um turno de reserva. Hora LOCAL, e o fuso é o da unidade.
///
/// «Instantes em UTC; regras recorrentes em fuso IANA.» Um turno é uma regra
/// recorrente: as 20h de sábado são as 20h de sábado em Março e em Novembro,
/// mesmo que o instante UTC mude entre os dois.
model ServiceWindow {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  /// 0 = domingo, como o `dow` do Postgres. Igual ao E05 dos horários.
  diaDaSemana Int @map("dia_da_semana")
  /// `HH:MM` local. Texto e não `time`, pela mesma razão do E05: um `time` num
  /// `timestamptz` convida a uma conversão silenciosa.
  horaInicio String @map("hora_inicio")
  horaFim    String @map("hora_fim")
  /// ── Serviço depois da meia-noite ───────────────────────────────────────
  ///
  /// «O turno de sexta acaba no sábado.» Com `horaFim` menor que `horaInicio`,
  /// o turno atravessa o dia — e o dia a que pertence continua a ser sexta.
  /// Sem esta coluna derivada, o relatório de sexta perdia o fim do serviço.
  ultimaEntradaMin Int @default(0) @map("ultima_entrada_min")
  activo           Boolean @default(true)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  capacidades  CapacityRule[]

  @@unique([organizationId, id], name: "turno_por_organizacao")
  @@index([organizationId, locationId, diaDaSemana])
  @@map("service_windows")
}

/// RES-B-013 · o tecto de comensais de uma zona num turno.
///
/// ── É esta a regra que o LOCK guarda ───────────────────────────────────────
///
/// A exclusão por mesa impede a mesma mesa duas vezes, e não precisa de lock
/// nenhum: é uma restrição da base. Isto é outra coisa — uma CONTAGEM. Duas
/// confirmações em mesas DIFERENTES passam ambas na exclusão, lêem ambas a mesma
/// soma antiga, e a zona acaba com mais gente do que cabe.
///
/// É o desvio de escrita clássico, e é exactamente o que o isolamento
/// `serializable` mais o lock por unidade existem para impedir. Um teste de
/// concorrência sobre a MESMA mesa fica verde sem o lock, porque quem o segura é
/// a restrição; um teste sobre esta contagem, não.
model CapacityRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  /// `null` = a unidade inteira.
  areaId         String? @map("area_id") @db.Uuid
  /// `null` = todos os turnos.
  windowId       String? @map("window_id") @db.Uuid

  maxComensais Int @map("max_comensais")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  zona         ServiceArea?  @relation(fields: [organizationId, areaId], references: [organizationId, id], onDelete: Restrict)
  turno        ServiceWindow? @relation(fields: [organizationId, windowId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "capacidade_por_organizacao")
  @@index([organizationId, locationId])
  @@map("capacity_rules")
}

/// RES-B-015 · um bloqueio. Fecha capacidade num intervalo — a unidade toda, uma
/// zona, ou uma mesa.
model ReservationBlock {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  areaId         String? @map("area_id") @db.Uuid
  tableId        String? @map("table_id") @db.Uuid

  inicio DateTime @db.Timestamptz(6)
  fim    DateTime @db.Timestamptz(6)
  motivo String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  zona         ServiceArea?  @relation(fields: [organizationId, areaId], references: [organizationId, id], onDelete: Restrict)
  mesa         ServiceTable? @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "bloqueio_por_organizacao")
  @@index([organizationId, locationId, inicio])
  @@map("reservation_blocks")
}

enum EstadoDeReserva {
  CONFIRMADA
  CANCELADA
  NAO_COMPARECEU
  /// ── Chegar não é estar sentado ────────────────────────────────────────
  ///
  /// O grupo está à porta e a mesa ainda não se levantou. Sem este estado, a
  /// única forma de registar que alguém apareceu era sentá-lo — e o mapa de
  /// sala passava a mentir a quem serve.
  CHEGOU
  SENTADA

  @@map("estado_de_reserva")
}

enum OrigemDeReserva {
  HOST
  PUBLICO
  ESPERA

  @@map("origem_de_reserva")
}

/// A reserva. O que ocupa capacidade não é ela — são as ALOCAÇÕES.
model Reservation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid

  estado EstadoDeReserva @default(CONFIRMADA)
  origem OrigemDeReserva @default(HOST)

  pessoas Int
  /// UTC, sempre. A hora local é apresentação.
  inicio  DateTime @db.Timestamptz(6)
  fim     DateTime @db.Timestamptz(6)

  nome     String
  contacto String
  notas    String?
  /// ── Marketing é separado do contacto necessário à reserva ──────────────
  ///
  /// Sem esta coluna, aceitar a reserva era aceitar o marketing por omissão. É
  /// um `false` que tem de ser escrito por quem consente.
  aceitaMarketing Boolean @default(false) @map("aceita_marketing")

  /// ── O token de gestão é uma credencial, e por isso é um RESUMO ─────────
  ///
  /// «Tokens de gestão: limitados, revogáveis, não enumeráveis.» O que viaja no
  /// email é o segredo; o que fica na base é o resumo. E não é sequencial — um
  /// número a subir deixa ver a reserva do vizinho.
  gestaoTokenHash String?   @unique @map("gestao_token_hash")
  gestaoExpiraEm  DateTime? @map("gestao_expira_em") @db.Timestamptz(6)

  /// ── A chave idempotente, sem a qual o retry é a segunda reserva ────────
  ///
  /// O isolamento `serializable` aborta e manda tentar outra vez. Uma repetição
  /// sem chave cria uma reserva nova, e o cliente fica com duas mesas — que é
  /// exactamente o defeito que o retry existia para evitar.
  chaveIdempotente String @map("chave_idempotente")

  canceladaEm  DateTime? @map("cancelada_em") @db.Timestamptz(6)
  canceladaPor String?   @map("cancelada_por")
  noShowEm     DateTime? @map("no_show_em") @db.Timestamptz(6)
  /// O momento em que o grupo apareceu à porta. É o número de que a tolerância
  /// de atraso vive, e a base exige-o em `CHEGOU` e em `SENTADA`.
  chegouEm     DateTime? @map("chegou_em") @db.Timestamptz(6)
  sentadaEm    DateTime? @map("sentada_em") @db.Timestamptz(6)

  criadaPor String   @map("criada_por")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  alocacoes    ReservationAllocation[]
  mensagens    ReservationMessage[]
  esperas      WaitlistEntry[]

  @@unique([organizationId, id], name: "reserva_por_organizacao")
  @@unique([locationId, chaveIdempotente], name: "chave_idempotente_por_unidade")
  @@index([organizationId, locationId, inicio])
  @@index([organizationId, locationId, estado])
  @@map("reservations")
}

/// A ocupação de UMA mesa por UM intervalo.
///
/// ── A unidade de alocação é a MESA, nunca a combinação ─────────────────────
///
/// «Juntar a 3 e a 4 para oito pessoas não cria uma mesa nova com capacidade
/// própria: ocupa a 3 **e** a 4.» Uma reserva de combinação escreve DUAS linhas
/// aqui, uma por componente. Não há caso especial em lado nenhum: reservar a
/// combinação 3+4 e depois só a 3 bate na mesma exclusão que qualquer outra
/// sobreposição.
///
/// Se a combinação tivesse linha própria, a soma até batia certo — e essa é a
/// pior espécie de erro, porque o relatório confirma o que o corredor desmente.
model ReservationAllocation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  reservationId  String @map("reservation_id") @db.Uuid
  tableId        String @map("table_id") @db.Uuid

  /// ── O intervalo já traz o buffer ───────────────────────────────────────
  ///
  /// É o intervalo EFECTIVO, com o buffer somado ao fim. A exclusão compara isto
  /// com isto, e por isso o buffer não pode ser esquecido por quem consulta: não
  /// há sítio onde ele possa ser aplicado tarde.
  inicio DateTime @db.Timestamptz(6)
  fim    DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reserva      Reservation  @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Cascade)
  mesa         ServiceTable @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "alocacao_por_organizacao")
  @@index([tableId, inicio])
  @@map("reservation_allocations")
}

enum EstadoDaMensagem {
  /// Ainda não foi entregue — e é onde uma mensagem fica quando não há provedor
  /// configurado. Não é `FALHADA`: falhar é ter tentado e não ter conseguido, e
  /// chamar-lhe falha manda alguém procurar um erro que não existe.
  PENDENTE
  ENVIADA
  FALHADA

  @@map("estado_da_mensagem")
}

/// O envio, que é um resultado SEPARADO da reserva.
///
/// «Uma reserva confirmada com email por enviar continua confirmada. Falha de
/// envio não desfaz a reserva, e sucesso de envio não a confirma.» São duas
/// linhas em duas tabelas, e a UI diz as duas — a mesma regra do indeterminado
/// no dinheiro.
model ReservationMessage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid
  reservationId  String  @map("reservation_id") @db.Uuid

  tipo   String
  idioma String @default("es-ES")
  estado EstadoDaMensagem
  erro   String?

  /// ── A identidade da mensagem é a do ACONTECIMENTO que a causou ───────
  ///
  /// «A sua mesa está pronta» pode ter de sair duas vezes na mesma noite: a
  /// pessoa não veio à primeira, e o host volta a chamar. Com a chave
  /// `(reserva, tipo)` a segunda chamada desaparecia em silêncio — e a mesa
  /// ficava vazia com gente à porta.
  ///
  /// Cada facto que justifica avisar alguém nasce com identidade própria no
  /// momento em que acontece, e a mensagem herda-a. Daí sai tudo o resto sem
  /// mais regras: reentregar usa o mesmo acontecimento e deduplica; chamar
  /// segunda vez é outro acontecimento e entrega.
  eventoId String @unique @map("evento_id") @db.Uuid

  assunto String?
  corpo   String?

  /// ── A entrega é um CARIMBO, e é isso que a deduplica ─────────────────
  ///
  /// Reenviar acrescenta uma tentativa; entregar outra vez é impossível, porque
  /// um carimbo que já existe não se escreve de novo. A base exige-o em
  /// `ENVIADA` — um histórico que diz «entregue» sem saber quando não se audita.
  entregueEm DateTime? @map("entregue_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reserva      Reservation  @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Cascade)
  tentativas   ReservationMessageAttempt[]

  @@unique([organizationId, id], name: "mensagem_de_reserva_por_organizacao")
  @@index([organizationId, reservationId])
  @@map("reservation_messages")
}

/// Cada tentativa de entrega, com o resultado do provedor.
///
/// «O resultado do provedor é guardado, e uma falha dele não apaga o facto de a
/// reserva existir.» Uma linha por envio dava um histórico e nenhuma
/// deduplicação: nada distinguia «tentei outra vez» de «o cliente recebeu duas
/// vezes».
model ReservationMessageAttempt {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  messageId      String  @map("message_id") @db.Uuid
  provedor       String?
  resultado      String
  erro           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mensagem     ReservationMessage @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id], name: "tentativa_por_organizacao")
  @@index([messageId, createdAt])
  @@map("reservation_message_attempts")
}

/// O texto de uma mensagem transaccional, por unidade, tipo e idioma.
///
/// O idioma faz parte da chave porque a mesma confirmação em espanhol e em
/// inglês são dois textos, e não duas traduções de um — quem escreve o de inglês
/// não está a traduzir, está a escrever para outra pessoa.
model MessageTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  tipo           String
  idioma         String
  assunto        String
  corpo          String
  activo         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "template_por_organizacao")
  @@unique([locationId, tipo, idioma], name: "um_template_por_unidade_tipo_idioma")
  @@map("message_templates")
}

/// O conector de mensageria da unidade. **Nasce desligado.**
///
/// «Sem provedor configurado, o conector fica desligado e visível como desligado
/// — não a fingir que enviou.»
///
/// `activo` sem `provedor` não é um estado: há um `CHECK` a impedi-lo. É a
/// garantia na forma — ninguém pode ligar o conector sem dizer quem entrega, e o
/// «activo» sozinho seria exactamente o fingimento que o enunciado proíbe.
model MessagingConnector {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @unique @map("location_id") @db.Uuid
  provedor       String?
  activo         Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "conector_por_organizacao")
  @@map("messaging_connectors")
}

enum EstadoDaEspera {
  A_ESPERA
  /// O «chamado» do contrato, mais a vaga concreta que a chamada carrega — e é
  /// essa vaga que consome capacidade enquanto a retenção dura.
  COM_OFERTA
  SENTADO
  DESISTIU

  @@map("estado_da_espera")
}

/// A lista de espera. **Não reserva nada por existir.**
///
/// ── A retenção expira por RELÓGIO, e não por evento ────────────────────────
///
/// Uma oferta de vaga consome capacidade enquanto dura. O que se esquece é o
/// fim: se a capacidade só for libertada quando alguém abre o ecrã, uma retenção
/// esquecida bloqueia uma mesa a noite inteira — e ninguém sabe porquê, porque
/// do lado do software não correu nada mal.
///
/// Por isso `ofertaExpiraEm` é um instante, e a ocupação lê-o contra o relógio
/// da BASE. Não há acção que precise de acontecer para a mesa voltar a estar
/// livre. O varredor existe por higiene, não por correcção: se ele nunca correr,
/// a resposta continua certa.
model WaitlistEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid

  estado   EstadoDaEspera @default(A_ESPERA)
  nome     String
  contacto String
  pessoas  Int

  /// A oferta, quando existe.
  ofertaTableId  String?   @map("oferta_table_id") @db.Uuid
  ofertaInicio   DateTime? @map("oferta_inicio") @db.Timestamptz(6)
  ofertaFim      DateTime? @map("oferta_fim") @db.Timestamptz(6)
  ofertaExpiraEm DateTime? @map("oferta_expira_em") @db.Timestamptz(6)

  /// A reserva que a oferta virou, se foi aceite.
  reservationId String? @map("reservation_id") @db.Uuid

  // ── E19 ──
  /// Os carimbos de que o relatório de tempos de espera vive. Um `SENTADO` sem
  /// `sentadoEm` é uma linha que diz que alguém se sentou e não sabe quando — a
  /// base tem um `CHECK` a impedi-lo.
  chamadoEm      DateTime? @map("chamado_em") @db.Timestamptz(6)
  sentadoEm      DateTime? @map("sentado_em") @db.Timestamptz(6)
  desistiuEm     DateTime? @map("desistiu_em") @db.Timestamptz(6)
  /// A sessão de mesa onde o grupo se sentou. É o que liga a espera à sala.
  tableSessionId String?   @map("table_session_id") @db.Uuid
  notas          String?

  /// ── E o que NÃO existe aqui é a garantia ──────────────────────────────
  ///
  /// Não há `posicao`, nem `numeroNaFila`, nem `senha`. «Ninguém pode mostrar um
  /// número errado se o número não existe em lado nenhum para ser mostrado.»
  ///
  /// A posição deriva-se, e deriva-se dentro do grupo que cabe nas MESMAS
  /// MESAS: «é o 2.º dos grupos de 5 ou 6» sobrevive ao grupo de 2 passar à
  /// frente; «é o 3.º» não sobrevive a nada.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  mesaOferecida ServiceTable? @relation(fields: [organizationId, ofertaTableId], references: [organizationId, id], onDelete: Restrict)
  reserva       Reservation?  @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict)
  sessaoDeMesa  TableSession? @relation(fields: [organizationId, tableSessionId], references: [organizationId, id], onDelete: Restrict)
  zonas         WaitlistArea[]

  @@unique([organizationId, id], name: "espera_por_organizacao")
  @@index([organizationId, locationId, estado])
  @@index([ofertaTableId, ofertaExpiraEm])
  @@map("waitlist_entries")
}

/// As zonas que servem um grupo à espera.
///
/// É uma PREFERÊNCIA, e por isso é uma tabela e não uma coluna: um grupo pode
/// aceitar o terraço e o salão, e uma coluna só deixaria escolher um.
///
/// Sem linhas, a espera aceita a unidade inteira. Ausência é ausência — «não
/// disse nada» não é «só quer o salão».
model WaitlistArea {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  waitlistId     String @map("waitlist_id") @db.Uuid
  areaId         String @map("area_id") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  espera       WaitlistEntry @relation(fields: [organizationId, waitlistId], references: [organizationId, id], onDelete: Cascade)
  zona         ServiceArea   @relation(fields: [organizationId, areaId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "zona_da_espera_por_organizacao")
  @@unique([waitlistId, areaId], name: "uma_zona_por_espera")
  @@index([waitlistId])
  @@map("waitlist_areas")
}


/// A área que a unidade entrega, e a taxa dela.
///
/// «Se não houver taxa definida para aquela área, o sistema não escolhe uma.» A
/// taxa é obrigatória **na área**: uma área existe com o seu preço, ou não
/// existe. Não há linha sem preço, que seria o sítio exacto onde o zero por
/// omissão nasceria.
model DeliveryArea {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  codigoPostal   String @map("codigo_postal")
  taxaMenor      Int    @map("taxa_menor")
  moeda          String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  entregas     OrderDelivery[]

  @@unique([organizationId, id], name: "area_por_organizacao")
  @@unique([locationId, codigoPostal], name: "uma_area_por_codigo_postal")
  @@map("delivery_areas")
}

/// A entrega de um pedido.
///
/// A morada vive AQUI, e não no pedido: «não exponha endereços ou telefones nas
/// telas públicas de fila». A projecção da fila lê `orders`, e a morada não está
/// lá — não é uma coluna que alguém tem de se lembrar de não seleccionar.
model OrderDelivery {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  orderId        String  @unique @map("order_id") @db.Uuid
  areaId         String? @map("area_id") @db.Uuid
  morada         String
  codigoPostal   String  @map("codigo_postal")
  contacto       String
  notas          String?
  /// A taxa COBRADA, copiada da área no momento do pedido. Ler a área mais tarde
  /// daria um pedido cujo preço muda quando alguém edita a tabela.
  taxaMenor  Int       @map("taxa_menor")
  moeda      String
  entregueEm DateTime? @map("entregue_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pedido       Order         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  area         DeliveryArea? @relation(fields: [organizationId, areaId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "entrega_por_organizacao")
  @@unique([organizationId, orderId], name: "uma_entrega_por_pedido")
  @@map("order_deliveries")
}

/// O conector de entrega externa. **Nasce desligado.**
///
/// Mesma forma do conector de mensageria do E19: `activo` sem `provedor` não é um
/// estado, e há um `CHECK` a impedi-lo. «Uma integração que finge é pior do que
/// uma que falta, porque a que falta vê-se.»
model DeliveryConnector {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @unique @map("location_id") @db.Uuid
  provedor       String?
  activo         Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "conector_de_entrega_por_organizacao")
  @@map("delivery_connectors")
}

/// O que lá fora se chama «Burger 4» é aqui um produto.
///
/// Sem este mapa, cada pedido externo obrigava alguém a adivinhar — e adivinhar
/// num pedido é servir outra coisa.
model ExternalCatalogMapping {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  canalExterno   String @map("canal_externo")
  idExterno      String @map("id_externo")
  productId      String @map("product_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  produto      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], name: "mapa_por_organizacao")
  @@unique([locationId, canalExterno, idExterno], name: "um_mapa_por_id_externo")
  @@map("external_catalog_mappings")
}

// ═══════════════════════════════════════════════════════════════════════════
// E22 — contas, pagamentos e devoluções
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoDaTentativa {
  CRIADA
  PROCESSANDO
  /// Saiu e não se sabe se chegou. **Não é um erro, é um estado** — e é o mais
  /// perigoso: criar outra cobrança antes de o reconciliar é cobrar duas vezes.
  INDETERMINADA
  CONFIRMADA
  FALHOU
  CANCELADA
}

enum MeioDePagamento {
  DINHEIRO
  CARTAO
  /// «Pago fora da BossaOS», com responsável e motivo. Não cria receita
  /// processada nem documento fiscal — CT-08 e D08.
  FORA_DA_BOSSAOS
}

enum TipoDeAjuste {
  DESCONTO
  CORTESIA
}

enum BaseDoAjuste {
  LINHA
  CONTA
}

/// A conta: a **obrigação**, e não o que se recebeu.
///
/// ── Não há coluna de estado, de propósito ─────────────────────────────────
///
/// «É derivado dos pagamentos, não escrito na conta.» Uma coluna `estado` é um
/// sítio onde alguém escreve «liquidada» sem existir um pagamento — uma
/// afirmação sem prova. É a mesma decisão da posição na lista de espera do E19.
model Bill {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  sessionId      String? @map("session_id") @db.Uuid
  numero         String
  moeda          String  @db.Char(3)
  /// Derivado por gatilho a partir das linhas e dos ajustes. Um valor escrito
  /// aqui de fora é substituído: não é uma regra, é uma coisa que não se
  /// consegue fazer.
  devidoMenor    Int     @default(0) @map("devido_menor")
  fechadaEm      DateTime? @map("fechada_em") @db.Timestamptz(6)
  fechadaPor     String?   @map("fechada_por") @db.Uuid
  acontecimentos ProviderEvent[]
  documentosFiscais FiscalDocument[]

  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)
  actualizadaEm DateTime @default(now()) @map("actualizada_em") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sessao       TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  linhas       BillLine[]
  ajustes      BillAdjustment[]
  tentativas   PaymentAttempt[]
  pagamentos   Payment[]

  sessaoDeKiosk KioskSession?
  @@unique([locationId, numero], name: "um_numero_de_conta_por_unidade")
  @@map("bills")
}

/// A linha da conta, com o preço que valia quando entrou.
///
/// Copia-se em vez de se ler mais tarde, pela mesma razão da taxa de entrega do
/// E20: uma conta cujo valor muda quando alguém edita a carta não é uma conta.
model BillLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  billId         String  @map("bill_id") @db.Uuid
  orderLineId    String? @map("order_line_id") @db.Uuid
  nome           String
  quantidade     Int     @default(1)
  unitarioMenor  Int     @map("unitario_menor")
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  linhaDoPedido OrderLine?  @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  ajustes      BillAdjustment[]

  @@map("bill_lines")
}

/// Desconto e cortesia: uma linha ao lado, nunca um `UPDATE` no preço.
///
/// «Desconto/estorno não reescrevem a venda original.» A venda fica como foi, e
/// o que se tirou vê-se — com quem autorizou e porquê.
model BillAdjustment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  billId         String  @map("bill_id") @db.Uuid
  billLineId     String? @map("bill_line_id") @db.Uuid
  tipo           TipoDeAjuste
  base           BaseDoAjuste
  montanteMenor  Int     @map("montante_menor")
  /// Obrigatório. Um desconto sem motivo é indistinguível de um erro de dedo, e
  /// é o campo que o gerente lê quando a caixa não bate.
  motivo         String
  autorizadoPor  String  @map("autorizado_por") @db.Uuid
  /// A linha que este ajuste ANULA. Corrigir é um registo novo — imutável sem
  /// reversão não é rigor, é uma armadilha: um desconto por engano ficaria para
  /// sempre. As duas linhas continuam a ver-se; o que muda é o que conta.
  reverteId      String? @unique @map("reverte_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  linha        BillLine?    @relation(fields: [billLineId], references: [id], onDelete: Cascade)
  autor        User         @relation(fields: [autorizadoPor], references: [id], onDelete: Restrict)
  reverte      BillAdjustment?  @relation("reversao", fields: [reverteId], references: [id], onDelete: Restrict)
  revertidoPor BillAdjustment?  @relation("reversao")

  @@map("bill_adjustments")
}

/// A tentativa: saiu daqui. **Não prova que chegou.**
model PaymentAttempt {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  billId            String @map("bill_id") @db.Uuid
  estado            EstadoDaTentativa @default(CRIADA)
  meio              MeioDePagamento
  montanteMenor     Int    @map("montante_menor")
  chaveIdempotente  String @map("chave_idempotente")
  criadaEm          DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)
  resolvidaEm       DateTime? @map("resolvida_em") @db.Timestamptz(6)
  acontecimentos ProviderEvent[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  pagamento    Payment?

  @@unique([organizationId, chaveIdempotente], name: "uma_tentativa_por_chave")
  @@map("payment_attempts")
}

/// O pagamento: o confirmado.
///
/// Não tem estado — **existir é estar confirmado**. Um `Payment` com
/// `estado = falhou` seria dinheiro que se desconta a somar, e somar o que
/// falhou é como as contas passam a mentir. Imutável por gatilho.
model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  billId         String @map("bill_id") @db.Uuid
  attemptId      String @unique @map("attempt_id") @db.Uuid
  meio           MeioDePagamento
  montanteMenor  Int    @map("montante_menor")
  /// Só em dinheiro físico. Guarda-se o RECEBIDO e o troco deriva-se: guardar a
  /// subtracção era guardar um número que pode discordar das parcelas.
  recebidoMenor  Int?   @map("recebido_menor")
  /// A gorjeta é dinheiro que NÃO é da casa. Somá-la à venda faz o relatório de
  /// receita mentir e a partilha da equipa desaparecer.
  gorjetaMenor   Int    @default(0) @map("gorjeta_menor")
  provedor       String?
  provedorRef    String? @map("provedor_ref")
  /// O identificador que vai no endereço do comprovativo. NÃO é o `id`: um
  /// endereço com o identificador interno deixa adivinhar os vizinhos.
  reciboPublico  String  @default(uuid()) @map("recibo_publico") @db.Uuid
  confirmadoEm   DateTime @default(now()) @map("confirmado_em") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  tentativa    PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  devolucoes   Refund[]

  @@map("payments")
}

/// A devolução, que **não é um pagamento negativo**.
///
/// Parcial é saldo derivado do capturado ainda não devolvido — não há coluna
/// `devolvido`, que era onde duas devoluções concorrentes se escreviam por cima.
model Refund {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  paymentId        String @map("payment_id") @db.Uuid
  montanteMenor    Int    @map("montante_menor")
  motivo           String
  autorizadoPor    String @map("autorizado_por") @db.Uuid
  chaveIdempotente String @map("chave_idempotente")
  provedorRef      String? @unique @map("provedor_ref")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pagamento    Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  autor        User         @relation(fields: [autorizadoPor], references: [id], onDelete: Restrict)

  @@unique([organizationId, chaveIdempotente], name: "uma_devolucao_por_chave")
  @@map("refunds")
}

// ═══════════════════════════════════════════════════════════════════════════
// E22 — caixa
// ═══════════════════════════════════════════════════════════════════════════

enum AcontecimentoDeCaixa {
  ABERTURA
  CONTAGEM
  FECHO
  REABERTURA
}

enum TipoDeMovimento {
  ENTRADA
  SAIDA
}

/// A caixa: identidade, fundo e moeda. **Mais nada.**
///
/// O estado não é uma coluna — deriva-se dos acontecimentos. Sem coluna, não há
/// sítio onde alguém feche uma caixa sem ficar registo.
model CashRegister {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  moeda          String @db.Char(3)
  fundoMenor     Int    @map("fundo_menor")
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  acontecimentos CashRegisterEvent[]
  movimentos     CashMovement[]

  @@map("cash_registers")
}

/// O rasto que não se apaga: abrir, contar, fechar, reabrir. Imutável.
model CashRegisterEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  registerId     String @map("register_id") @db.Uuid
  tipo           AcontecimentoDeCaixa
  actor          String @db.Uuid
  /// O ÚNICO número que um humano escreve. O esperado e a diferença derivam-se:
  /// uma diferença guardada é uma diferença que se pode editar até dar zero.
  contadoMenor   Int?    @map("contado_menor")
  motivo         String?
  autorizadoPor  String? @map("autorizado_por") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caixa        CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  quemFez      User         @relation("actorDoAcontecimento", fields: [actor], references: [id], onDelete: Restrict)
  quemAutorizou User?       @relation("autorDaDivergencia", fields: [autorizadoPor], references: [id], onDelete: Restrict)

  @@map("cash_register_events")
}

/// Movimento de dinheiro **físico**.
///
/// Não há coluna de meio de pagamento, de propósito: tudo o que está aqui é
/// dinheiro. Não é uma regra que alguém tenha de respeitar ao escrever a
/// consulta; é uma coluna que não existe.
model CashMovement {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  registerId     String  @map("register_id") @db.Uuid
  tipo           TipoDeMovimento
  montanteMenor  Int     @map("montante_menor")
  motivo         String
  actor          String  @db.Uuid
  paymentId      String? @unique @map("payment_id") @db.Uuid
  corrigeId      String? @unique @map("corrige_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caixa        CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  quemFez      User         @relation("actorDoMovimento", fields: [actor], references: [id], onDelete: Restrict)
  corrige      CashMovement?  @relation("correccao", fields: [corrigeId], references: [id], onDelete: Restrict)
  corrigidoPor CashMovement?  @relation("correccao")

  @@map("cash_movements")
}

// ═══════════════════════════════════════════════════════════════════════════
// E23 — a fronteira: adquirente, webhooks e devoluções
// ═══════════════════════════════════════════════════════════════════════════

/// O acontecimento como o adquirente o conta.
///
/// A identidade é a do ACONTECIMENTO — a mesma forma da mensageria do E19. Um
/// reenvio traz o mesmo `eventoId` e deduplica; um facto novo traz identidade
/// nova e entra. A garantia é o índice único, e não um `if já existe`: entre a
/// procura e a inserção cabe o segundo processo.
model ProviderEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  provedor       String
  eventoId       String  @map("evento_id")
  tipo           String
  billId         String? @map("bill_id") @db.Uuid
  attemptId      String? @map("attempt_id") @db.Uuid
  /// O estado que o PROVEDOR autoriza, e não a nossa transição. É isto que
  /// permite reconciliar eventos fora de ordem sem perder nenhum.
  estadoProvedor String  @map("estado_provedor")
  montanteMenor  Int?    @map("montante_menor")
  /// O instante que o provedor carimbou. A ordenação é por aqui, nunca pela
  /// chegada — que é precisamente o que não é de confiança.
  ocorridoEm     DateTime @map("ocorrido_em") @db.Timestamptz(6)
  recebidoEm     DateTime @default(now()) @map("recebido_em") @db.Timestamptz(6)
  /// O corpo, para auditoria. A assinatura NUNCA: um segredo em registo é um
  /// segredo publicado.
  corpo          Json?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  tentativa    PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([provedor, eventoId], name: "um_acontecimento_por_provedor")
  @@index([attemptId, ocorridoEm])
  @@map("provider_events")
}

/// A ligação ao adquirente, por unidade.
///
/// «Não presuma que a conta do SaaS pode receber vendas dos restaurantes.» Não
/// há aqui coluna para chave secreta, de propósito: segredo vive no ambiente,
/// nunca na base nem num endereço.
model PaymentConnector {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @unique @map("location_id") @db.Uuid
  provedor       String?
  merchantId     String? @map("merchant_id")
  /// Ligado exige provedor E merchant — por `CHECK`. Um conector ligado sem
  /// titularidade era declarar pagamento real pronto sem o ser.
  activo         Boolean @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  actualizadoEm  DateTime @default(now()) @map("actualizado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("payment_connectors")
}

// ═══════════════════════════════════════════════════════════════════════════
// E24 — documentos fiscais
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoDoDocumento {
  PENDENTE
  /// Saiu e não há resposta. É o estado que dói, e é o que costuma ser
  /// colapsado em «falhou» — a mesma lição do indeterminado do E22.
  ENVIADO
  /// **Só aqui é um documento fiscal.** Antes disto é um ficheiro.
  ACEITE
  REJEITADO
  ANULADO
}

enum TipoDeDocumento {
  FACTURA
  RECTIFICATIVA
  ANULACAO
}

/// Um documento fiscal.
///
/// ── O que a base garante, e o que ela deliberadamente NÃO sabe ────────────
///
/// Garante a **forma**: identidade por acontecimento, estados, encadeamento,
/// imutabilidade. Não sabe o **formato** — o conteúdo do QR, o algoritmo do
/// hash, a estrutura do registo. A ordem técnica que os define não foi lida, e
/// está dito no ADR 0002 com a data em que se foi ver.
model FiscalDocument {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  billId         String? @map("bill_id") @db.Uuid
  tipo           TipoDeDocumento   @default(FACTURA)
  estado         EstadoDoDocumento @default(PENDENTE)
  /// A identidade. Uma emissão repetida traz o mesmo e devolve o MESMO
  /// documento; uma correcção é um facto novo, e sai.
  acontecimento  String
  anteriorId     String? @map("anterior_id") @db.Uuid
  resumo         String?
  motivoRejeicao String? @map("motivo_rejeicao")
  corrigeId      String? @unique @map("corrige_id") @db.Uuid
  numeroProvedor String? @map("numero_provedor")
  provedor       String?
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  enviadoEm      DateTime? @map("enviado_em") @db.Timestamptz(6)
  respondidoEm   DateTime? @map("respondido_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  conta        Bill?        @relation(fields: [billId], references: [id], onDelete: SetNull)
  anterior     FiscalDocument?  @relation("cadeia", fields: [anteriorId], references: [id], onDelete: Restrict)
  seguinte     FiscalDocument[] @relation("cadeia")
  corrige      FiscalDocument?  @relation("correccao", fields: [corrigeId], references: [id], onDelete: Restrict)
  corrigidoPor FiscalDocument?  @relation("correccao")

  @@unique([organizationId, acontecimento], name: "um_documento_por_acontecimento")
  @@map("fiscal_documents")
}

/// A ligação ao fornecedor homologado. Sem ela, a emissão real fica bloqueada.
model FiscalConnector {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @unique @map("location_id") @db.Uuid
  provedor       String?
  /// `SANDBOX` ou `PRODUCAO`. Escrever o ambiente evita a pior confusão desta
  /// área: julgar que se emitiu a sério contra um servidor de ensaio.
  ambiente       String?
  nif            String?
  activo         Boolean @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  actualizadoEm  DateTime @default(now()) @map("actualizado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("fiscal_connectors")
}

// ═══════════════════════════════════════════════════════════════════════════
// E25 — stock e fichas técnicas
// ═══════════════════════════════════════════════════════════════════════════

enum TipoDeMovimentoDeStock {
  ENTRADA
  CONSUMO
  QUEBRA
  AJUSTE
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
}

/// Um insumo.
///
/// ── O saldo é DERIVADO, e ninguém lhe escreve ─────────────────────────────
///
/// Há coluna porque a leitura tem de ser barata, mas o gatilho recalcula-a a
/// cada movimento **e** repõe qualquer `UPDATE` directo a partir da soma. É a
/// forma do `producao_em` do E20: não é uma regra que se respeita, é uma coisa
/// que não se consegue fazer.
model StockItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  /// `KG`, `L` ou `UN`.
  unidade        String
  /// Milésimos da unidade: 1 kg é 1_000_000, 1 g é 1000. Inteiro, sempre — o
  /// mesmo argumento do dinheiro, e o sufixo diz a escala.
  saldoMili      BigInt  @default(0) @map("saldo_mili")
  minimoMili     BigInt? @map("minimo_mili")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movimentos   StockMovement[]
  emFichas     RecipeLine[]
  deFornecedores SupplierItem[]

  @@unique([locationId, nome], name: "um_insumo_por_nome_e_unidade")
  @@map("stock_items")
}

/// Um movimento. Cada um com momento, autor e razão — e o saldo é a soma deles.
model StockMovement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  tipo           TipoDeMovimentoDeStock
  /// Sempre POSITIVA: o sinal vem do tipo. Um consumo com quantidade negativa
  /// seria uma entrada disfarçada, e ninguém daria por isso no relatório.
  quantidadeMili BigInt  @map("quantidade_mili")
  motivo         String
  actor          String? @db.Uuid
  orderLineId    String? @map("order_line_id") @db.Uuid
  /// ── A linha de RECEPÇÃO que trouxe esta entrada ────────────────────────
  ///
  /// Repare-se no que NÃO existe aqui: não há `purchase_order_line_id` nem
  /// `supplier_invoice_line_id`. Uma encomenda é uma intenção e uma factura é
  /// papel; só a recepção mexe no stock, e a garantia é **pela ausência** —
  /// uma coluna que não existe não pode apontar para o sítio errado.
  receiptLineId  String? @map("receipt_line_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         StockItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quemFez      User?        @relation(fields: [actor], references: [id], onDelete: SetNull)
  linhaDoPedido OrderLine?  @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  linhaDaRecepcao ReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

/// A ficha técnica — uma ÁRVORE.
model Recipe {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  nome           String
  productId      String? @unique @map("product_id") @db.Uuid
  rendeMili      BigInt  @default(1000) @map("rende_mili")
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  produto      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  linhas       RecipeLine[] @relation("linhasDaFicha")
  usadaEm      RecipeLine[] @relation("subReceita")

  @@map("recipes")
}

/// Uma linha aponta OU para um insumo OU para outra ficha. Nunca as duas, nunca
/// nenhuma — uma linha que não desconta nada é uma linha que ninguém vê falhar.
///
/// O **ciclo é recusado na escrita**, por gatilho com travessia recursiva. Em
/// serviço, o que se veria não era um ciclo: era o sistema a parar.
model RecipeLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  recipeId       String  @map("recipe_id") @db.Uuid
  itemId         String? @map("item_id") @db.Uuid
  subRecipeId    String? @map("sub_recipe_id") @db.Uuid
  quantidadeMili BigInt  @map("quantidade_mili")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ficha        Recipe       @relation("linhasDaFicha", fields: [recipeId], references: [id], onDelete: Cascade)
  insumo       StockItem?   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  subFicha     Recipe?      @relation("subReceita", fields: [subRecipeId], references: [id], onDelete: Restrict)

  @@map("recipe_lines")
}

// ── E26 · Compras e fornecedores ───────────────────────────────────────────
//
// Contrato: `docs/architecture/compras-e-fornecedores.md`.
//
// Encomendado, recebido e facturado vivem em três sítios porque são três factos
// ditos por gente diferente em momentos diferentes. As diferenças **derivam-se**
// da comparação — não há coluna `divergencia`, pela mesma razão que não há
// coluna de saldo de stock nem de estado da conta.

model Supplier {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  contacto       String?
  nif            String?
  arquivadoEm    DateTime? @map("arquivado_em") @db.Timestamptz(6)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  artigos      SupplierItem[]
  encomendas   PurchaseOrder[]
  facturas     SupplierInvoice[]

  @@unique([locationId, nome], name: "um_fornecedor_por_nome")
  @@map("suppliers")
}

/// O artigo **deste** fornecedor: a embalagem que ele vende e o que ela dá.
///
/// A ligação é por fornecedor E por insumo, porque o mesmo insumo comprado a
/// dois fornecedores tem duas embalagens e dois preços.
model SupplierItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  supplierId     String @map("supplier_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  /// O nome do que se compra: «saco 25 kg», «caixa 12».
  unidadeDeCompra String @map("unidade_de_compra")
  /// ── Quantos milésimos da unidade de USO dá UMA unidade de compra ───────
  ///
  /// Um saco de 25 kg é `25_000_000`, na escala do E25 (1 kg = 1 000 000).
  ///
  /// `NOT NULL` com `CHECK > 0`, e não uma validação que alguém tem de se
  /// lembrar de escrever: **sem factor, recusa-se**. Um saco lido como uma
  /// unidade dá stock de 1 onde há 25 000 g, e o inventário só o revela ao fim
  /// do mês — sem causa aparente.
  factorMili     BigInt @map("factor_mili")
  /// O preço de tabela, em unidade menor. É referência, não verdade: a verdade
  /// do custo é o que vem na recepção.
  precoMenor     BigInt? @map("preco_menor")
  moeda          String  @default("EUR")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fornecedor   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  insumo       StockItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  linhas       PurchaseOrderLine[]

  @@unique([supplierId, itemId], name: "um_artigo_por_fornecedor_e_insumo")
  @@map("supplier_items")
  linhasDeFactura SupplierInvoiceLine[]
}

/// A ENCOMENDA — uma intenção. Não move stock nenhum.
model PurchaseOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  supplierId     String @map("supplier_id") @db.Uuid
  numero         String
  /// `ABERTA` ou `FECHADA`. **Não** há `RECEBIDA`: obrigaria a escolher entre
  /// «recebida» e «recebida a menos», e a escolha apagava a diferença que a
  /// casa precisa de ver. O que se recebeu deriva-se das recepções.
  estado         String   @default("ABERTA")
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)
  criadaPor      String?  @map("criada_por")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fornecedor   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  linhas       PurchaseOrderLine[]
  recepcoes    Receipt[]
  facturas     SupplierInvoice[]

  @@unique([locationId, numero], name: "um_numero_por_unidade")
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  supplierItemId  String @map("supplier_item_id") @db.Uuid
  /// Milésimos de **unidades de compra**. 10 sacos são `10_000_000`.
  encomendadoMili BigInt @map("encomendado_mili")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  encomenda    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  artigo       SupplierItem  @relation(fields: [supplierItemId], references: [id], onDelete: Restrict)
  recebidas    ReceiptLine[]

  @@unique([purchaseOrderId, supplierItemId], name: "um_artigo_por_encomenda")
  @@map("purchase_order_lines")
}

/// A RECEPÇÃO — um facto. É a única coisa que mexe no stock.
///
/// Várias por encomenda, porque a entrega parcial é o normal e não a excepção.
model Receipt {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  recebidaEm      DateTime @default(now()) @map("recebida_em") @db.Timestamptz(6)
  recebidaPor     String?  @map("recebida_por")
  nota            String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  encomenda    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  linhas       ReceiptLine[]

  @@map("receipts")
}

model ReceiptLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  receiptId      String @map("receipt_id") @db.Uuid
  purchaseOrderLineId String @map("purchase_order_line_id") @db.Uuid
  /// Milésimos de **unidades de compra** — o que se contou à porta.
  recebidoMili   BigInt @map("recebido_mili")
  /// O custo da LINHA INTEIRA, em unidade menor. Não o unitário: um unitário
  /// por milésimo arredondava para zero em qualquer artigo barato, e o erro
  /// acumulava-se em silêncio a cada entrada.
  custoTotalMenor BigInt @map("custo_total_menor")
  moeda          String  @default("EUR")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recepcao     Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  linha        PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  movimentos   StockMovement[]

  @@map("receipt_lines")
}

/// A FACTURA — a versão do fornecedor. É papel: não move stock.
model SupplierInvoice {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  supplierId      String @map("supplier_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  numero          String
  emitidaEm       DateTime @default(now()) @map("emitida_em") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fornecedor   Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  encomenda    PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  linhas       SupplierInvoiceLine[]

  @@unique([supplierId, numero], name: "um_numero_por_fornecedor")
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid
  supplierItemId String @map("supplier_item_id") @db.Uuid
  /// Milésimos de **unidades de compra** — o que o fornecedor DIZ que entregou.
  facturadoMili  BigInt @map("facturado_mili")
  totalMenor     BigInt @map("total_menor")
  moeda          String @default("EUR")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  factura      SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  artigo       SupplierItem    @relation(fields: [supplierItemId], references: [id], onDelete: Restrict)

  @@map("supplier_invoice_lines")
}

// ── E27 · CRM, fidelidade e campanhas ──────────────────────────────────────
//
// Contrato: `docs/architecture/consentimento-e-campanhas.md`.
//
// Repare-se no que NÃO existe aqui: nenhuma coluna «aceita campanhas», em
// modelo nenhum. Uma coluna que não existe não pode ficar a `true` por omissão,
// por importação, ou por alguém ter marcado a caixa errada num formulário de
// reserva. O consentimento é um registo de ACONTECIMENTOS e o estado deriva-se.

enum FinalidadeDeContacto {
  SERVICO
  CAMPANHA
}

enum CanalDeContacto {
  EMAIL
  SMS
}

enum AccaoDeConsentimento {
  DADO
  RETIRADO
}

enum TipoDeMovimentoDePontos {
  GANHO
  RESGATE
  AJUSTE
  EXPIRACAO
}

model Customer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  email          String?
  telefone       String?
  /// De onde veio esta pessoa. É informação de origem, não de permissão.
  origem         String?
  /// ── O saldo DERIVA-SE dos movimentos, como o stock do E25 ─────────────
  ///
  /// Um gatilho repõe quem o escrever à mão. Um programa de fidelidade cujo
  /// saldo se escreve é um programa onde ninguém explica de onde veio um ponto.
  saldoPontos    BigInt   @default(0) @map("saldo_pontos")
  /// Quando dois contactos se juntam, o absorvido aponta para o que ficou. Não
  /// se apaga: quem for ver a visita antiga tem de chegar à pessoa certa.
  juntadoAId     String?  @map("juntado_a_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  juntadoA     Customer?    @relation("juncaoDeContactos", fields: [juntadoAId], references: [id], onDelete: SetNull)
  absorvidos   Customer[]   @relation("juncaoDeContactos")
  consentimentos ConsentEvent[]
  pontos       LoyaltyMovement[]
  envios       CampaignDelivery[]
  respostas    FeedbackEntry[]

  pedidos OrderContact[]
  @@map("customers")
}

/// O consentimento é um ACONTECIMENTO. O estado actual é o último de cada
/// `(pessoa, finalidade, canal)` — derivado, nunca guardado.
model ConsentEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  finalidade     FinalidadeDeContacto
  canal          CanalDeContacto
  accao          AccaoDeConsentimento
  /// De onde veio: o ecrã, o formulário, a pessoa que o registou. Sem origem, um
  /// consentimento não se consegue defender a ninguém.
  origem         String
  /// ── A finalidade de SERVIÇO acaba ─────────────────────────────────────
  ///
  /// O telefone deixado à porta serve para avisar que a mesa está pronta. Meia
  /// hora depois a finalidade acabou. `null` é «não caduca», e é o que a
  /// campanha usa — porque essa só acaba quando a pessoa a retirar.
  expiraEm       DateTime? @map("expira_em") @db.Timestamptz(6)
  momento        DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, finalidade, canal, momento])
  @@map("consent_events")
}

model LoyaltyMovement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  tipo           TipoDeMovimentoDePontos
  /// Sempre POSITIVA: o sinal vem do tipo. A mesma regra do stock.
  pontos         BigInt
  motivo         String
  momento        DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_movements")
}

/// Uma recompensa custa pontos e vale dinheiro. O dinheiro é inteiro em unidade
/// menor, com o sufixo que a guarda reconhece.
model LoyaltyReward {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  custoPontos    BigInt @map("custo_pontos")
  valorMenor     BigInt @map("valor_menor")
  moeda          String @default("EUR")
  arquivadaEm    DateTime? @map("arquivada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("loyalty_rewards")
}

/// O segmento guarda CRITÉRIOS, não pessoas.
///
/// Não há tabela de membros, de propósito: uma lista exportada e reimportada
/// perde a origem do consentimento, e uma lista colada não tem origem nenhuma.
model Segment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  /// Os critérios. Avaliados no momento do envio, nunca congelados.
  regra          Json
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  campanhas    Campaign[]

  @@unique([locationId, nome], name: "um_segmento_por_nome")
  @@map("segments")
}

/// O modelo de uma mensagem de CAMPANHA.
///
/// ── Porque é que não reaproveita o `MessageTemplate` ──────────────────────
///
/// O que já existe é transaccional: identifica-se por `(unidade, tipo, idioma)`
/// — «o email de confirmação de reserva, em espanhol». Este identifica-se por
/// **nome**, escolhido por quem escreve — «a promoção de Natal». São
/// identidades diferentes e ciclos de vida diferentes; forçá-los na mesma
/// tabela obrigava o `tipo` a passar a ser texto livre, e a chave única que
/// impede dois modelos de confirmação para o mesmo idioma deixava de valer.
model CampaignTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  canal          CanalDeContacto
  assunto        String?
  corpo          String
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  campanhas    Campaign[]

  @@unique([locationId, nome], name: "um_modelo_de_campanha_por_nome")
  @@map("campaign_templates")
}

model Campaign {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  canal          CanalDeContacto
  segmentId      String  @map("segment_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  /// `RASCUNHO`, `A_ENVIAR` ou `TERMINADA`. Não há `ENVIADA`: o que foi enviado
  /// deriva-se dos envios, e uma campanha a meio é o estado que interessa.
  estado         String   @default("RASCUNHO")
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)
  criadaPor      String?  @map("criada_por")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  segmento     Segment            @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  modelo       CampaignTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  envios       CampaignDelivery[]

  @@unique([locationId, nome], name: "uma_campanha_por_nome")
  @@map("campaigns")
}

/// O envio. **Grava-se ANTES de despachar** — a mesma ordem da assinatura antes
/// do efeito no E23. Se a gravação for recusada pelo gatilho, não há nada
/// despachado, e um defeito na aplicação não consegue enviar.
model CampaignDelivery {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  campaignId     String @map("campaign_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  canal          CanalDeContacto
  /// `POR_ENVIAR` sempre, nesta etapa: não há provedor contratado. É pendência
  /// declarada, e não muda o que interessa provar — a recusa é na gravação.
  estado         String   @default("POR_ENVIAR")
  gravadoEm      DateTime @default(now()) @map("gravado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campanha     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cliente      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId], name: "um_envio_por_pessoa_e_campanha")
  @@map("campaign_deliveries")
}

model FeedbackEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid
  nota           Int
  comentario     String?
  origem         String?
  momento        DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  cliente      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("feedback_entries")
}

// ── E28 · Equipa, escalas e ponto ──────────────────────────────────────────
//
// Contrato: `docs/architecture/ponto-e-escalas.md`.
//
// Esta etapa mexe no salário de quem trabalha na casa. A marcação é um FACTO:
// `time_entries` é imutável por gatilho, como os movimentos de caixa do E22, e
// a correcção é um registo NOVO que aponta ao que corrige.

enum TipoDeMarcacao {
  ENTRADA
  SAIDA
}

/// A função que alguém faz na casa — cozinha, sala, barra. É de ESCALA, e não
/// de permissão: quem pode o quê continua a ser o `RoleAssignment` do E04.
model TeamRole {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  cor            String?
  arquivadaEm    DateTime? @map("arquivada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  turnos       Shift[]

  @@unique([locationId, nome], name: "uma_funcao_por_nome")
  @@map("team_roles")
}

/// O turno PREVISTO. Não é o ponto real — são dois números, como o encomendado
/// e o recebido no E26.
model Shift {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  roleId         String? @map("role_id") @db.Uuid
  /// O DIA DE SERVIÇO, e não a data civil. Um turno que atravessa a meia-noite
  /// pertence ao dia em que começou.
  diaDeServico   DateTime @map("dia_de_servico") @db.Date
  /// Minutos desde a meia-noite do dia de serviço, na hora da casa. As 18h são
  /// `1080`; as 00h30 do dia seguinte são `1470`. Inteiros, sempre.
  inicioMinutos  Int @map("inicio_minutos")
  fimMinutos     Int @map("fim_minutos")
  nota           String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  membro       Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  funcao       TeamRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([locationId, diaDeServico])
  @@map("shifts")
}

/// A MARCAÇÃO. Imutável — a correcção é um registo novo.
model TimeEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// De quem é a jornada.
  membershipId   String @map("membership_id") @db.Uuid
  tipo           TipoDeMarcacao
  /// O instante, em UTC. A conversão para hora da casa é apresentação.
  momento        DateTime @db.Timestamptz(6)
  /// ── Resolvido na FRONTEIRA, e gravado ─────────────────────────────────
  ///
  /// A data civil, no fuso da unidade, do instante menos o corte do serviço.
  /// Nunca se recalcula na leitura a partir de um instante lido como hora de
  /// parede — que foi exactamente o defeito do fuso.
  diaDeServico   DateTime @map("dia_de_servico") @db.Date
  /// ── Quem REGISTOU, que pode não ser de quem é a jornada ───────────────
  ///
  /// Uma autocorrecção é `autor = membro`. Não se proíbe; distingue-se.
  autorMembershipId String @map("autor_membership_id") @db.Uuid
  /// A marcação que esta corrige. `null` é uma marcação original.
  corrigeId      String? @unique @map("corrige_id") @db.Uuid
  /// Obrigatório quando corrige. Uma correcção sem razão não se explica a
  /// ninguém — e é a quem foi corrigido que ela tem de ser explicada.
  motivo         String?
  origem         String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  membro       Membership   @relation("jornadaDoMembro", fields: [membershipId], references: [id], onDelete: Cascade)
  autor        Membership   @relation("autorDaMarcacao", fields: [autorMembershipId], references: [id], onDelete: Restrict)
  corrige      TimeEntry?   @relation("correccaoDeMarcacao", fields: [corrigeId], references: [id], onDelete: Restrict)
  correccao    TimeEntry?   @relation("correccaoDeMarcacao")

  @@index([membershipId, diaDeServico])
  @@index([locationId, diaDeServico])
  @@map("time_entries")
}

// ── E29 · Financeiro e conciliação ─────────────────────────────────────────
//
// Contrato: `docs/architecture/conciliacao-e-fecho.md`, escrito por FRONTEIRA.
//
// Um sistema financeiro errado dá números CERTOS: não parte, não estoira, soma
// bem uma realidade que não existe. Por isso todas as garantias desta etapa
// vivem na base, e nenhuma delas é uma coluna que alguém escreve.

enum EstadoDaCorrespondencia {
  SUGERIDA
  CONFIRMADA
  RECUSADA
}

enum TipoDeMovimentoFinanceiro {
  RECEITA
  DESPESA
  DEVOLUCAO
  TAXA
  AJUSTE
}

model BankAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  nome           String
  moeda          String @default("EUR")
  arquivadaEm    DateTime? @map("arquivada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  linhas       BankLine[]
  importacoes  StatementImport[]

  @@unique([locationId, nome], name: "uma_conta_por_nome")
  @@map("bank_accounts")
}

/// Uma importação de extracto. **Guarda as contagens**, porque uma importação
/// que ignora 200 linhas em silêncio é indistinguível de uma que não leu o
/// ficheiro — e as duas mostram o mesmo zero.
model StatementImport {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  ficheiro       String
  novas          Int @default(0)
  jaVistas       Int @default(0) @map("ja_vistas")
  importadoPor   String? @map("importado_por")
  importadoEm    DateTime @default(now()) @map("importado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linhas       BankLine[]

  @@map("statement_imports")
}

/// Uma linha de extracto.
///
/// ── A identidade NÃO vem do banco ─────────────────────────────────────────
///
/// Bancos repetem referências, mudam formatos e reemitem extractos. A
/// identidade é derivada — conta, data-valor, montante, referência e a **ordem
/// dentro do dia** — e a ordem existe porque **duas linhas iguais no mesmo dia
/// são um caso real**, não um erro. Sem ela, um detector de duplicados apaga
/// factos verdadeiros.
///
/// A garantia é o índice único sobre esses cinco, na BASE. Não é uma coisa que
/// o código se tem de lembrar de verificar.
model BankLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  importId       String? @map("import_id") @db.Uuid
  dataValor      DateTime @map("data_valor") @db.Date
  montanteMenor  BigInt   @map("montante_menor")
  moeda          String   @default("EUR")
  referencia     String?
  /// A ordem desta linha dentro do dia, no ficheiro. É o que distingue duas
  /// linhas legítimas iguais — e o que impede o duplicado de passar.
  ordemNoDia     Int      @map("ordem_no_dia")
  descricao      String?
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conta        BankAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importacao   StatementImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  correspondencias Reconciliation[]

  @@index([accountId, dataValor])
  @@map("bank_lines")
}

/// O movimento na visão financeira, com as TRÊS datas.
///
/// Não são intermutáveis: caixa usa a **data-valor**, resultado usa a
/// **ocorrência**. «Quanto entrou em Setembro» e «quanto vendi em Setembro» são
/// perguntas diferentes com respostas diferentes, e as duas estão certas.
model FinancialMovement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  tipo           TipoDeMovimentoFinanceiro
  conceito       String
  montanteMenor  BigInt @map("montante_menor")
  moeda          String @default("EUR")
  /// Quando a coisa aconteceu — a venda, o serviço.
  ocorrenciaEm   DateTime @map("ocorrencia_em") @db.Date
  /// Quando o dinheiro se mexeu — a liquidação no banco.
  valorEm        DateTime @map("valor_em") @db.Date
  /// Quando ficou escrito no sistema. Carimbo do servidor, sempre.
  registoEm      DateTime @default(now()) @map("registo_em") @db.Timestamptz(6)
  /// A transacção de origem, para o total descer até ela. Um total que não
  /// desce à origem é uma opinião.
  origemTipo     String?  @map("origem_tipo")
  origemId       String?  @map("origem_id") @db.Uuid
  centroDeCusto  String?  @map("centro_de_custo")
  /// Um ajuste pós-fecho aponta ao período fechado que corrige. O passado não
  /// se reescreve: acrescenta-se-lhe.
  ajustaPeriodoId String? @map("ajusta_periodo_id") @db.Uuid
  motivo         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ajustaPeriodo AccountingPeriod? @relation(fields: [ajustaPeriodoId], references: [id], onDelete: SetNull)
  correspondencias Reconciliation[]

  @@index([locationId, valorEm])
  @@index([locationId, ocorrenciaEm])
  @@map("financial_movements")
}

/// A correspondência entre uma linha de banco e um movimento.
///
/// **Nunca automática, nem com semelhança perfeita.** A confirmação é um
/// acontecimento com autor e momento — quem concilia responde pelo que
/// conciliou, e daqui a um ano alguém vai perguntar quem foi.
///
/// E **não há coluna `conciliado`**: existe correspondência confirmada, logo
/// está conciliado. Terceira vez que esta lei aparece — stock, pontos, e agora.
model Reconciliation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  bankLineId     String @map("bank_line_id") @db.Uuid
  movementId     String @map("movement_id") @db.Uuid
  estado         EstadoDaCorrespondencia @default(SUGERIDA)
  /// Zero a 100. É uma sugestão, e 100 continua a ser sugestão.
  semelhanca     Int @default(0)
  confirmadaPor  String?   @map("confirmada_por")
  confirmadaEm   DateTime? @map("confirmada_em") @db.Timestamptz(6)
  criadaEm       DateTime  @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linha        BankLine          @relation(fields: [bankLineId], references: [id], onDelete: Cascade)
  movimento    FinancialMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([bankLineId, movementId], name: "uma_correspondencia_por_par")
  @@map("reconciliations")
}

/// Um período contabilístico. **Fechar proíbe, não congela.**
///
/// Não guarda totais: se guardasse, passavam a ser uma segunda verdade que
/// envelhece — a mesma lei do número derivado, outra vez.
model AccountingPeriod {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  de             DateTime @db.Date
  ate            DateTime @db.Date
  /// `ABERTO` ou `FECHADO`. O estado deriva do último acontecimento, mas
  /// guarda-se aqui porque é o gatilho da base que o lê a cada inserção.
  estado         String @default("ABERTO")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  acontecimentos PeriodEvent[]
  ajustes      FinancialMovement[]

  @@unique([locationId, de], name: "um_periodo_por_inicio")
  @@map("accounting_periods")
}

/// Fechar e reabrir são ACONTECIMENTOS, com autor e motivo. Nunca um interruptor.
model PeriodEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  periodId       String @map("period_id") @db.Uuid
  /// `FECHO` ou `REABERTURA`.
  tipo           String
  autor          String
  motivo         String?
  momento        DateTime @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodo      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("period_events")
}

/// A taxa de câmbio usada num total convertido, com FONTE e DATA.
///
/// Um número em euros que veio de dólares sem dizer a que câmbio é uma opinião
/// com aspecto de facto.
model ExchangeRate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  de             String
  para           String
  /// Milionésimos: 1 USD = 0,92 EUR é `920000`. Inteiro, como tudo o resto.
  taxaMicro      BigInt @map("taxa_micro")
  fonte          String
  emVigorDe      DateTime @map("em_vigor_de") @db.Date

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, de, para, emVigorDe], name: "uma_taxa_por_dia")
  @@map("exchange_rates")
}

// ═══════════════════════════════════════════════════════════════════════════
// E31 · Kiosk, terminais e impressão
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoDaSessaoDeKiosk {
  ABERTA
  /// Os TRÊS caminhos de saída. **As três limpam o mesmo** — o motivo
  /// distingue-as, o efeito não pode. Um caminho que limpa menos do que os
  /// outros é o que deixa o carrinho do cliente anterior no ecrã do seguinte.
  CONCLUIDA
  ABANDONADA
  REINICIADA
}

enum LigacaoDeImpressora {
  REDE
  USB
  PONTE
}

enum TipoDeDocumentoImpresso {
  COMANDA
  CONTA
  RECIBO
  DOCUMENTO_FISCAL
}

/// **«Entregue à ponte» não é «imprimiu».**
///
/// Repare-se no que não está aqui: não há `IMPRESSO`. Há resposta do aparelho
/// ou não há — e «não sei» **deriva** do tempo sem resposta, nunca se escreve.
/// Se estivesse nesta lista, alguém acabava por o escrever à mão e ele passava
/// a querer dizer «alguém achou» em vez de «ninguém respondeu».
enum EstadoDeEnvioDeImpressao {
  POR_ENVIAR
  ENTREGUE_A_PONTE
  CONFIRMADO_PELO_APARELHO
  RECUSADO_PELO_APARELHO
}

/// A impressora de serviço (DEV-005).
model Printer {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  nome           String
  destino        Estacao
  modelo         String
  ligacao        LigacaoDeImpressora
  endereco       String?
  activa         Boolean             @default(true)

  /// ── Nulo quer dizer POR TESTAR, e nunca aprovado ────────────────────────
  ///
  /// Não há booleano `homologada` de propósito: um booleano tem duas respostas
  /// e aqui há três — sim, não, e **não medi**. A ausência de data é a
  /// terceira, e é a única que se pode afirmar sem aparelho a sério.
  homologadaEm     DateTime? @map("homologada_em") @db.Timestamptz(6)
  homologadaPor    String?   @map("homologada_por")
  homologacaoNotas String?   @map("homologacao_notas")

  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  envios       PrintJob[]

  @@unique([locationId, nome], name: "uma_impressora_por_nome")
  @@index([organizationId, locationId, destino])
  @@map("printers")
}

/// A sessão de um cliente no kiosk (KIOSK-001..007).
///
/// **Repare-se no que esta tabela não tem:** nome, email, telefone, nada da
/// pessoa. Não é disciplina de quem escreve o código — é AUSÊNCIA. Uma coluna
/// que não existe não fica com os dados do cliente anterior, e nenhum botão de
/// limpar precisa de se lembrar dela.
model KioskSession {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  locationId     String                @map("location_id") @db.Uuid
  deviceId       String                @map("device_id") @db.Uuid
  idioma         String
  estado         EstadoDaSessaoDeKiosk @default(ABERTA)

  /// `@unique` e não um índice comum: **duas sessões não podem partilhar o
  /// mesmo carrinho nem a mesma conta**. É a segunda metade do «dois clientes
  /// seguidos não partilham nada» — a primeira é a sessão aberta única por
  /// aparelho, esta impede que a sessão nova aponte para o pedido da anterior.
  orderId String? @unique @map("order_id") @db.Uuid
  billId  String? @unique @map("bill_id") @db.Uuid

  abertaEm        DateTime  @default(now()) @map("aberta_em") @db.Timestamptz(6)
  terminadaEm     DateTime? @map("terminada_em") @db.Timestamptz(6)
  terminadaMotivo String?   @map("terminada_motivo")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dispositivo  Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pedido       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conta        Bill?        @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([organizationId, locationId, estado])
  @@map("kiosk_sessions")
}

/// A ligação entre um pedido e a pessoa — a **referência**, e não a cópia.
///
/// O `orders` continua sem saber quem é a pessoa. Apagar a pessoa leva esta
/// linha e deixa o pedido de pé, porque nunca foram a mesma coisa. Se isto
/// fosse uma coluna em `orders`, apagar a pessoa ou apagava o pedido ou era
/// recusado — e as duas são a falha que o aceite descreve.
model OrderContact {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  orderId        String               @unique @map("order_id") @db.Uuid
  customerId     String               @map("customer_id") @db.Uuid
  finalidade     FinalidadeDeContacto
  expiraEm       DateTime             @map("expira_em") @db.Timestamptz(6)
  criadoEm       DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pedido       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pessoa       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("order_contacts")
}

/// Um envio para a impressora (KDS-016, DEV-006). Fila idempotente.
model PrintJob {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  locationId     String                  @map("location_id") @db.Uuid
  printerId      String                  @map("printer_id") @db.Uuid
  tipo           TipoDeDocumentoImpresso
  documentoId    String                  @map("documento_id") @db.Uuid

  /// 1 é o original. 2 em diante é reimpressão, e o número vai **no papel**.
  via Int @default(1)

  /// Derivada por gatilho. Está guardada porque é sobre ela que a restrição
  /// única trabalha, mas ninguém a escolhe.
  identidade String

  estado EstadoDeEnvioDeImpressao @default(POR_ENVIAR)

  /// O que foi enviado, tal como foi enviado. Sem isto, a pergunta «o que é que
  /// a cozinha viu?» não tem resposta depois do facto.
  conteudo String

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  entregueEm   DateTime? @map("entregue_em") @db.Timestamptz(6)
  respondidoEm DateTime? @map("respondido_em") @db.Timestamptz(6)
  /// O que o **aparelho** disse. Não o que o software achou.
  resposta     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  impressora   Printer      @relation(fields: [printerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, identidade], name: "um_envio_por_identidade")
  @@index([organizationId, locationId, estado])
  @@map("print_jobs")
}

// ═══════════════════════════════════════════════════════════════════════════
// E32 · Integrações, API e cobrança do SaaS
// ═══════════════════════════════════════════════════════════════════════════

enum EscopoDeApi {
  CATALOGO_LER
  CATALOGO_ESCREVER
  PEDIDOS_LER
  PEDIDOS_ESCREVER
  RELATORIOS_LER
}

enum EstadoDaEntrega {
  POR_ENVIAR
  ENTREGUE
  FALHOU
  DESISTIU
}

/// O estado de um evento de cobrança do SaaS.
///
/// `SEM_VINCULO` é o que decide a etapa: chegou, a assinatura confere, e **não
/// há ligação nossa** para este cliente do provedor. Não é erro de ninguém — é
/// a resposta certa a um evento que ninguém pediu. Fica parado e não muda nada.
enum EstadoDoEventoDeCobranca {
  RECEBIDO
  SEM_VINCULO
  APLICADO
  RECUSADO
}

enum EstadoDaIntegracao {
  DESLIGADA
  CONFIGURADA
  ACTIVA
  ERRO
}

/// Uma chave de API (INT-008).
///
/// **Repare-se no que este modelo não tem: a chave.** Guarda-se o resumo, e o
/// resumo não abre nada. Um ecrã que consiga mostrar outra vez uma chave antiga
/// prova que ela está guardada em claro — e aqui não há onde a guardar.
model ApiKey {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  nome           String
  /// Os primeiros caracteres, para a pessoa reconhecer a chave sem a ver.
  prefixo        String
  resumo         String        @unique
  escopos        EscopoDeApi[]
  /// **Obrigatório.** Uma chave sem prazo é uma chave para sempre, incluindo
  /// depois de a pessoa que a criou sair da empresa.
  expiraEm       DateTime      @map("expira_em") @db.Timestamptz(6)
  revogadaEm     DateTime?     @map("revogada_em") @db.Timestamptz(6)
  revogadaPor    String?       @map("revogada_por")
  criadaPor      String        @map("criada_por")
  criadaEm       DateTime      @default(now()) @map("criada_em") @db.Timestamptz(6)
  ultimoUsoEm    DateTime?     @map("ultimo_uso_em") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registos     IntegrationLog[]

  @@index([organizationId, revogadaEm])
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  url            String
  segredoResumo  String   @map("segredo_resumo")
  eventos        String[]
  activo         Boolean  @default(true)
  criadoPor      String   @map("criado_por")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entregas     WebhookDelivery[]

  @@index([organizationId, activo])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  endpointId     String          @map("endpoint_id") @db.Uuid
  evento         String
  /// A versão viaja com a entrega: um consumidor que receba um corpo novo sem
  /// saber que o formato mudou parte em silêncio.
  versao         Int             @default(1)
  /// O identificador que o consumidor usa para descartar repetições.
  entregaId      String          @default(uuid()) @map("entrega_id") @db.Uuid
  corpo          String
  assinatura     String
  estado         EstadoDaEntrega @default(POR_ENVIAR)
  tentativas     Int             @default(0)
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  entregueEm     DateTime?       @map("entregue_em") @db.Timestamptz(6)
  respostaEstado Int?            @map("resposta_estado")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entregaId], name: "uma_entrega_por_identificador")
  @@index([organizationId, estado])
  @@map("webhook_deliveries")
}

/// A LIGAÇÃO entre um cliente do provedor e uma organização.
///
/// **É esta tabela que autoriza.** O corpo do webhook não autoriza nada: no
/// máximo sugere, e a sugestão confirma-se contra o que já sabemos. Foi criada
/// por alguém autenticado, do nosso lado.
model SaasCustomer {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  provedor          String
  provedorClienteId String   @map("provedor_cliente_id")
  criadoPor         String   @map("criado_por")
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorClienteId], name: "um_cliente_por_provedor")
  @@unique([organizationId, provedor], name: "uma_ligacao_por_organizacao")
  @@map("saas_customers")
}

/// O evento de cobrança, como chegou.
///
/// ── Repare-se no que este modelo NÃO tem ──────────────────────────────────
///
/// Não tem `organizationId` que o webhook possa preencher. Tem
/// `organizationIdAlegado` — o que o corpo *disse*, guardado para se poder
/// comparar e denunciar — e `organizationIdResolvido`, que **só a função
/// privilegiada escreve**, e sempre a partir da `saas_customers`.
model SaasBillingEvent {
  id                      String                   @id @default(uuid()) @db.Uuid
  provedor                String
  provedorEventoId        String                   @map("provedor_evento_id")
  tipo                    String
  /// O cliente VERIFICADO no provedor. É por aqui, e só por aqui, que se resolve.
  provedorClienteId       String                   @map("provedor_cliente_id")
  /// O plano vem do corpo, e isso está certo: a assinatura autentica a ORIGEM.
  /// O que ela não faz é autorizar o ALVO.
  planoCodigo             String?                  @map("plano_codigo")
  organizationIdAlegado   String?                  @map("organization_id_alegado") @db.Uuid
  organizationIdResolvido String?                  @map("organization_id_resolvido") @db.Uuid
  corpoCru                String                   @map("corpo_cru")
  assinaturaConfere       Boolean                  @map("assinatura_confere")
  estado                  EstadoDoEventoDeCobranca @default(RECEBIDO)
  motivo                  String?
  recebidoEm              DateTime                 @default(now()) @map("recebido_em") @db.Timestamptz(6)
  resolvidoEm             DateTime?                @map("resolvido_em") @db.Timestamptz(6)

  organizacaoResolvida Organization? @relation(fields: [organizationIdResolvido], references: [id], onDelete: SetNull)

  @@unique([provedor, provedorEventoId], name: "um_evento_por_identidade_do_provedor")
  @@index([estado, recebidoEm])
  @@map("saas_billing_events")
}

/// A assinatura que o RESTAURANTE nos paga (ORG-011).
///
/// Não há chave estrangeira nenhuma entre esta família e a do E22 — o jantar do
/// cliente —, e é de propósito. **São duas contabilidades e não se tocam.**
model SaasInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  provedor          String
  provedorFacturaId String    @map("provedor_factura_id")
  numero            String
  montanteMenor     Int       @map("montante_menor")
  moeda             String    @db.Char(3)
  estado            String
  emitidaEm         DateTime  @map("emitida_em") @db.Timestamptz(6)
  pagaEm            DateTime? @map("paga_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provedor, provedorFacturaId], name: "uma_factura_por_provedor")
  @@index([organizationId, emitidaEm])
  @@map("saas_invoices")
}

model Integration {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  familia        String
  provedor       String
  estado         EstadoDaIntegracao @default(DESLIGADA)
  /// O que falta para ela funcionar, em palavras. `DESLIGADA` sem requisitos é
  /// um beco: quem lê não sabe o que fazer a seguir.
  requisitos     String?
  ultimoErro     String?            @map("ultimo_erro")
  actualizadaEm  DateTime           @default(now()) @map("actualizada_em") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registos     IntegrationLog[]

  @@unique([organizationId, familia, provedor], name: "uma_integracao_por_provedor")
  @@map("integrations")
}

/// O que aconteceu numa integração (INT-010). **Sem segredos.**
model IntegrationLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  integrationId  String?  @map("integration_id") @db.Uuid
  /// QUEM chamou. A chave identifica-se pelo id, **nunca pelo valor**.
  apiKeyId       String?  @map("api_key_id") @db.Uuid
  accao          String
  resultado      String
  detalhe        Json     @default("{}")
  ocorridoEm     DateTime @default(now()) @map("ocorrido_em") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integracao   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  chave        ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, ocorridoEm(sort: Desc)])
  @@map("integration_logs")
}
