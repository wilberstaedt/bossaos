// BossaOS — schema base (E01).
//
// Nesta etapa o schema é DELIBERADAMENTE mínimo. O E01 é a base executável: o
// modelo de dados do produto entra nas etapas que o desenham (multi-tenant,
// catálogo, reservas), e inventá-lo aqui seria decidir sem o contrato à frente.
//
// O que existe aqui existe por uma razão verificável: `AppMeta` é a tabela que a
// sonda de prontidão lê. Sem ela, "a base responde" prova apenas que o Postgres
// está de pé — não prova que ESTE schema foi migrado. São perguntas diferentes,
// e a segunda é a que interessa depois de um deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Em Prisma 7 a URL SAI do schema: as migrações lêem-na de `prisma.config.ts`
  // e o runtime recebe a dele por adaptador, no construtor do cliente. Para nós
  // isto é bom notícia e não obstáculo — a separação entre a credencial que
  // altera schema e a que só o usa (E01, aceite 2) deixa de depender de
  // disciplina e passa a estar em dois sítios diferentes do código.
}

/// Chave/valor de metadados da aplicação. Escrita pela migração, lida pela
/// sonda de prontidão. Não é domínio: é o sinal de que o schema chegou.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ═══════════════════════════════════════════════════════════════════════════
// E03 — núcleo multi-inquilino
//
// Três camadas de isolamento, e nenhuma substitui as outras (domain-model.md):
//   1. a credencial     — o runtime não é dono das tabelas, não é superuser,
//                         não tem BYPASSRLS. Provado em E01.
//   2. a política       — RLS com USING **e** WITH CHECK, em migração SQL à mão
//                         (o Prisma não gere políticas).
//   3. o escopo         — marca, unidade, estação e acção são filtro de serviço.
//                         O RLS protege a ORGANIZAÇÃO e mais nada.
//
// As referências são COMPOSTAS. Uma FK simples de `location_id` deixaria apontar
// para a unidade de outra organização com o `organization_id` da linha a parecer
// certo. `@@unique([organizationId, id])` no alvo é o que torna isso impossível
// na base, e não no formulário.
// ═══════════════════════════════════════════════════════════════════════════

/// Fronteira do inquilino. O `id` desta linha é o `organization_id` de tudo o resto.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  /// Namespace público. Único globalmente: é o que aparece num endereço.
  slug      String   @unique
  /// Nome comercial. É o que aparece na interface.
  nome      String

  // ── E06: perfil. TODOS opcionais, e isso é a decisão da etapa ─────────────
  //
  // Nenhum destes campos tem `@default`. Um `pais @default("ES")` porque a
  // primeira fixture é espanhola, ou um `moedaPadrao @default("EUR")` porque
  // parecia razoável, é exactamente o defeito que este modelo existe para
  // impedir: **desconhecido é uma resposta**, e o ecrã tem de a poder mostrar.
  //
  // Opcional não quer dizer sem consequência: quem publica, cobra ou abre
  // precisa deles, e recusa sem eles. O que não se faz é preenchê-los sozinho.

  /// Nome legal, o da factura. Pode não estar à mão no primeiro dia.
  nomeLegal String? @map("nome_legal")
  /// ISO 3166-1 alpha-2. Sem omissão: o país da organização não se adivinha.
  pais      String? @db.Char(2)
  /// Fuso IANA da SEDE. O que conta para abrir portas é o da unidade.
  fuso      String?
  /// ISO 4217. É uma sugestão para novas unidades, nunca um valor herdado em
  /// silêncio: a unidade tem a sua, e pode ser outra.
  moedaPadrao String? @map("moeda_padrao") @db.Char(3)
  /// Quem responde por esta organização. Texto, não FK: pode ser alguém que
  /// ainda não tem conta.
  responsavel String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  brands          Brand[]
  locations       Location[]
  memberships     Membership[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  auditEvents     AuditEvent[]
  subscription    Subscription?
  entitlements    EntitlementGrant[]
  featureFlags    FeatureFlag[]
  themeRevisions  ThemeRevision[]
  onboarding      OnboardingProgress?
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]
  scheduleIntervals  ScheduleInterval[]

  @@map("organizations")
}

/// Marca: catálogo e identidade comercial. Pertence a uma organização.
model Brand {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  nome           String
  slug           String
  /// E06: identidade textual inicial (ONB-002). Opcionais pela mesma razão.
  descricao      String?
  /// Idioma principal da marca, um dos três que o E02 suporta. Sem omissão:
  /// escolher espanhol por a primeira fixture o ser publicaria a carta de um
  /// restaurante brasileiro em espanhol.
  idiomaPrincipal String? @map("idioma_principal")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations       Location[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]

  /// Alvo das referências compostas. Sem isto, o resto não se pode escrever.
  @@unique([organizationId, id], name: "brand_por_organizacao")
  /// Slug único DENTRO da marca-mãe, não globalmente: dois restaurantes
  /// diferentes podem chamar-se "marina" sem colidir.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

/// Unidade: serviço, mesas, dispositivos, moeda operacional e stock.
model Location {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  nome           String
  slug           String
  // ── E06: de obrigatórios a opcionais, e é uma decisão, não um relaxamento ─
  //
  // Estavam `NOT NULL`. Parece a escolha segura e é o contrário: com eles
  // obrigatórios, quem cria uma unidade é FORÇADO a passar um valor, e o valor
  // que se passa quando não se sabe é o da última unidade, ou o do servidor, ou
  // AUD porque o produto nasceu na Austrália. Uma unidade sem moeda não é AUD.
  //
  // Opcionais, "por configurar" passa a ser representável — e as operações que
  // precisam deles recusam explicitamente, em vez de operarem sobre um palpite.
  /// Moeda operacional, ISO 4217. O dinheiro guarda-se em unidade mínima.
  moeda          String? @db.Char(3)
  /// Fuso IANA. Sem ele não há pergunta a fazer sobre horários: "são 14:00" não
  /// quer dizer nada sem saber onde.
  fuso           String?
  /// E06: morada e contacto (ONB-003, ORG-005). "Pendiente de confirmar" é um
  /// estado que o atlas desenha, e é `null` — não uma cadeia vazia.
  morada         String?
  localidade     String?
  contactoEmail  String? @map("contacto_email")
  contactoTelefone String? @map("contacto_telefone")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// COMPOSTA: a marca tem de ser da mesma organização. É a base que recusa.
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)

  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  entitlements    EntitlementGrant[]
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]

  @@unique([organizationId, id], name: "location_por_organizacao")
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("locations")
}

/// Identidade GLOBAL. Excepção documentada (CT-04): não leva `organization_id`,
/// porque a mesma pessoa trabalha em mais do que uma organização.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  nome      String
  /// E04: a biblioteca de autenticação escreve isto. O campo dela chama-se
  /// `name` e aponta para `nome` por configuração — a identidade continua a ser
  /// UMA tabela, e não duas a fingir que são a mesma pessoa.
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?
  /// MFA. Em TODOS os planos, não num escalão acima: a segurança da conta de
  /// quem trabalha no restaurante não é uma capacidade que se venda.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  convitesFeitos Invitation[] @relation("convidadoPor")
  plataforma     PlatformStaff?

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// E04 — sessão e credenciais.
//
// Estas três tabelas pertencem ao caminho de AUTENTICAÇÃO e o papel de runtime
// não tem privilégio nenhum sobre elas. Não é zelo: uma sessão é uma credencial
// viva, e o processo que serve o catálogo de um restaurante não precisa de
// conseguir ler a sessão de ninguém — nem a própria.
//
// A forma dos campos é a que a biblioteca espera. Confirmada contra a definição
// dela em `@better-auth/core/dist/db/get-tables.mjs`, e depois **verificada a
// correr**: um registo e um início de sessão a sério contra esta base.
// ═══════════════════════════════════════════════════════════════════════════

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @default("credential")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Guardada pela biblioteca, com o algoritmo dela. Nunca por nós: o E04 é
  /// explícito em não construir criptografia nem armazenamento de senha próprios.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Segundo factor. `secret` e `backupCodes` são guardados e cifrados pela
/// biblioteca — nós não lhes tocamos, e vivem nas tabelas que o runtime não vê.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

enum EstadoDeMembro {
  ACTIVO
  SUSPENSO
  REVOGADO

  @@map("estado_de_membro")
}

/// A ponte entre a identidade global e o inquilino.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  estado         EstadoDeMembro @default(ACTIVO)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int            @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]

  @@unique([organizationId, id], name: "membership_por_organizacao")
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Papéis do CT-04. O nome fica em maiúsculas porque é vocabulário do contrato.
enum Papel {
  OWNER
  ORG_ADMIN
  BRAND_MANAGER
  VENUE_MANAGER
  FLOOR_MANAGER
  HOST
  WAITER
  KITCHEN
  BARTENDER
  EXPO
  CASHIER
  FINANCE
  INVENTORY
  MARKETING
  EMPLOYEE

  @@map("papel")
}

/// Concessão de papel, com o seu escopo.
///
/// `brandId` e `locationId` são opcionais e é isso que define o alcance: uma
/// concessão de marca abrange as unidades dela; uma de unidade não amplia para o
/// resto da organização (CT-04). Nenhum dos dois preenchido = alcance da
/// organização inteira, e só os papéis de topo o devem ter.
model RoleAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  membershipId   String  @map("membership_id") @db.Uuid
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, membershipId])
  @@map("role_assignments")
}

/// Estado de um convite. Derivado, mas guardado: o histórico de quem foi
/// convidado e nunca aceitou é informação de gestão, não lixo.
enum EstadoDeConvite {
  PENDENTE
  ACEITE
  REVOGADO

  @@map("estado_de_convite")
}

/// Convite para uma organização.
///
/// **Um convite é uma credencial**, e é isso que explica cada campo:
///
///  - `tokenHash` e não `token`: o que viaja no email é o segredo; o que fica na
///    base é o resumo dele. Uma cópia de segurança lida por alguém não dá
///    acesso a nada, e nem nós conseguimos reemitir o link original.
///  - `papel`, `brandId`, `locationId` vivem AQUI. Na aceitação não se lê nada
///    disto do corpo do pedido — se se lesse, quem foi convidado como `WAITER`
///    aceitava-se como `OWNER`. É o defeito mais banal desta área.
///  - `email`: o convite é da pessoa convidada, não de quem receber o link.
///  - `expiresAt` vem de configuração, não de uma constante escolhida por quem
///    programa.
///  - `acceptedAt` faz o uso único: aceitar duas vezes não cria duas pertenças.
model Invitation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  email          String
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  /// SHA-256 do token. O token em claro só existe no email.
  tokenHash String @unique @map("token_hash")

  estado     EstadoDeConvite @default(PENDENTE)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?       @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(6)

  /// Quem convidou. A concessão não pode passar o escopo desta pessoa (CT-04),
  /// e sem o registo não há como auditar quem abriu a porta a quem.
  convidadoPorId String @map("convidado_por_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  convidadoPor User         @relation("convidadoPor", fields: [convidadoPorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invitations")
}

/// Rasto de acções sensíveis (E04, entrega 5).
///
/// Concessões, revogações e acesso assistido. Sem `actor` e `motivo` não é
/// auditoria — é um log. Append-only por gatilho na migração: uma auditoria que
/// se pode editar não serve para o que existe.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Quem fez. Sem FK para User de propósito: o rasto sobrevive ao apagamento.
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  accao          String
  alvoTipo       String?  @map("alvo_tipo")
  alvoId         String?  @map("alvo_id") @db.Uuid
  motivo         String?
  /// Detalhe estruturado. Nunca senhas, nunca tokens (CT-04).
  detalhe        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// E05 — planos, entitlements e flags
//
// Três catálogos, e a separação entre eles é do contrato, não estética:
//
//   PlanDefinition   o que se VENDE. Global, não pertence a inquilino nenhum.
//   EntitlementGrant o que uma organização TEM. De inquilino, com política.
//   FeatureFlag      o que está CONSTRUÍDO e libertado. Global ou por org.
//
// Misturar capacidades com flags faz um "ainda não existe" ler-se como "compra
// o plano acima", e o dono do restaurante paga por algo que não está feito.
//
// **Nenhum número comercial vive aqui.** Preços, mensalidades e limites são
// configuração, decididos pelo Matheus. O que o código traz é a estrutura — a
// quota, a leitura, a recusa e a mensagem. Escrever `MAX_PRODUTOS = 500` porque
// parecia razoável é como o número acaba em três sítios e nenhum é o certo.
// ═══════════════════════════════════════════════════════════════════════════

/// Um plano vendável. **Global**: o catálogo é o mesmo para todos.
///
/// Sem preço. O atlas (ORG-010) diz "Precio según propuesta" e é isso que fica:
/// o preço é uma proposta comercial, não uma constante do produto.
model PlanDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  /// STARTER, RESTAURANT, PRO. Estável: é o que as concessões referenciam.
  codigo    String   @unique
  nome      String
  /// A frase do atlas: "Publica bien", "Conecta el servicio", "Amplía tu gestión".
  promessa  String
  ordem     Int
  /// Aparece no selector de planos? Um plano de piloto pode não aparecer.
  publico   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  capacidades   PlanCapability[]
  subscriptions Subscription[]
  /// As subscrições que têm uma descida agendada PARA este plano. Sem esta
  /// relação a coluna existia e não se podia ler o destino pelo nome — o
  /// `estadoComercial` devolvia `descerParaPlano: null` fixo e o ecrã de mudar
  /// de plano dizia "nenhuma mudança agendada" a quem tinha uma.
  descidasAgendadas Subscription[] @relation("DescerPara")

  @@map("plan_definitions")
}

/// O que um plano inclui.
///
/// `quota` nula numa capacidade quantitativa significa **por configurar**, e o
/// motor nega. Não é ilimitado — nunca. É o CT-02 na direcção certa.
model PlanCapability {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  /// Chave do catálogo em `packages/domain/src/capacidades.ts`.
  capacidade String
  quota      Int?

  plan PlanDefinition @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, capacidade])
  @@map("plan_capabilities")
}

enum EstadoDeSubscricao {
  ACTIVA
  SUSPENSA
  CANCELADA

  @@map("estado_de_subscricao")
}

/// A assinatura de uma organização. Assenta na `Organization` do E03.
model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  estado         EstadoDeSubscricao @default(ACTIVA)
  validoDe       DateTime           @default(now()) @map("valido_de") @db.Timestamptz(6)
  validoAte      DateTime?          @map("valido_ate") @db.Timestamptz(6)

  /// Descida agendada. Guardar o plano de destino e a data **antes** de
  /// efectivar é o que permite mostrar a prévia e avisar com antecedência —
  /// e o que permite não efectivar enquanto houver caixa aberta.
  descerParaPlanoId String?   @map("descer_para_plano_id") @db.Uuid
  descerEm          DateTime? @map("descer_em") @db.Timestamptz(6)

  /// Tolerância por incumprimento: política configurável, não uma data
  /// escolhida por quem programa.
  toleranciaAte DateTime? @map("tolerancia_ate") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  descerParaPlano PlanDefinition? @relation("DescerPara", fields: [descerParaPlanoId], references: [id], onDelete: Restrict)
  plan         PlanDefinition @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

enum OrigemDeConcessao {
  /// Vem do plano contratado.
  PLANO
  /// Add-on comprado à parte. Não liberta os módulos operacionais todos.
  ADICIONAL
  /// Piloto provisionado por nós, auditado. Nunca simula cobrança.
  PILOTO

  @@map("origem_de_concessao")
}

/// O que uma organização TEM. **A ausência de uma linha significa negado.**
model EntitlementGrant {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  capacidade     String
  /// Nula numa quantitativa = por configurar = NEGADO. Ver `capacidades.ts`.
  quota          Int?
  /// Presente = a concessão só vale nesta unidade, e não amplia para o resto.
  locationId     String?           @map("location_id") @db.Uuid
  validoAte      DateTime?         @map("valido_ate") @db.Timestamptz(6)
  origem         OrigemDeConcessao @default(PLANO)
  /// Por que existe esta concessão. Obrigatório em PILOTO e ADICIONAL: uma
  /// concessão sem motivo é impossível de auditar seis meses depois.
  motivo         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, capacidade, locationId])
  @@index([organizationId])
  @@map("entitlement_grants")
}

/// Flag de lançamento. **Catálogo separado do de capacidades.**
///
/// Uma flag responde a "está construído e libertado?". Sem `organizationId` é
/// global; com ele é uma libertação controlada a um inquilino — que é como se
/// põe um módulo novo em produção com um cliente antes de todos.
model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String
  ligada         Boolean  @default(false)
  descricao      String?
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([nome, organizationId])
  @@index([nome])
  @@map("feature_flags")
}

/// Tema público de um restaurante.
///
/// O plano Starter usa a paleta BossaOS e **não a pode editar** — pode mudar
/// nome, logo, fotos e conteúdo. Restaurant e Pro escolhem cores próprias, e
/// têm o mesmo direito: o editor completo é do E12.
///
/// Guardar o tema ANTERIOR é o que permite uma descida de plano reverter ao
/// padrão sem perder o que o cliente escolheu — se ele voltar a subir, está lá.
model ThemeRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Os três únicos tokens temáveis (E02, `TOKENS_TEMAVEIS`).
  primaria       String
  acento         String
  fundo          String
  /// Verdadeiro quando é a paleta BossaOS por omissão, não uma escolha.
  padrao         Boolean  @default(false)
  /// Activa agora? Só uma por organização.
  activa         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, activa])
  @@map("theme_revisions")
}

/// Quem é da plataforma BossaOS.
///
/// Escrita **só pela credencial de migração**, como o catálogo de planos e pela
/// mesma razão: uma tabela de "quem tem acesso interno" que o processo do
/// restaurante pode escrever é um restaurante a dar-se acesso interno. O runtime
/// nem sequer tem SELECT — lê-a apenas através das funções `plataforma_*`, que a
/// consultam por ele e verificam elas próprias quem chama.
model PlatformStaff {
  userId    String   @id @map("user_id") @db.Uuid
  /// Porquê. Um acesso interno sem motivo escrito é um acesso que ninguém
  /// consegue rever daqui a seis meses.
  motivo    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff")
}

// ═══════════════════════════════════════════════════════════════════════════
// E06 — horários, onboarding e idempotência.

/// Um dia da semana CONFIGURADO, para uma unidade.
///
/// **A ausência de linha é o terceiro estado.** Um dia sem linha está por
/// configurar; um dia com linha e `fechado = true` está fechado porque alguém o
/// disse. As duas coisas leem-se igual num modelo que só tenha intervalos, e é
/// essa a diferença que faz um site anunciar que abre às nove.
model ScheduleDay {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// ISO 8601: 1 = segunda … 7 = domingo. É o que o `Intl` devolve.
  dia            Int
  /// Declarado fechado. Sem intervalos, e é diferente de não ter linha.
  fechado        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// COMPOSTA: a unidade tem de ser da mesma organização.
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, dia])
  @@index([organizationId])
  @@map("schedule_days")
}

/// Uma data concreta que sobrepõe a regra semanal. Feriado, evento, obras.
model ScheduleException {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// Data LOCAL da unidade, `AAAA-MM-DD`. Guardada como `date` e não como
  /// instante: um feriado é um dia no calendário de quem o vive, não um ponto
  /// em UTC que muda de dia conforme quem o lê.
  data           DateTime @db.Date
  motivo         String
  /// Fechado nesse dia, ou aberto com os intervalos abaixo.
  fechado        Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, data])
  @@index([organizationId])
  @@map("schedule_exceptions")
}

/// Um intervalo de serviço. Pertence a um dia da semana OU a uma excepção.
///
/// `fimMin` pode passar de 1440: 20:00→01:00 escreve-se 1200→1500. A alternativa
/// — guardar 60 e tratar `fim < inicio` como caso especial — espalha esse `if`
/// por todo o código que lê horários, e basta um sítio esquecer-se para a sexta
/// à uma da manhã aparecer fechada.
model ScheduleInterval {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  diaId          String? @map("dia_id") @db.Uuid
  excepcaoId     String? @map("excepcao_id") @db.Uuid
  inicioMin      Int     @map("inicio_min")
  fimMin         Int     @map("fim_min")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dia          ScheduleDay?       @relation(fields: [diaId], references: [id], onDelete: Cascade)
  excepcao     ScheduleException? @relation(fields: [excepcaoId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([diaId])
  @@index([excepcaoId])
  @@map("schedule_intervals")
}

/// Em que passo do arranque está esta organização.
///
/// Existe para o onboarding poder ser **retomado**: quem fecha o portátil no
/// passo 3 volta ao passo 3. O passo não é a verdade sobre o que está feito — a
/// verdade é o que existe na base — é a última posição de quem estava a
/// preencher.
model OnboardingProgress {
  organizationId String @id @map("organization_id") @db.Uuid
  /// 1..10, como o atlas numera. Sem omissão para 10.
  passo          Int    @default(1)
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

/// Uma operação já executada, guardada pela chave que quem chamou escolheu.
///
/// O aceite 1 do E06: *"repetir criação após timeout não duplica organização/
/// unidade"*. Um pedido que expira no cliente pode já ter sido executado no
/// servidor — o cliente não sabe a diferença entre "não chegou" e "chegou e a
/// resposta perdeu-se". Repetir é a coisa certa a fazer; duplicar é o que não
/// pode acontecer.
///
/// A `organizationId` é OPCIONAL de propósito: a criação da própria organização
/// também tem de ser idempotente, e nesse momento ainda não há organização.
model IdempotencyKey {
  id             String  @id @default(uuid()) @db.Uuid
  /// A chave que o cliente escolheu. Opaca para nós.
  chave          String
  actorId        String  @map("actor_id") @db.Uuid
  accao          String
  organizationId String? @map("organization_id") @db.Uuid
  /// O que ficou feito, para se devolver o MESMO em vez de refazer.
  resultadoTipo  String  @map("resultado_tipo")
  resultadoId    String  @map("resultado_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Por actor e acção, como o `domain-model.md` manda. A mesma chave de duas
  /// pessoas diferentes são duas operações diferentes.
  @@unique([chave, actorId, accao])
  @@index([organizationId])
  @@map("idempotency_keys")
}
