// BossaOS — schema base (E01).
//
// Nesta etapa o schema é DELIBERADAMENTE mínimo. O E01 é a base executável: o
// modelo de dados do produto entra nas etapas que o desenham (multi-tenant,
// catálogo, reservas), e inventá-lo aqui seria decidir sem o contrato à frente.
//
// O que existe aqui existe por uma razão verificável: `AppMeta` é a tabela que a
// sonda de prontidão lê. Sem ela, "a base responde" prova apenas que o Postgres
// está de pé — não prova que ESTE schema foi migrado. São perguntas diferentes,
// e a segunda é a que interessa depois de um deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Em Prisma 7 a URL SAI do schema: as migrações lêem-na de `prisma.config.ts`
  // e o runtime recebe a dele por adaptador, no construtor do cliente. Para nós
  // isto é bom notícia e não obstáculo — a separação entre a credencial que
  // altera schema e a que só o usa (E01, aceite 2) deixa de depender de
  // disciplina e passa a estar em dois sítios diferentes do código.
}

/// Chave/valor de metadados da aplicação. Escrita pela migração, lida pela
/// sonda de prontidão. Não é domínio: é o sinal de que o schema chegou.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ═══════════════════════════════════════════════════════════════════════════
// E03 — núcleo multi-inquilino
//
// Três camadas de isolamento, e nenhuma substitui as outras (domain-model.md):
//   1. a credencial     — o runtime não é dono das tabelas, não é superuser,
//                         não tem BYPASSRLS. Provado em E01.
//   2. a política       — RLS com USING **e** WITH CHECK, em migração SQL à mão
//                         (o Prisma não gere políticas).
//   3. o escopo         — marca, unidade, estação e acção são filtro de serviço.
//                         O RLS protege a ORGANIZAÇÃO e mais nada.
//
// As referências são COMPOSTAS. Uma FK simples de `location_id` deixaria apontar
// para a unidade de outra organização com o `organization_id` da linha a parecer
// certo. `@@unique([organizationId, id])` no alvo é o que torna isso impossível
// na base, e não no formulário.
// ═══════════════════════════════════════════════════════════════════════════

/// Fronteira do inquilino. O `id` desta linha é o `organization_id` de tudo o resto.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  /// Namespace público. Único globalmente: é o que aparece num endereço.
  slug      String   @unique
  /// Nome comercial. É o que aparece na interface.
  nome      String

  // ── E06: perfil. TODOS opcionais, e isso é a decisão da etapa ─────────────
  //
  // Nenhum destes campos tem `@default`. Um `pais @default("ES")` porque a
  // primeira fixture é espanhola, ou um `moedaPadrao @default("EUR")` porque
  // parecia razoável, é exactamente o defeito que este modelo existe para
  // impedir: **desconhecido é uma resposta**, e o ecrã tem de a poder mostrar.
  //
  // Opcional não quer dizer sem consequência: quem publica, cobra ou abre
  // precisa deles, e recusa sem eles. O que não se faz é preenchê-los sozinho.

  /// Nome legal, o da factura. Pode não estar à mão no primeiro dia.
  nomeLegal String? @map("nome_legal")
  /// ISO 3166-1 alpha-2. Sem omissão: o país da organização não se adivinha.
  pais      String? @db.Char(2)
  /// Fuso IANA da SEDE. O que conta para abrir portas é o da unidade.
  fuso      String?
  /// ISO 4217. É uma sugestão para novas unidades, nunca um valor herdado em
  /// silêncio: a unidade tem a sua, e pode ser outra.
  moedaPadrao String? @map("moeda_padrao") @db.Char(3)
  /// Quem responde por esta organização. Texto, não FK: pode ser alguém que
  /// ainda não tem conta.
  responsavel String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  brands          Brand[]
  locations       Location[]
  memberships     Membership[]
  menus           Menu[]
  categorias      Category[]
  produtos        Product[]
  gruposDeOpcoes  ModifierGroup[]
  ficheiros       MediaAsset[]
  regrasDePreco   PriceRule[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  auditEvents     AuditEvent[]
  subscription    Subscription?
  entitlements    EntitlementGrant[]
  featureFlags    FeatureFlag[]
  themeRevisions  ThemeRevision[]
  onboarding      OnboardingProgress?
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]
  scheduleIntervals  ScheduleInterval[]

  @@map("organizations")
  revisoes        MenuRevision[]
  publicacoes     MenuPublication[]
  importacoes     ImportJob[]
  exportacoes     ExportJob[]
  tarefas         OutboxTask[]
  consultas       MenuView[]
  enderecos       PublicSlugOwner[]
}

/// Marca: catálogo e identidade comercial. Pertence a uma organização.
model Brand {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  nome           String
  slug           String
  /// E06: identidade textual inicial (ONB-002). Opcionais pela mesma razão.
  descricao      String?
  /// Idioma principal da marca, um dos três que o E02 suporta. Sem omissão:
  /// escolher espanhol por a primeira fixture o ser publicaria a carta de um
  /// restaurante brasileiro em espanhol.
  idiomaPrincipal String? @map("idioma_principal")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locations       Location[]
  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  menus           Menu[]
  categorias      Category[]
  produtos        Product[]
  gruposDeOpcoes  ModifierGroup[]
  ficheiros       MediaAsset[]
  importacoes     ImportJob[]

  /// Alvo das referências compostas. Sem isto, o resto não se pode escrever.
  @@unique([organizationId, id], name: "brand_por_organizacao")
  /// Slug único DENTRO da marca-mãe, não globalmente: dois restaurantes
  /// diferentes podem chamar-se "marina" sem colidir.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

/// Unidade: serviço, mesas, dispositivos, moeda operacional e stock.
model Location {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  nome           String
  slug           String
  /// O endereço PÚBLICO da carta. Global, e por isso diferente do `slug`.
  ///
  /// O `slug` é único DENTRO da organização: dois restaurantes diferentes podem
  /// ambos ter uma unidade `centro`. Este vai para um URL na internet aberta e
  /// tem de ser único no mundo — senão dois inquilinos disputam o mesmo endereço
  /// e quem ganha é quem a consulta encontrar primeiro.
  ///
  /// Anulável: uma unidade só precisa dele quando publica.
  publicSlug     String?  @unique @map("public_slug")
  // ── E06: de obrigatórios a opcionais, e é uma decisão, não um relaxamento ─
  //
  // Estavam `NOT NULL`. Parece a escolha segura e é o contrário: com eles
  // obrigatórios, quem cria uma unidade é FORÇADO a passar um valor, e o valor
  // que se passa quando não se sabe é o da última unidade, ou o do servidor, ou
  // AUD porque o produto nasceu na Austrália. Uma unidade sem moeda não é AUD.
  //
  // Opcionais, "por configurar" passa a ser representável — e as operações que
  // precisam deles recusam explicitamente, em vez de operarem sobre um palpite.
  /// Moeda operacional, ISO 4217. O dinheiro guarda-se em unidade mínima.
  moeda          String? @db.Char(3)
  /// Fuso IANA. Sem ele não há pergunta a fazer sobre horários: "são 14:00" não
  /// quer dizer nada sem saber onde.
  fuso           String?
  /// E06: morada e contacto (ONB-003, ORG-005). "Pendiente de confirmar" é um
  /// estado que o atlas desenha, e é `null` — não uma cadeia vazia.
  morada         String?
  localidade     String?
  contactoEmail  String? @map("contacto_email")
  contactoTelefone String? @map("contacto_telefone")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// COMPOSTA: a marca tem de ser da mesma organização. É a base que recusa.
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)

  roleAssignments RoleAssignment[]
  invitations     Invitation[]
  entitlements    EntitlementGrant[]
  scheduleDays    ScheduleDay[]
  scheduleExceptions ScheduleException[]
  menus           Menu[]
  regrasDePreco   PriceRule[]
  disponibilidades ProductAvailability[]
  consultas       MenuView[]

  @@unique([organizationId, id], name: "location_por_organizacao")
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("locations")
}

/// Identidade GLOBAL. Excepção documentada (CT-04): não leva `organization_id`,
/// porque a mesma pessoa trabalha em mais do que uma organização.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  nome      String
  /// E04: a biblioteca de autenticação escreve isto. O campo dela chama-se
  /// `name` e aponta para `nome` por configuração — a identidade continua a ser
  /// UMA tabela, e não duas a fingir que são a mesma pessoa.
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?
  /// MFA. Em TODOS os planos, não num escalão acima: a segurança da conta de
  /// quem trabalha no restaurante não é uma capacidade que se venda.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  convitesFeitos Invitation[] @relation("convidadoPor")
  plataforma     PlatformStaff?

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// E04 — sessão e credenciais.
//
// Estas três tabelas pertencem ao caminho de AUTENTICAÇÃO e o papel de runtime
// não tem privilégio nenhum sobre elas. Não é zelo: uma sessão é uma credencial
// viva, e o processo que serve o catálogo de um restaurante não precisa de
// conseguir ler a sessão de ninguém — nem a própria.
//
// A forma dos campos é a que a biblioteca espera. Confirmada contra a definição
// dela em `@better-auth/core/dist/db/get-tables.mjs`, e depois **verificada a
// correr**: um registo e um início de sessão a sério contra esta base.
// ═══════════════════════════════════════════════════════════════════════════

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @default("credential")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Guardada pela biblioteca, com o algoritmo dela. Nunca por nós: o E04 é
  /// explícito em não construir criptografia nem armazenamento de senha próprios.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Segundo factor. `secret` e `backupCodes` são guardados e cifrados pela
/// biblioteca — nós não lhes tocamos, e vivem nas tabelas que o runtime não vê.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

enum EstadoDeMembro {
  ACTIVO
  SUSPENSO
  REVOGADO

  @@map("estado_de_membro")
}

/// A ponte entre a identidade global e o inquilino.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  estado         EstadoDeMembro @default(ACTIVO)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int            @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]

  @@unique([organizationId, id], name: "membership_por_organizacao")
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Papéis do CT-04. O nome fica em maiúsculas porque é vocabulário do contrato.
enum Papel {
  OWNER
  ORG_ADMIN
  BRAND_MANAGER
  VENUE_MANAGER
  FLOOR_MANAGER
  HOST
  WAITER
  KITCHEN
  BARTENDER
  EXPO
  CASHIER
  FINANCE
  INVENTORY
  MARKETING
  EMPLOYEE

  @@map("papel")
}

/// Concessão de papel, com o seu escopo.
///
/// `brandId` e `locationId` são opcionais e é isso que define o alcance: uma
/// concessão de marca abrange as unidades dela; uma de unidade não amplia para o
/// resto da organização (CT-04). Nenhum dos dois preenchido = alcance da
/// organização inteira, e só os papéis de topo o devem ter.
model RoleAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  membershipId   String  @map("membership_id") @db.Uuid
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, membershipId])
  @@map("role_assignments")
}

/// Estado de um convite. Derivado, mas guardado: o histórico de quem foi
/// convidado e nunca aceitou é informação de gestão, não lixo.
enum EstadoDeConvite {
  PENDENTE
  ACEITE
  REVOGADO

  @@map("estado_de_convite")
}

/// Convite para uma organização.
///
/// **Um convite é uma credencial**, e é isso que explica cada campo:
///
///  - `tokenHash` e não `token`: o que viaja no email é o segredo; o que fica na
///    base é o resumo dele. Uma cópia de segurança lida por alguém não dá
///    acesso a nada, e nem nós conseguimos reemitir o link original.
///  - `papel`, `brandId`, `locationId` vivem AQUI. Na aceitação não se lê nada
///    disto do corpo do pedido — se se lesse, quem foi convidado como `WAITER`
///    aceitava-se como `OWNER`. É o defeito mais banal desta área.
///  - `email`: o convite é da pessoa convidada, não de quem receber o link.
///  - `expiresAt` vem de configuração, não de uma constante escolhida por quem
///    programa.
///  - `acceptedAt` faz o uso único: aceitar duas vezes não cria duas pertenças.
model Invitation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  email          String
  papel          Papel
  brandId        String? @map("brand_id") @db.Uuid
  locationId     String? @map("location_id") @db.Uuid

  /// SHA-256 do token. O token em claro só existe no email.
  tokenHash String @unique @map("token_hash")

  estado     EstadoDeConvite @default(PENDENTE)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?       @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(6)

  /// Quem convidou. A concessão não pode passar o escopo desta pessoa (CT-04),
  /// e sem o registo não há como auditar quem abriu a porta a quem.
  convidadoPorId String @map("convidado_por_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  convidadoPor User         @relation("convidadoPor", fields: [convidadoPorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invitations")
}

/// Rasto de acções sensíveis (E04, entrega 5).
///
/// Concessões, revogações e acesso assistido. Sem `actor` e `motivo` não é
/// auditoria — é um log. Append-only por gatilho na migração: uma auditoria que
/// se pode editar não serve para o que existe.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Quem fez. Sem FK para User de propósito: o rasto sobrevive ao apagamento.
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  accao          String
  alvoTipo       String?  @map("alvo_tipo")
  alvoId         String?  @map("alvo_id") @db.Uuid
  motivo         String?
  /// Detalhe estruturado. Nunca senhas, nunca tokens (CT-04).
  detalhe        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// E05 — planos, entitlements e flags
//
// Três catálogos, e a separação entre eles é do contrato, não estética:
//
//   PlanDefinition   o que se VENDE. Global, não pertence a inquilino nenhum.
//   EntitlementGrant o que uma organização TEM. De inquilino, com política.
//   FeatureFlag      o que está CONSTRUÍDO e libertado. Global ou por org.
//
// Misturar capacidades com flags faz um "ainda não existe" ler-se como "compra
// o plano acima", e o dono do restaurante paga por algo que não está feito.
//
// **Nenhum número comercial vive aqui.** Preços, mensalidades e limites são
// configuração, decididos pelo Matheus. O que o código traz é a estrutura — a
// quota, a leitura, a recusa e a mensagem. Escrever `MAX_PRODUTOS = 500` porque
// parecia razoável é como o número acaba em três sítios e nenhum é o certo.
// ═══════════════════════════════════════════════════════════════════════════

/// Um plano vendável. **Global**: o catálogo é o mesmo para todos.
///
/// Sem preço. O atlas (ORG-010) diz "Precio según propuesta" e é isso que fica:
/// o preço é uma proposta comercial, não uma constante do produto.
model PlanDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  /// STARTER, RESTAURANT, PRO. Estável: é o que as concessões referenciam.
  codigo    String   @unique
  nome      String
  /// A frase do atlas: "Publica bien", "Conecta el servicio", "Amplía tu gestión".
  promessa  String
  ordem     Int
  /// Aparece no selector de planos? Um plano de piloto pode não aparecer.
  publico   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  capacidades   PlanCapability[]
  subscriptions Subscription[]
  /// As subscrições que têm uma descida agendada PARA este plano. Sem esta
  /// relação a coluna existia e não se podia ler o destino pelo nome — o
  /// `estadoComercial` devolvia `descerParaPlano: null` fixo e o ecrã de mudar
  /// de plano dizia "nenhuma mudança agendada" a quem tinha uma.
  descidasAgendadas Subscription[] @relation("DescerPara")

  @@map("plan_definitions")
}

/// O que um plano inclui.
///
/// `quota` nula numa capacidade quantitativa significa **por configurar**, e o
/// motor nega. Não é ilimitado — nunca. É o CT-02 na direcção certa.
model PlanCapability {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  /// Chave do catálogo em `packages/domain/src/capacidades.ts`.
  capacidade String
  quota      Int?

  plan PlanDefinition @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, capacidade])
  @@map("plan_capabilities")
}

enum EstadoDeSubscricao {
  ACTIVA
  SUSPENSA
  CANCELADA

  @@map("estado_de_subscricao")
}

/// A assinatura de uma organização. Assenta na `Organization` do E03.
model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  estado         EstadoDeSubscricao @default(ACTIVA)
  validoDe       DateTime           @default(now()) @map("valido_de") @db.Timestamptz(6)
  validoAte      DateTime?          @map("valido_ate") @db.Timestamptz(6)

  /// Descida agendada. Guardar o plano de destino e a data **antes** de
  /// efectivar é o que permite mostrar a prévia e avisar com antecedência —
  /// e o que permite não efectivar enquanto houver caixa aberta.
  descerParaPlanoId String?   @map("descer_para_plano_id") @db.Uuid
  descerEm          DateTime? @map("descer_em") @db.Timestamptz(6)

  /// Tolerância por incumprimento: política configurável, não uma data
  /// escolhida por quem programa.
  toleranciaAte DateTime? @map("tolerancia_ate") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  descerParaPlano PlanDefinition? @relation("DescerPara", fields: [descerParaPlanoId], references: [id], onDelete: Restrict)
  plan         PlanDefinition @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

enum OrigemDeConcessao {
  /// Vem do plano contratado.
  PLANO
  /// Add-on comprado à parte. Não liberta os módulos operacionais todos.
  ADICIONAL
  /// Piloto provisionado por nós, auditado. Nunca simula cobrança.
  PILOTO

  @@map("origem_de_concessao")
}

/// O que uma organização TEM. **A ausência de uma linha significa negado.**
model EntitlementGrant {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  capacidade     String
  /// Nula numa quantitativa = por configurar = NEGADO. Ver `capacidades.ts`.
  quota          Int?
  /// Presente = a concessão só vale nesta unidade, e não amplia para o resto.
  locationId     String?           @map("location_id") @db.Uuid
  validoAte      DateTime?         @map("valido_ate") @db.Timestamptz(6)
  origem         OrigemDeConcessao @default(PLANO)
  /// Por que existe esta concessão. Obrigatório em PILOTO e ADICIONAL: uma
  /// concessão sem motivo é impossível de auditar seis meses depois.
  motivo         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, capacidade, locationId])
  @@index([organizationId])
  @@map("entitlement_grants")
}

/// Flag de lançamento. **Catálogo separado do de capacidades.**
///
/// Uma flag responde a "está construído e libertado?". Sem `organizationId` é
/// global; com ele é uma libertação controlada a um inquilino — que é como se
/// põe um módulo novo em produção com um cliente antes de todos.
model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String
  ligada         Boolean  @default(false)
  descricao      String?
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([nome, organizationId])
  @@index([nome])
  @@map("feature_flags")
}

/// Tema público de um restaurante.
///
/// O plano Starter usa a paleta BossaOS e **não a pode editar** — pode mudar
/// nome, logo, fotos e conteúdo. Restaurant e Pro escolhem cores próprias, e
/// têm o mesmo direito: o editor completo é do E12.
///
/// Guardar o tema ANTERIOR é o que permite uma descida de plano reverter ao
/// padrão sem perder o que o cliente escolheu — se ele voltar a subir, está lá.
model ThemeRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Os três únicos tokens temáveis (E02, `TOKENS_TEMAVEIS`).
  primaria       String
  acento         String
  fundo          String
  /// Verdadeiro quando é a paleta BossaOS por omissão, não uma escolha.
  padrao         Boolean  @default(false)
  /// Activa agora? Só uma por organização.
  activa         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, activa])
  @@map("theme_revisions")
}

/// Quem é da plataforma BossaOS.
///
/// Escrita **só pela credencial de migração**, como o catálogo de planos e pela
/// mesma razão: uma tabela de "quem tem acesso interno" que o processo do
/// restaurante pode escrever é um restaurante a dar-se acesso interno. O runtime
/// nem sequer tem SELECT — lê-a apenas através das funções `plataforma_*`, que a
/// consultam por ele e verificam elas próprias quem chama.
model PlatformStaff {
  userId    String   @id @map("user_id") @db.Uuid
  /// Porquê. Um acesso interno sem motivo escrito é um acesso que ninguém
  /// consegue rever daqui a seis meses.
  motivo    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff")
}

// ═══════════════════════════════════════════════════════════════════════════
// E06 — horários, onboarding e idempotência.

/// Um dia da semana CONFIGURADO, para uma unidade.
///
/// **A ausência de linha é o terceiro estado.** Um dia sem linha está por
/// configurar; um dia com linha e `fechado = true` está fechado porque alguém o
/// disse. As duas coisas leem-se igual num modelo que só tenha intervalos, e é
/// essa a diferença que faz um site anunciar que abre às nove.
model ScheduleDay {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// ISO 8601: 1 = segunda … 7 = domingo. É o que o `Intl` devolve.
  dia            Int
  /// Declarado fechado. Sem intervalos, e é diferente de não ter linha.
  fechado        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// COMPOSTA: a unidade tem de ser da mesma organização.
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, dia])
  @@index([organizationId])
  @@map("schedule_days")
}

/// Uma data concreta que sobrepõe a regra semanal. Feriado, evento, obras.
model ScheduleException {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// Data LOCAL da unidade, `AAAA-MM-DD`. Guardada como `date` e não como
  /// instante: um feriado é um dia no calendário de quem o vive, não um ponto
  /// em UTC que muda de dia conforme quem o lê.
  data           DateTime @db.Date
  motivo         String
  /// Fechado nesse dia, ou aberto com os intervalos abaixo.
  fechado        Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  intervalos   ScheduleInterval[]

  @@unique([organizationId, locationId, data])
  @@index([organizationId])
  @@map("schedule_exceptions")
}

/// Um intervalo de serviço. Pertence a um dia da semana OU a uma excepção.
///
/// `fimMin` pode passar de 1440: 20:00→01:00 escreve-se 1200→1500. A alternativa
/// — guardar 60 e tratar `fim < inicio` como caso especial — espalha esse `if`
/// por todo o código que lê horários, e basta um sítio esquecer-se para a sexta
/// à uma da manhã aparecer fechada.
model ScheduleInterval {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  diaId          String? @map("dia_id") @db.Uuid
  excepcaoId     String? @map("excepcao_id") @db.Uuid
  inicioMin      Int     @map("inicio_min")
  fimMin         Int     @map("fim_min")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dia          ScheduleDay?       @relation(fields: [diaId], references: [id], onDelete: Cascade)
  excepcao     ScheduleException? @relation(fields: [excepcaoId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([diaId])
  @@index([excepcaoId])
  @@map("schedule_intervals")
}

/// Em que passo do arranque está esta organização.
///
/// Existe para o onboarding poder ser **retomado**: quem fecha o portátil no
/// passo 3 volta ao passo 3. O passo não é a verdade sobre o que está feito — a
/// verdade é o que existe na base — é a última posição de quem estava a
/// preencher.
model OnboardingProgress {
  organizationId String @id @map("organization_id") @db.Uuid
  /// 1..10, como o atlas numera. Sem omissão para 10.
  passo          Int    @default(1)
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

/// Uma operação já executada, guardada pela chave que quem chamou escolheu.
///
/// O aceite 1 do E06: *"repetir criação após timeout não duplica organização/
/// unidade"*. Um pedido que expira no cliente pode já ter sido executado no
/// servidor — o cliente não sabe a diferença entre "não chegou" e "chegou e a
/// resposta perdeu-se". Repetir é a coisa certa a fazer; duplicar é o que não
/// pode acontecer.
///
/// A `organizationId` é OPCIONAL de propósito: a criação da própria organização
/// também tem de ser idempotente, e nesse momento ainda não há organização.
model IdempotencyKey {
  id             String  @id @default(uuid()) @db.Uuid
  /// A chave que o cliente escolheu. Opaca para nós.
  chave          String
  actorId        String  @map("actor_id") @db.Uuid
  accao          String
  organizationId String? @map("organization_id") @db.Uuid
  /// O que ficou feito, para se devolver o MESMO em vez de refazer.
  resultadoTipo  String  @map("resultado_tipo")
  resultadoId    String  @map("resultado_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Por actor e acção, como o `domain-model.md` manda. A mesma chave de duas
  /// pessoas diferentes são duas operações diferentes.
  @@unique([chave, actorId, accao])
  @@index([organizationId])
  @@map("idempotency_keys")
}

// ═══════════════════════════════════════════════════════════════════════════
// E07 — catálogo, produtos, preços e opções.
//
// **Um produto é da MARCA e é referenciado pelos canais.** O prompt proíbe pelo
// nome o erro clássico desta área: "não crie tabelas independentes de produtos
// para menu, Staff ou TPV". Cada superfície com a sua cópia significa que o
// preço da carta e o preço do TPV divergem sem ninguém saber qual é o certo.
// Aqui há um `Product`, e o que varia por canal são as REGRAS que lhe apontam.

/// O que é editável é RASCUNHO. Publicar é E08, e cria revisão imutável.
enum EstadoDeCatalogo {
  RASCUNHO
  ACTIVO
  ARQUIVADO
}

/// Os canais onde um catálogo se vende (CAT-016).
enum Canal {
  CARTA
  SITE
  SALA
  TPV
  TAKEAWAY
  KIOSK
}

/// Contém, pode conter, não contém.
///
/// **`DESCONHECIDO` não está aqui, e é a decisão que decide a etapa.** É a
/// AUSÊNCIA de linha em `ProductAllergen`. Um estado guardável para "não se
/// sabe" daria duas maneiras de o representar — a linha ausente e a linha com
/// `DESCONHECIDO` — e duas maneiras de representar a mesma coisa é uma maneira
/// de as ler diferente.
enum EstadoDeAlergenio {
  CONTEM
  PODE_CONTER
  NAO_CONTEM
}

model Menu {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  /// Âmbito: `null` = a marca inteira; preenchido = só esta unidade (CAT-002).
  locationId     String? @map("location_id") @db.Uuid
  nome           String
  descricao      String?
  /// Período de vigência. Ausente dos dois lados = todo o ano.
  periodoDe      DateTime? @map("periodo_de") @db.Timestamptz(6)
  periodoAte     DateTime? @map("periodo_ate") @db.Timestamptz(6)
  estado         EstadoDeCatalogo @default(RASCUNHO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  canais       MenuChannel[]
  seccoes      MenuCategory[]
  revisoes     MenuRevision[]
  publicacoes  MenuPublication[]

  @@unique([organizationId, id], name: "menu_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("menus")
}

model MenuChannel {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  canal          Canal

  menu Menu @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, menuId, canal])
  @@index([organizationId])
  @@map("menu_channels")
}

model Category {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  nome           String
  descricao      String?
  /// Ordem na carta. Inteiro e explícito — a ordenação por arrastar do CAT-004
  /// escreve aqui, e sem JavaScript escreve-se o número à mão.
  ordem          Int     @default(1)
  visivel        Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  produtos     Product[]
  emMenus      MenuCategory[]

  @@unique([organizationId, id], name: "categoria_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("categories")
}

/// Que secções entram em que menu, e por que ordem.
model MenuCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid
  ordem          Int    @default(1)

  menu     Menu     @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  category Category @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, menuId, categoryId])
  @@index([organizationId])
  @@map("menu_categories")
}

model Product {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  categoryId     String? @map("category_id") @db.Uuid
  nome           String
  descricao      String?
  /// Referência interna. **Nome igual não é chave de identidade** e um SKU vazio
  /// não autoriza fundir linhas — dois "Café" não são o mesmo produto.
  sku            String?
  estado         EstadoDeCatalogo @default(RASCUNHO)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  category     Category?    @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)

  traducoes      ProductTranslation[]
  variantes      ProductVariant[]
  precos         PriceRule[]
  gruposDeOpcoes ProductModifierGroup[]
  alergenios     ProductAllergen[]
  preferencias   ProductDietaryTag[]
  canais         ProductChannel[]
  disponibilidades ProductAvailability[]
  media            ProductMedia[]

  /// SKU único POR MARCA, e só quando preenchido. Vários `NULL` não colidem no
  /// PostgreSQL, que é exactamente o que se quer: nem todo o produto tem SKU.
  @@unique([organizationId, brandId, sku])
  @@unique([organizationId, id], name: "produto_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@index([organizationId, categoryId])
  @@map("products")
}

/// Nome e descrição noutro idioma.
///
/// *"Texto de origem alterado torna a tradução pendente de revisão."* Sem isso,
/// mudar a descrição em espanhol deixa a inglesa a afirmar o antigo, e ninguém
/// repara porque a página inglesa continua a existir e a parecer completa.
model ProductTranslation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  /// `es-ES`, `pt-BR`, `en` — os três que o E02 fixou.
  locale         String
  nome           String
  descricao      String?
  /// A impressão do TEXTO de origem quando esta tradução foi escrita ou revista.
  ///
  /// Substituiu `origemVersao` no E08, e a razão é uma correcção: a `version` do
  /// produto avança em QUALQUER edição — mudar o preço, mudar a categoria — e
  /// marcar a tradução como obsoleta por causa do preço é um falso positivo.
  /// Falsos positivos são o que ensina toda a gente a ignorar o aviso, e o E00
  /// diz "texto de origem alterado", não "produto alterado".
  impressaoDaOrigem String @map("impressao_da_origem")
  /// Quem reviu. Sem responsável, a tradução está PENDENTE e não revista — a
  /// mesma regra da ficha de alérgenos do E07.
  revistoPor     String?   @map("revisto_por")
  revistoEm      DateTime? @map("revisto_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, locale])
  @@index([organizationId])
  @@map("product_translations")
}

/// Tamanho, porção, tipo — com preços diferenciais (CAT-011).
model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  nome           String
  ordem          Int     @default(1)
  predefinida    Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  product Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  precos  PriceRule[]

  @@unique([organizationId, id], name: "variante_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("product_variants")
}

/// Uma regra de preço. O nível sai da FORMA — que campos estão preenchidos.
///
/// **Unidades mínimas inteiras, sempre.** `Int` e não `Decimal`: 10,00 € é
/// `1000` + `EUR`. E a moeda vai na linha, porque uma organização pode ter
/// unidades em moedas diferentes e converter exigiria uma taxa que não existe.
model PriceRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// Ausente = vale para todas as variantes.
  variantId      String? @map("variant_id") @db.Uuid
  /// Ausente = base da marca (o "Heredado" do CAT-010).
  locationId     String? @map("location_id") @db.Uuid
  /// Ausente = todos os canais.
  canal          Canal?
  deQuando       DateTime? @map("de_quando") @db.Timestamptz(6)
  ateQuando      DateTime? @map("ate_quando") @db.Timestamptz(6)

  montanteMenor  Int    @map("montante_menor")
  moeda          String @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Cascade)
  location     Location?       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("price_rules")
}

/// Biblioteca reutilizável de extras (CAT-018, CAT-019).
model ModifierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  brandId        String  @map("brand_id") @db.Uuid
  nome           String
  obrigatorio    Boolean @default(false)
  minimo         Int     @default(0)
  /// Ausente = sem tecto.
  maximo         Int?
  /// Para onde vai na cozinha. É E16 quem o usa; guarda-se aqui porque é do
  /// grupo e não do KDS, e criá-lo depois obrigava a reescrever fichas.
  destino        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  opcoes       ModifierOption[]
  emProdutos   ProductModifierGroup[]

  @@unique([organizationId, id], name: "grupo_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@map("modifier_groups")
}

model ModifierOption {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  nome           String
  ordem          Int     @default(1)
  /// Acréscimo. Em unidades mínimas, e `null` quando não acrescenta nada —
  /// que é diferente de acrescentar zero.
  precoMenor     Int?    @map("preco_menor")
  moeda          String? @db.Char(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  group ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id], name: "opcao_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, groupId])
  @@map("modifier_options")
}

/// O mesmo grupo, em vários produtos. É a "biblioteca" a sério.
model ProductModifierGroup {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  ordem          Int    @default(1)

  product Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, groupId])
  @@index([organizationId])
  @@map("product_modifier_groups")
}

/// A biblioteca de alérgenos (CAT-022).
///
/// **Global e não por inquilino**: os catorze do anexo II do 1169/2011 são a
/// mesma lista para toda a gente na UE, e uma cópia por organização seria
/// catorze cópias que divergem quando a lei mudar. A `regiao` existe porque
/// outras jurisdições têm outras listas.
model Allergen {
  id       String @id @default(uuid()) @db.Uuid
  codigo   String @unique
  /// `UE`, `AU`, `BR`… A lista aplicável sai da região da organização.
  regiao   String @default("UE")
  ordem    Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  emProdutos ProductAllergen[]

  @@map("allergens")
}

/// A declaração de um alérgeno num produto.
///
/// **A ausência de linha é `DESCONHECIDO`.** Não há estado guardável para "não
/// se sabe": ninguém escreve desconhecido, escreve-se uma das três ou não se
/// escreve nada.
model ProductAllergen {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  allergenId     String @map("allergen_id") @db.Uuid
  estado         EstadoDeAlergenio
  /// Quem assinou. **Uma declaração sem responsável não é uma declaração**, e
  /// por isso a ficha só está revista quando todas o têm.
  revistoPor     String? @map("revisto_por")
  revistoEm      DateTime? @map("revisto_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId, allergenId])
  @@index([organizationId])
  @@map("product_allergens")
}

/// Preferência alimentar. **NÃO é declaração de segurança.**
///
/// Tabela separada de propósito, sem partilhar vocabulário com os alérgenos.
/// "Contém amendoim" é segurança: quem a lê pode morrer se estiver errada.
/// "Vegetariano" é preferência: quem a lê fica aborrecido. Misturá-las num campo
/// é o defeito que transforma uma preferência num risco, porque a partir daí
/// ninguém sabe qual das duas está a ler.
model ProductDietaryTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  codigo         String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, codigo])
  @@index([organizationId])
  @@map("product_dietary_tags")
}

/// Onde é que este produto se vende (CAT-016).
model ProductChannel {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  canal          Canal
  visivel        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, canal])
  @@index([organizationId])
  @@map("product_channels")
}

/// O bloqueio operacional (CAT-017).
///
/// A disponibilidade tem **duas camadas** e esta é a de baixo: "acabou o polvo",
/// imediato, sem republicar a carta. Um restaurante que tenha de refazer a
/// publicação para o dizer vai deixar de o dizer.
model ProductAvailability {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// `null` = em todas as unidades. Preenchido = só nesta.
  locationId     String? @map("location_id") @db.Uuid
  bloqueado      Boolean @default(true)
  /// Até quando. `null` = até alguém desbloquear; o atlas mostra "hasta próximo
  /// servicio", que é uma data e não uma promessa vaga.
  ate            DateTime? @db.Timestamptz(6)
  motivo         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  location Location? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, productId, locationId])
  @@index([organizationId])
  @@map("product_availability")
}

// ═══════════════════════════════════════════════════════════════════════════
// E08 — média, traduções, importação e publicação
// ═══════════════════════════════════════════════════════════════════════════

/// Estado de uma importação. `PREVISTA` é o dry-run que ainda não escreveu nada.
enum EstadoDeImportacao {
  PREVISTA
  CONFIRMADA
  CANCELADA
}

/// O que uma linha da importação faria. Espelha `AccaoDaLinha` do domínio.
enum AccaoDaLinha {
  CRIAR
  ACTUALIZAR
  IGNORAR
  ERRO
}

enum EstadoDeTarefa {
  PENDENTE
  A_CORRER
  CONCLUIDA
  FALHADA
}

/// Um ficheiro que alguém carregou. **Sempre com dono**: um ficheiro sem
/// inquilino é um ficheiro de toda a gente (CT-14).
model MediaAsset {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  /// A chave no armazenamento. Gerada por quem guarda, **nunca** o nome que veio
  /// de fora — nome de ficheiro externo é travessia de caminho (`../../.env`).
  chave          String @unique
  /// O tipo calculado dos BYTES. O declarado no pedido não decide nada.
  tipo           String
  tipoMime       String @map("tipo_mime")
  bytes          Int
  /// SHA-256 do conteúdo. Serve para não guardar o mesmo ficheiro duas vezes e
  /// para provar que a substituição do CAT-023 trocou mesmo o conteúdo.
  digest         String
  /// O nome que a pessoa deu, como METADADO. Não é caminho nem chave.
  nomeOriginal   String? @map("nome_original")
  /// Exigido nas imagens de carta. Uma foto sem alternativa é uma foto que não
  /// existe para quem usa leitor de ecrã.
  textoAlternativo String? @map("texto_alternativo")
  criadoPor      String  @map("criado_por")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  emProdutos   ProductMedia[]

  @@unique([organizationId, id], name: "media_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, brandId])
  @@index([organizationId, digest])
  @@map("media_assets")
}

/// Ligação produto ↔ ficheiro. A substituição do ficheiro não quebra isto: quem
/// muda é o `MediaAsset`, e as referências publicadas apontam à REVISÃO, que
/// guarda o retrato.
model ProductMedia {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  mediaId        String @map("media_id") @db.Uuid
  ordem          Int    @default(1)
  /// Uma só principal por produto — garantido por índice parcial na migração.
  principal      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [organizationId, mediaId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, mediaId])
  @@index([organizationId])
  @@map("product_media")
}

/// Uma revisão publicada da carta. **Imutável**: nada a altera depois de criada.
///
/// `conteudo` é o RETRATO — nome, preço, moeda, opções, alérgenos — e não uma
/// lista de referências. É o mesmo princípio do pedido do E00: actualizar o
/// catálogo não pode reescrever o que já foi publicado.
model MenuRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  numero         Int
  conteudo       Json
  /// Preenchido quando esta revisão nasceu de restaurar outra. Restaurar cria
  /// revisão nova; o número nunca recua.
  restauraDeId   String? @map("restaura_de_id") @db.Uuid
  criadaPor      String  @map("criada_por")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  menu         Menu         @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  restauraDe   MenuRevision? @relation("restauro", fields: [organizationId, restauraDeId], references: [organizationId, id], onDelete: Restrict)
  restauros    MenuRevision[] @relation("restauro")
  publicacoes  MenuPublication[]

  @@unique([organizationId, menuId, numero])
  @@unique([organizationId, id], name: "revisao_por_organizacao")
  @@index([organizationId])
  @@map("menu_revisions")
}

/// **A referência do destino.** Uma linha por (menu, canal), a apontar para a
/// revisão que está no ar.
///
/// A troca é um `UPDATE` desta linha dentro da transacção que cria a revisão: ou
/// muda o ponteiro e a revisão existe, ou não muda nenhum dos dois. É isto que
/// faz "uma falha a meio deixa a revisão anterior inteira" ser verdade por
/// construção, e não por cuidado de quem escreve.
model MenuPublication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuId         String @map("menu_id") @db.Uuid
  canal          Canal
  revisionId     String @map("revision_id") @db.Uuid
  publicadaPor   String @map("publicada_por")
  publicadaEm    DateTime @default(now()) @map("publicada_em") @db.Timestamptz(6)
  /// Publicação agendada: a linha existe com a data e o ponteiro só troca lá.
  agendadaPara   DateTime? @map("agendada_para") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  menu         Menu         @relation(fields: [organizationId, menuId], references: [organizationId, id], onDelete: Cascade)
  revisao      MenuRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, menuId, canal])
  @@index([organizationId])
  @@map("menu_publications")
}

/// Uma importação. Nasce PREVISTA — o dry-run — e só escreve ao confirmar.
model ImportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  brandId        String @map("brand_id") @db.Uuid
  estado         EstadoDeImportacao @default(PREVISTA)
  ficheiroNome   String  @map("ficheiro_nome")
  separador      String  @db.Char(1)
  /// Coluna do ficheiro → campo do produto. Explícito, nunca adivinhado.
  mapeamento     Json
  /// `criar_apenas` ou `actualizar_por_sku`. **Sem valor por omissão**: um
  /// `?? 'actualizar'` escrito por conveniência funde as cartas de toda a gente.
  estrategia     String
  resumo         Json?
  criadoPor      String  @map("criado_por")
  confirmadoPor  String? @map("confirmado_por")
  confirmadoEm   DateTime? @map("confirmado_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  linhas       ImportRow[]

  @@unique([organizationId, id], name: "importacao_por_organizacao")
  @@index([organizationId])
  @@map("import_jobs")
}

/// Uma linha da prévia. Guarda-se **antes** de confirmar, para o que a pessoa
/// aprovou ser o que se escreve — e não uma segunda leitura do ficheiro, que
/// podia dar outro resultado.
model ImportRow {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId          String @map("job_id") @db.Uuid
  /// A linha como a pessoa a vê no Excel: o cabeçalho é 1.
  linha          Int
  accao          AccaoDaLinha
  erro           String?
  dados          Json
  /// Em ACTUALIZAR: o produto tocado. Em CRIAR: preenchido ao confirmar.
  productId      String? @map("product_id") @db.Uuid

  job ImportJob @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, jobId, linha])
  @@index([organizationId])
  @@map("import_rows")
}

/// Uma exportação pedida. O ficheiro existe; o direito de o descarregar
/// verifica-se **outra vez** no descarregamento.
model ExportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Quem pediu. O descarregamento é dele e de mais ninguém.
  actorId        String @map("actor_id")
  /// A acção exigida, guardada na linha: se o vocabulário mudar, esta exportação
  /// continua a saber o que era preciso para a pedir.
  accaoExigida   String @map("accao_exigida")
  formato        String
  chave          String? @unique
  bytes          Int?
  expiraEm       DateTime  @map("expira_em") @db.Timestamptz(6)
  revogadaEm     DateTime? @map("revogada_em") @db.Timestamptz(6)
  descarregadaEm DateTime? @map("descarregada_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], name: "exportacao_por_organizacao")
  @@index([organizationId])
  @@index([organizationId, actorId])
  @@map("export_jobs")
}

/// A caixa de saída do trabalho de fundo: publicação agendada, conversão de
/// média, sugestão de tradução.
///
/// Uma tabela e não uma fila externa, pela mesma razão do E05: a tarefa nasce
/// **na mesma transacção** que o facto que a origina. Uma fila fora da base
/// aceita a tarefa e perde-a quando a transacção reverte, e o resultado é uma
/// publicação agendada para uma revisão que nunca existiu.
model OutboxTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tipo           String
  payload        Json
  estado         EstadoDeTarefa @default(PENDENTE)
  tentativas     Int      @default(0)
  proximaEm      DateTime @default(now()) @map("proxima_em") @db.Timestamptz(6)
  ultimoErro     String?  @map("ultimo_erro")
  concluidaEm    DateTime? @map("concluida_em") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([estado, proximaEm])
  @@map("outbox_tasks")
}

/**
 * Uma consulta da carta pública (REP-001).
 *
 * ── O que NÃO está aqui é a decisão ────────────────────────────────────────
 *
 * O `dados-e-accoes-sensiveis.md` pede minimização, e a régua do E09 di-lo por
 * extenso: *"unidade, idioma e origem chegam; um identificador que siga a
 * pessoa, não."*
 *
 * Por isso não há aqui endereço IP, nem agente do navegador, nem cookie, nem
 * identificador de sessão, nem nada que ligue duas consultas à mesma pessoa. Uma
 * linha destas responde a "quantos vêem a carta em inglês ao domingo" e **não
 * responde** a "o que é que aquela pessoa viu" — e a segunda pergunta não é para
 * ter resposta.
 *
 * `origem` é a categoria de onde veio (`qr`, `link`, `directo`), não o `Referer`
 * completo: o endereço de proveniência é ele próprio um dado sobre a pessoa.
 */
model MenuView {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid
  /// A revisão que estava no ar. Sem isto, um pico de consultas não se consegue
  /// ligar à publicação que o causou.
  revisionId     String @map("revision_id") @db.Uuid
  idioma         String
  canal          Canal
  origem         String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, locationId, createdAt])
  @@map("menu_views")
}

/**
 * Quem teve cada endereço público.
 *
 * O `@unique` em `Location.publicSlug` impede **dois ao mesmo tempo**; isto
 * impede **dois em sequência**. Apagar o endereço tira-o do ar e não o devolve
 * ao mundo — os QR de A estão impressos em mesas, e o papel não se actualiza.
 *
 * O runtime **lê** e não escreve: quem escreve é `reservar_endereco_publico`,
 * que é quem decide. Uma rota que pudesse apagar a linha reclamava o endereço de
 * outro, que é o que a tabela existe para impedir.
 */
model PublicSlugOwner {
  slug           String   @id
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("public_slug_owners")
}
