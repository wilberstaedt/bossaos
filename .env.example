# BossaOS — configuração de desenvolvimento.
# Copie para `.env` e ajuste. NENHUM valor aqui é real: são exemplos locais e
# descartáveis, e é assim que tem de continuar (E01: sem segredos, contas reais
# ou endpoints de produção).

# NODE_ENV NÃO está aqui, de propósito.
#
# O Next define-o sozinho (`dev` → development, `build`/`start` → production) e
# um `NODE_ENV=development` exportado pela shell faz o `next build` FALHAR a
# pré-renderizar, com um `TypeError: Cannot read properties of null (reading
# 'useContext')` que não aponta para lado nenhum. Medido: sem a variável e com
# `production` o build passa; com `development` falha, de forma reprodutível.
# O script de build fixa `NODE_ENV=production` para não depender disto.
PORT=3000
LOG_LEVEL=debug

# ── Base de dados ────────────────────────────────────────────────────────────
# DUAS credenciais, de propósito (E01, aceite 2):
#   DATABASE_URL            execução. Faz DML. NÃO pode alterar o schema.
#   MIGRATION_DATABASE_URL  migrações. Faz DDL. Só os comandos de migração a usam.
# `pnpm dev:db` cria os dois papéis no Postgres local e imprime estas linhas.
DATABASE_URL="postgresql://bossaos_app:dev_app_local@127.0.0.1:5432/bossaos_dev"
MIGRATION_DATABASE_URL="postgresql://bossaos_migrate:dev_migrate_local@127.0.0.1:5432/bossaos_dev"

# ── E-mail de teste ──────────────────────────────────────────────────────────
# Mailpit (`pnpm dev:mail`). Nada sai para a Internet: a caixa é local, em
# http://127.0.0.1:8025. Um fornecedor real é dependência de etapa posterior.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=bossaos-dev@localhost

# ── Porta de média ───────────────────────────────────────────────────────────
# Em desenvolvimento grava no disco. O condutor `s3` existe no contrato e entra
# na etapa que o desenha.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# ── Autenticação global (E04) ────────────────────────────────────────────────
# O TERCEIRO acesso do CT-04. Vê identidades e sessões; NÃO vê dados de
# inquilino — verificado na base: `SELECT count(*) FROM brands` com esta
# credencial devolve `permission denied`.
AUTH_DATABASE_URL="postgresql://bossaos_auth:dev_auth_local@127.0.0.1:5432/bossaos_dev"

# Segredo da biblioteca de autenticação. Este é local e descartável; em qualquer
# outro sítio é gerado e guardado fora do repositório.
BETTER_AUTH_SECRET="segredo-local-descartavel-de-desenvolvimento-32b"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Prazo de um convite. Configuração, e não uma constante escolhida por quem
# programa — foi o CT-04 que o pediu assim.
CONVITE_VALIDADE_HORAS=72
